<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>

		<!-- Hosting: shared hosting friendly -->
		<AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>

		<!-- General -->
		<AssemblyName>aseeMIS</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>

		<!-- Publish/hosting stability -->
		<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>

		<!-- IMPORTANT for cultures, decimal separators, dates (banking apps) -->
		<InvariantGlobalization>false</InvariantGlobalization>

		<!-- Optional: reduce noisy warnings (remove if you want strict) -->
		<NoWarn>$(NoWarn);1591</NoWarn>
		<UserSecretsId>157747b8-9245-4d2e-9764-ced7e900ce61</UserSecretsId>
	</PropertyGroup>

