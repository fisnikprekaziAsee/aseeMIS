@inject IHttpContextAccessor HttpContextAccessor
@inject aseeMIS.Services.Interfaces.IAppSessionService appSessionService
@using aseeMIS.Services

@{
    var ctx = HttpContextAccessor.HttpContext!;
    var user = ctx.User;
    var isAuthenticated = user?.Identity?.IsAuthenticated ?? false;

    var languageCode = appSessionService.GetLanguageCode();
    if (!string.IsNullOrWhiteSpace(languageCode))
    {
        languageCode = ctx.Request.Path.ToString().Contains("Login") ? null : languageCode;
    }



    // // avoid loop on Identity pages (Login, Reset, etc.)
    // var path = ctx.Request.Path.Value ?? string.Empty;
    // var isIdentity = path.StartsWith("/Identity", StringComparison.OrdinalIgnoreCase);

    // if (!isIdentity && (!isAuthenticated || string.IsNullOrWhiteSpace(languageCode)))
    // {
    //     var returnUrl = ctx.Request.Path + ctx.Request.QueryString;
    //     var loginUrl = Url.Page("/Account/Login", new { area = "Identity", ReturnUrl = returnUrl });

    //     Context.Response.Redirect(loginUrl!);
    //     return; // stop rendering this view
    // }

    const string defaultProfileImage = "/images/ProfilePictures/user.png";
    var userId = user?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var profileImage = !string.IsNullOrEmpty(userId)
        ? $"/images/ProfilePictures/{userId}.png"
        : defaultProfileImage;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]  aseeMIS</title>

    <link rel="icon" type="image/x-icon" href="~/images/browsIcon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.syncfusion.com/ej2/34.1.32/bootstrap5.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dsSyncfusion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dsInputHelper.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/aseeMIS.styles.css" asp-append-version="true" />


    @*  @if (ViewBag.ClientName == "ZBK")
    {

    <link rel="stylesheet" href="~/css/siteZBK.css" asp-append-version="true" />
    }

    else if
    (ViewBag.ClientName == "ASSE")
    {

    <link rel="stylesheet" href="~/css/siteDefault.css" asp-append-version="true" />
    } *@

</head>

<body style="background-color:#f8fafc">

    <div class="wrapper">
        @if (isAuthenticated && !string.IsNullOrWhiteSpace(languageCode))
        {
            <!-- Sidebar -->
            <div id="sidebar" class="e-sidebar e-control e-lib e-sidebar-left " data-ej-open="true" data-ej-width="250px">

                <!-- Close Button (Only for Small Screens) -->
                <button id="close-sidebar" class="btn btn-light close-btn d-md-none">
                    <i class="bi bi-x-lg"></i>
                </button>

                <!-- User Profile Section -->
                <div class="sidebar-user text-center">
                    <img src="@profileImage" alt="User" class="user-img" style="width:150px;height:150px"
                         onerror="this.onerror=null;this.src='@defaultProfileImage';">
                    <h5 class="user-name">John Doe</h5>
                    <p class="user-role">Software Engineer</p>
                    <hr class="sidebar-divider">
                </div>

                <!-- Sidebar Menu -->
                <div class="sidebar-content flex-grow-1">
                    <ul class="list-unstyled" id="sidebar-menu">
                        <li>
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="sidebar-item text-white d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-speedometer2 me-2"></i> Dashboard</span>
                            </a>
                        </li>

                        <!-- Favorites Dropdown -->
                        <li class="dropdown">
                            <a href="#" class="sidebar-item dropdown-toggle text-white d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse" data-bs-target="#favorites-menu" aria-expanded="false">
                                <span><i class="bi bi-star-fill me-2"></i> Favorites</span>
                            </a>
                            <ul class="collapse list-unstyled ps-4" id="favorites-menu"></ul>
                        </li>

                        <!-- Reports Dropdown -->
                        <li class="dropdown">
                            <a href="#" class="sidebar-item dropdown-toggle text-white d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse" data-bs-target="#reports-menu" aria-expanded="false">
                                <span><i class="bi bi-graph-up me-2"></i> Reports</span>
                            </a>
                            <ul class="collapse list-unstyled ps-4" id="reports-menu"></ul>
                        </li>

                        <!-- My Personal Section -->
                        <li class="dropdown">
                            <a href="#" class="sidebar-item dropdown-toggle text-white d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse" data-bs-target="#personal-menu" aria-expanded="false">
                                <span><i class="bi bi-person-circle me-2"></i> My Personal</span>
                            </a>
                            <ul class="collapse list-unstyled ps-4" id="personal-menu">
                                <li><a href="#" class="dropdown-item">Calendar</a></li>
                                <li><a href="#" class="dropdown-item">Event</a></li>
                                <li><a href="#" class="dropdown-item">Inbox</a></li>
                                <li><a href="#" class="dropdown-item">Chat</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>

                <!-- + LogOut Button -->
                <div class="sidebar-footer">
                    <a href="/Identity/Account/Logout" class="log-out-btn d-flex align-items-center justify-content-center w-100 py-2 fw-bold text-white"
                       style="border-radius: 8px; text-decoration: none; transition: color 0.3s ease-in-out;">
                        <i class="bi bi-box-arrow-right  me-2"></i> Log Out
                    </a>
                </div>

                <!-- Sidebar Footer -->
                <div class="sidebar-footer">
                    <hr class="sidebar-divider">
                    <footer class="text-center text-white">
                        &copy; 2025 - Dynamic Spheres
                    </footer>
                </div>

            </div>
        }
        <!-- Main Content with Navbar -->
        <div id="main-content">
            @if (isAuthenticated && !string.IsNullOrWhiteSpace(languageCode))
            {
                <header>
                    <nav class="navbar navbar-expand-lg  bg-light border-bottom box-shadow  mb-3">
                        <div class="container-fluid">
                            <!-- Sidebar toggle -->
                            <button id="toggle-sidebar" class="btn text-primary me-2">
                                <i class="bi bi-list" style="color:#0d9dda"></i>
                            </button>
                            <!-- Brand + Favorite star in one group -->
                            <a class="navbar-brand fw-bold" href="/Common/AreaNavigation/Index" style="color:#0d9dda">aseeMIS</a>

                            <!-- Right side: search + help + bell + profile -->
                            <ul class="navbar-nav flex-row gap-2 align-items-center ms-auto">
                                <li class="nav-item me-3">
                                    <div class="search-container position-relative">
                                        <!-- Search Icon (Visible Only in SM & MD) -->
                                        <i id="search-icon" class="bi bi-search search-icon d-lg-none"></i>
                                        <!-- Search Box (Initially Hidden in SM & MD, Always Visible in LG) -->
                                        <div id="search-box-container" class="d-none d-lg-block">
                                            <ejs-autocomplete id="topMenu" cssClass="search-box topmenu-with-icons" placeholder="Search page..."
                                                              autofill="true" filterType="Contains" popupWidth="100%" allowCustom="false"
                                                              enableAutoFill="true" actionComplete="onACActionComplete" select="onAutoCompleteSelect">
                                                <e-autocomplete-fields text="FullPathTitle" key="FormHref" iconCss="FormIcon">
                                                </e-autocomplete-fields>
                                            </ejs-autocomplete>
                                        </div>
                                    </div>
                                </li>
                                <!-- Favorite star -->
                                <li class="nav-item me-2">
                                    <button id="btnHelp" type="button"  data-bs-toggle="tooltip" data-bs-placement="bottom" title="Help"
                                            class="btn btn-link nav-link p-0 bi bi-question-circle" style="color:#0d9dda">
                                    </button>
                                </li>
                                <li class="nav-item me-2">
                                    <button id="btnNofitication" type="button" class="btn btn-link nav-link p-0 bi bi-bell btn-outline" style="color:#0d9dda" 
                                    data-bs-toggle="tooltip" data-bs-placement="bottom" title="Nofitication">
                                    </button>
                                </li>
                                <li class="nav-item me-2">
                                    <a id="add-to-favorites" href="/Common/AreaNavigation/IndexFavourites"
                                       class="btn btn-link nav-link p-0 bi bi-star" style="color:#0d9dda"
                                       data-bs-toggle="tooltip" data-bs-placement="bottom" title="Favorites"
                                       aria-label="Favorites"></a>
                                </li>



                                <li class="nav-item dropdown">

                                    <a href="#" class="nav-link  dropdown-toggle d-flex align-items-center"  id="userDropdown" role="button" data-bs-toggle="dropdown"
                                       data-bs-auto-close="true" aria-expanded="false">
                                        <img src="~/images/ProfilePictures/user.png" alt="User" class="rounded-circle" style="width: 30px; height: 30px; color:#0d9dda">
                                    </a>

                                    <ul class="dropdown-menu dropdown-menu-end custom-dropdown-menu" aria-labelledby="userDropdown">
                                        <li>
                                            <a class="dropdown-item" style="color:#0d9dda" href="/Identity/Account/Manage">
                                                <i class="bi bi-person-circle me-3"></i> My Profile
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" style="color:#0d9dda" href="/Identity/Account/Manage/Email">
                                                <i class="bi bi-envelope-at me-3"></i> Email
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" style="color:#0d9dda" href="/Identity/Account/Manage/ChangePassword">
                                                <i class="bi bi-key me-3"></i> Change Password
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" style="color:#0d9dda" href="/Identity/Account/Manage/TwoFactorAuthentication">
                                                <i class="bi bi-shield-lock me-3"></i> TwoFactorAuthentication
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" style="color:#0d9dda" href="/Common/AreaNavigation/IndexFavourites">
                                                <i class="bi bi-star me-3"></i> Favorites
                                            </a>
                                        </li>
                                        <li>
                                            <hr class="dropdown-divider custom-divider" style="color:#0d9dda">
                                        </li>
                                        <li>
                                            <a class="dropdown-item text-danger fw-bold" href="/Identity/Account/Logout">
                                                <i class="bi bi-box-arrow-right me-3"></i> Log Out
                                            </a>
                                        </li>
                                    </ul>

                                </li>
                            </ul>

                        </div>
                    </nav>
                </header>
            }
            <div class="container-fluid">
                <main role="main" class="mb-4 pb-2">
                    @if (isAuthenticated && !string.IsNullOrWhiteSpace(languageCode))
                    {
                      
                        <h2 id="page-title" class="page-title mb-2">
                            <i id="page-icon" class="me-2"></i>
                            
                            <small id="page-title-path" class="text-muted ms-2"></small>
                            <span id="page-title-text"></span>
                        </h2> 
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>
    <!-- GLOBAL SYNCFUSION TOAST -->
    <ejs-toast id="appToast"
               created="onAppToastCreated"
               newestOnTop="true"
               showProgressBar="true"
               showCloseButton="true"
               timeOut="4000">
        <e-toast-position X="Center" Y="Top"></e-toast-position>
    </ejs-toast>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/localizationHelper.js" asp-append-version="true"></script>
    <script src="~/js/entityDetailHelper.js" asp-append-version="true"></script>
    <script src="~/js/gridHelperGeneric.js" asp-append-version="true"></script>
    <script src="~/js/dsInputHelper.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.syncfusion.com/ej2/34.1.32/dist/ej2.min.js"></script>
    

   
    <ejs-scripts></ejs-scripts>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

