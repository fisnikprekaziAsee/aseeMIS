@{
    ViewData["Title"] = "Home Page";
}


<div class="text-center">
    <h1 class="display-4">Welcome</h1>

    <!-- Labels and Button -->
    <div id="messageLabel" class="mt-3"></div>
    <div id="textLabel" class="mt-3"></div>
    <button id="actionButton" class="btn btn-primary mt-3"></button>
    @if (ViewBag.ClientInfo != null)
    {
        var info = ViewBag.ClientInfo;
        <div class="alert alert-secondary mt-3">
            <strong>Client Info:</strong><br />
            IP Address: @info.IpAddress<br />
            Browser: @info.BrowserInfo<br />
            Language: @info.Language<br />
            User Agent: @info.UserAgent<br />
            Referer: @info.Referer<br />
            Server Time: @info.ServerTime<br />
            Schema: @info.Scheme<br />
            Host: @info.Host<br />
        </div>
    }
    
</div>
@section Scripts {
    <script>
        (function () {
          // server-provided data
          const formHierarchy = @Html.Raw(ViewData["FormHierarchyJson"] ?? "[]");
          const serverVersion = "@(ViewData["LanguageStringsVersion"] ?? "")";

          // 1) Save the menu for later use (other pages can read it)
          try {
            localStorage.setItem("formHierarchy", JSON.stringify(formHierarchy));
            
          } catch (e) {
            console.warn("Failed to persist formHierarchy:", e);
          }

          // 2) Language strings: only refresh if the version changed
          const prevVersion = localStorage.getItem("LanguageStringsVersion") || "";
          if (serverVersion && prevVersion !== serverVersion) {
            fetch('@Url.Action("GetLanguageStrings", "Home")')
              .then(r => r.ok ? r.json() : Promise.reject(r.statusText))
              .then(data => {
                localStorage.setItem("LanguageStrings", JSON.stringify(data));
                localStorage.setItem("LanguageStringsVersion", serverVersion);
              })
              .catch(err => {
                console.error("Language strings fetch failed:", err);
                // keep whatever was already in localStorage
              });
          }
          // else: versions match; nothing to do
        })();
    </script>
}
