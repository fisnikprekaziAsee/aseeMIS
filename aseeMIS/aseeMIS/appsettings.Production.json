{
  "Storage": {
    "Provider": "AzureBlob",
    "BlobConnectionString": "",
    "ContainerName": "documents",
    "EnvironmentFolder": "Prod"
  },
  "Syncfusion": {
    "LicenseKey": ""
  },

  "FileSecurity": {
    "ActiveKeyVersion": "v1",
    "Keys": {
      "v1": ""
    }
  },

  "ConnectionStrings": {
    "MainSqlServer": "",
    "DBContextDsDirect": ""
  },

  "BankPartySynchronization": {
    "Enabled": false,
    "PollingIntervalSeconds": 30
  },

  "EfCore": {
    "Defaults": {
      "Provider": "SqlServer"
    },

    "SqlServer": {
      "CommandTimeoutSeconds": 60,
      "EnableRetryOnFailure": true,
      "MaxRetryCount": 5,
      "MaxRetryDelaySeconds": 30,
      "DefaultSchema": "dbo",
      "DefaultConnectionStringName": "MainSqlServer"
    },

    "PostgreSql": {
      "CommandTimeoutSeconds": 60,
      "EnableRetryOnFailure": true,
      "MaxRetryCount": 5,
      "MaxRetryDelaySeconds": 30,
      "DefaultSchema": "public",
      "DefaultConnectionStringName": "MainPostgreSql"
    },

    "Contexts": {
      "DBContextDsDirect": {
        "Provider": "SqlServer",
        "Schema": "dbo",
        "ConnectionStringName": "DBContextDsDirect"
      },

      "DsDirectIntegrationContext": {
        "Provider": "SqlServer",
        "Schema": "dbo",
        "ConnectionStringName": "DBContextDsDirect"
      },

      "CoreIntegrationLogContext": {
        "Provider": "SqlServer",
        "Schema": "dbo",
        "ConnectionStringName": "MainSqlServer"
      },

      "DsCoreIntegrationContext": {
        "Provider": "SqlServer",
        "Schema": "dbo",
        "ConnectionStringName": "MainSqlServer"
      },

      "dsBankPartyDirectContext": {
        "Provider": "SqlServer",
        "Schema": "dbo",
        "ConnectionStringName": "DBContextDsDirect"
      },

      "dsCreditDirectContext": {
        "Provider": "SqlServer",
        "Schema": "dbo",
        "ConnectionStringName": "DBContextDsDirect"
      }
    }
  }
}