@{
    ViewData["Title"] = "Home Page";
}

@{
    List<object> toolbarItems = new List<object>();
    toolbarItems.Add("Add");
    toolbarItems.Add("Edit");
    toolbarItems.Add("ExcelExport");
    toolbarItems.Add("PdfExport");
    toolbarItems.Add("CsvExport");
    toolbarItems.Add("Print");
    toolbarItems.Add("Update");
   
    toolbarItems.Add("Cancel");
    toolbarItems.Add("Search");
    toolbarItems.Add("ColumnChooser");
    toolbarItems.Add(new { tooltipText = "Switch to Dialog Editing ", prefixIcon = "e-expand", id = "Grid_Dialog", align = "Right" });
    toolbarItems.Add(new { tooltipText = "Switch to Inline Editing", prefixIcon = "e-icons e-edit", id = "Grid_Inline", align = "Right" });
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>

    <!-- Labels and Button -->
    <div id="messageLabel" class="mt-3"></div>
    <div id="textLabel" class="mt-3"></div>
    <button id="actionButton" class="btn btn-primary mt-3"></button>
</div>

<ejs-grid id="Grid" allowPaging="true" allowGrouping="true" toolbar=toolbarItems>
    <e-grid-columns>
        <e-grid-column field="OrderID" headerText="Order ID" isPrimaryKey="true" width="120"></e-grid-column>
        <e-grid-column field="CustomerID" headerText="Customer Name" width="150"></e-grid-column>
        <e-grid-column field="Freight" headerText="Freight" format="C2" width="120"></e-grid-column>
        <e-grid-column field="ShipCity" headerText="Ship City" width="170"></e-grid-column>
        <e-grid-column field="ShipCountry" headerText="Ship Country" width="150"></e-grid-column>
    </e-grid-columns>
</ejs-grid>

@section Scripts {
    
    <script>
        $(document).ready(function () {
            const formHierarchy = @Html.Raw(ViewData["FormHierarchyJson"]);
            localStorage.setItem("formHierarchy", JSON.stringify(formHierarchy));

            const serverVersion = "@ViewData["LanguageStringsVersion"]";
            const localLanguageStringsVersion = localStorage.getItem("LanguageStringsVersion") || "0";

            // Update LanguageStrings in localStorage if version differs
            if (localLanguageStringsVersion !== serverVersion) {
                fetchAndStoreLanguageStrings();
                setLocalizedTexts();
            } else {
                 

                setLocalizedTexts();
                 
            }

            // Function to fetch and store language strings in localStorage
            function fetchAndStoreLanguageStrings() {
                $.ajax({
                    url: '/Home/GetLanguageStrings',
                    type: 'GET',
                    success: function (result) {
                        if (result) {
                            localStorage.setItem("LanguageStrings", JSON.stringify(result));
                            localStorage.setItem("LanguageStringsVersion", serverVersion);
                            setLocalizedTexts();
                        } else {
                            console.warn("No data received from the server.");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error fetching language strings:", error);
                    }
                });
               
                

                var ajax = new ej.base.Ajax('/locale/en-US.json', 'GET', false);   
                ajax.send().then((e) => {
                    var loader = JSON.parse(e);
                    console.log(loader);
                    localStorage.setItem("base", loader);
                    
                });

              

            }

            // Set button and labels from localized data
            function setLocalizedTexts() {
                alert("3");
                 var localLanguageStringsVersion = JSON.parse(localStorage.getItem("LanguageStrings") || "[]");
                console.log(localLanguageStringsVersion);
                document.getElementById("messageLabel").innerText = getLocalizedText("GlobalMessage", "SuccessInsert");
                document.getElementById("textLabel").innerText = getLocalizedText("Label", "AppSting.StringType");
                document.getElementById("actionButton").innerText = getLocalizedText("Button", "Add");

               
                
                    var loader = JSON.parse(localStorage.getItem("base") || "[]") ;
                    console.log(loader);
                    ej.base.L10n.load(
                        loader
                    );
                    ej.base.setCulture('en-US');  
            }
        });
    </script>
}