<div id="GridOrder1">
    <!-- Content for GridOrder1 will be loaded here -->
</div>

<div id="GridOrder2">
    <!-- Content for GridOrder2 will be loaded here -->
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // Load content into GridOrder1
        var ajax = new ej.base.Ajax('@Url.Action("AppSettingDetail", "/AppMng/AppSetting")', 'GET', true);
        ajax.send().then();
        ajax.onSuccess = function (data) {
            $("#GridOrder1").html(data);
            eval(document.getElementById('GridOrder1').querySelector('script').innerHTML);
        }

