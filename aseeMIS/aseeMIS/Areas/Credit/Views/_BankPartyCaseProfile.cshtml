    }

    .cbp-kpi-icon {
        position: absolute;
        top: 14px;
        right: 14px;
        font-size: 1rem;
        color: #93a7bf;
    }

    .cbp-kpi-title {
        font-size: .78rem;
        font-weight: 700;
        color: #64748b;
        margin-bottom: .55rem;
    }

    .cbp-kpi-value {
        font-size: 1.3rem;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.1;
    }

    .cbp-kpi-value-primary {
        color: #2089d6;
    }

    .cbp-kpi-value-success {
        color: #16a34a;
    }

    .cbp-kpi-sub {
