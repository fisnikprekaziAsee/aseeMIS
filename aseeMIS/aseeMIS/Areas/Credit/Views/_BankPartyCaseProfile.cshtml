    }

    .cbp-section-title {
        display: flex;
        align-items: center;
        gap: .55rem;
    }

    .cbp-section-icon {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: #eef5fb;
        border: 1px solid #dde8f4;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .9rem;
    }

    .cbp-product-list {
        display: flex;
        flex-direction: column;
        gap: .85rem;
    }

    .cbp-product-card {
        border: 1px solid #e8edf3;
        border-radius: 14px;
        padding: .95rem 1rem;
        background: #f7fafc;
    }

    .cbp-product-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: .75rem;
    }

