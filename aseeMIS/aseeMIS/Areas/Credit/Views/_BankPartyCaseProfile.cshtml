@model aseeMIS.Areas.Credit.ViewModels.CreditBankPartyProfileViewModel

@{
    string Initials()
    {
        var tokens = (Model.FullName ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(x => x[0].ToString().ToUpperInvariant())
            .ToArray();

        return tokens.Length > 0 ? string.Join(string.Empty, tokens) : "?";
    }

    string Money(decimal? value, string? currencyCode = null)
    {
        var prefix = string.IsNullOrWhiteSpace(currencyCode) ? string.Empty : $"{currencyCode} ";
        return $"{prefix}{(value ?? 0m):N2}";
    }

    string DateText(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("dd.MM.yyyy") : "-";
    }

    string DateOnlyText(DateOnly value)
    {
        return value.ToString("dd.MM.yyyy");
    }

    int TermMonths(DateOnly startDate, DateOnly maturityDate)
    {
        return Math.Max(0, ((maturityDate.Year - startDate.Year) * 12) + maturityDate.Month - startDate.Month);
    }

    decimal ProductUtilization(dsCredit.Core.DTOs.FN.CreditCaseProductByBankPartyDto product)
    {
        var approvedAmount = product.Amount <= 0 ? 0m : product.Amount;
        var outstandingAmount = product.OutstandingAmount ?? product.OutstandingExposureAmount ?? 0m;

        if (approvedAmount <= 0m)
            return 0m;

        return Math.Min(100m, Math.Round((outstandingAmount / approvedAmount) * 100m, 2));
    }

    string ProductIcon(dsCredit.Core.DTOs.FN.CreditCaseProductByBankPartyDto product)
    {
        if ((product.ProductTypeName ?? string.Empty).Contains("Factor", StringComparison.OrdinalIgnoreCase))
            return "bi bi-receipt";

        if (product.IsMortgageCase == true)
            return "bi bi-house";

        if ((product.ProductDisplayName ?? string.Empty).Contains("Auto", StringComparison.OrdinalIgnoreCase))
            return "bi bi-car-front";

        return "bi bi-cash-stack";
    }

    string StatusClass(string? statusCode)
    {
        return statusCode?.ToUpperInvariant() switch
        {
            "DISBURSED" or "ACTIVE" or "APPROVED" or "READYFORDISBURSEMENT" => "bg-success-subtle text-success border border-success-subtle",
            "INREVIEW" or "SUBMITTED" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
            _ => "bg-light text-secondary border"
        };
    }

    var profile = Model.Profile!;
}

<style>
