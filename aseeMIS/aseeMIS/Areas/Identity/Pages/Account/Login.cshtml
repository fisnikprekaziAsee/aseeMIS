@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<!-- Full-screen centered container -->
<div class="d-flex justify-content-center align-items-center mt-5" style="background-color: #f6f7fb;">
    <div class="card shadow p-5 m-5 " style="background: #fff; border-radius: 10px;">

        <!-- Brand Logo -->
        <div class="text-center mb-4">
            <h2 class="login-logo fw-bold">aseeMIS Suite</h2>
        </div>

        <!-- Welcome Message -->
        <h5 class="text-center ">Hello! Let’s get started</h5>
        <p class="text-center text-muted">Sign in to continue.</p>
        <section>
            <form id="account" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <!-- Username -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label">Username</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" type="password" autocomplete="current-password" placeholder="Password" aria-required="true" />
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <!-- Remember Me Checkbox -->
                <div class="checkbox mb-3">
                    <label asp-for="Input.RememberMe" class="form-label">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <!-- Login Button -->
                <div>
                    <!-- Sign In Button -->
                    <button id="login-submit" type="submit" class="btn btn-primary w-100 fw-bold text-white">SIGN IN</button>
                </div>

                <!-- Links for Forgot Password, Register, Resend Email -->
                <div class="mt-3 text-center">
                    <a id="forgot-password" asp-page="./ForgotPassword" class="login-link small me-3">Forgot your password?</a>
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="login-link small">Resend email confirmation</a>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<style>
    .card {
        max-width: 500px;
    }

    .login-logo {
        color: var(--ds-blue);
    }

    #account .form-control,
    #account .form-control:focus {
        background-color: var(--ds-blue-light);
        border-color: var(--ds-blue-border);
    }

    #account .form-control:-webkit-autofill,
    #account .form-control:-webkit-autofill:hover,
    #account .form-control:-webkit-autofill:focus {
        -webkit-box-shadow: 0 0 0 1000px var(--ds-blue-light) inset;
        box-shadow: 0 0 0 1000px var(--ds-blue-light) inset;
    }

    #login-submit,
    #login-submit:hover,
    #login-submit:focus,
    #login-submit:active {
        background-color: var(--ds-blue-deep);
        border-color: var(--ds-blue-deep);
    }

    #login-submit:focus:not(:focus-visible),
    #login-submit:active {
        box-shadow: none !important;
        outline: none;
    }

    .login-link,
    .login-link:hover,
    .login-link:focus {
        color: var(--ds-blue);
    }
</style>
