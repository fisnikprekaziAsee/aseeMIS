@{
    ViewData["Title"] = "Test Report Generator";
    var reportId = (int)ViewBag.ReportId;
}

<h2>Test Report Generator</h2>

<p>
    This is a minimal test page to verify the Excel report generator.
</p>

<form asp-action="Generate" method="post">
    <input type="hidden" name="reportId" value="@reportId" />

    <button type="submit" class="btn btn-primary">
        Generate Excel Report
    </button>
</form>
