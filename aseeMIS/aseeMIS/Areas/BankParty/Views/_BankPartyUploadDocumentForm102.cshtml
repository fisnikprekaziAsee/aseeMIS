@model dsBankParty.Core.ViewModels.BankPartyUploadDocumentViewModel
@using System.Reflection
@using aseeMIS.Areas.Common.ViewModels

@{
    var request = ViewData["EntityDetailRequest"] as aseeMIS.Areas.Common.DTOs.EntityDetailRequest
        ?? throw new InvalidOperationException("EntityDetailRequest is required.");

    var formSessionId = request.FormSessionId;
    var formId = request.FormId;
    var isAdd = request.IsAdd || (Model?.UploadDocumentId ?? 0) == 0;
    var isGridDialog = request.IsGridDialog;
    var gridName = request.GridName ?? "";
    var formDomId = "uploadDocumentForm_" + request.FormSessionId;
    var bankPartySearchId = "BankPartySearch_" + request.FormSessionId;
    var creditCaseSearchId = "CreditCaseSearch_" + request.FormSessionId;
    var frameworkSearchId = "FrameworkSearch_" + request.FormSessionId;
    var bankPartySelectFn = "select_Form102_BankParty_" + request.FormSessionId;
    var creditCaseSelectFn = "select_Form102_CreditCase_" + request.FormSessionId;
    var frameworkSelectFn = "select_Form102_Framework_" + request.FormSessionId;
    var searchPartiesUrl = Url.Action("Search", "BankParty", new { area = "BankParty" }) ?? "/BankParty/BankParty/Search";
    var searchCasesUrl = "/Credit/CreditCase/Search";
    var searchFrameworksUrl = "/Credit/CreditFramework/Search";
    var downloadUrl = Url.Action("Download", "CRUD", new { area = "Common" }) ?? "/Common/CRUD/Download";
    var documentTypes = (ViewData["FK_UploadDocumentTypeId"] as IEnumerable<object>) ?? [];
    var payloadPath = Model?.DocumentFilePath;
    var payloadFileName = FileNameFromStoragePath(payloadPath);

    static object? ReadProp(object row, string name)
        => row.GetType().GetProperty(name, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase)?.GetValue(row);

    static string FileNameFromStoragePath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return string.Empty;
        var normalized = path.Replace('\\', '/').TrimEnd('/');
        var slash = normalized.LastIndexOf('/');
        return slash >= 0 ? normalized[(slash + 1)..] : normalized;
    }

    static string DateValue(DateOnly? value) => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : string.Empty;
}

<form id="@formDomId" onsubmit="return false;">
    <div class="form-container ds-upload-document-form"
         data-form-session-id="@formSessionId"
         data-form-id="@formId"
         data-primary-key="UploadDocumentId">

        <input type="hidden" id="UploadDocumentId" name="UploadDocumentId" value="@(Model?.UploadDocumentId ?? 0)" />
        <input type="hidden" id="UploadDocumentEbankingId" name="UploadDocumentEbankingId" value="@(Model?.UploadDocumentEbankingId?.ToString() ?? string.Empty)" />
        <input type="hidden" id="BankPartyId" name="BankPartyId" value="@(Model?.BankPartyId ?? 0)" />
        <input type="hidden" id="BankPartyName" name="BankPartyName" value="@(Model?.BankPartyName ?? Model?.BankPartyFullName ?? string.Empty)" />
        <input type="hidden" id="CreditCaseId" name="CreditCaseId" value="@(Model?.CreditCaseId?.ToString() ?? string.Empty)" />
        <input type="hidden" id="CreditCaseName" name="CreditCaseName" value="@(Model?.CreditCaseName ?? Model?.CaseNumber ?? string.Empty)" />
        <input type="hidden" id="FrameworkId" name="FrameworkId" value="@(Model?.FrameworkId?.ToString() ?? string.Empty)" />
        <input type="hidden" id="FrameworkName" name="FrameworkName" value="@(Model?.FrameworkName ?? Model?.FrameworkNo ?? string.Empty)" />
        <input type="hidden" id="DocumentFilePath" name="DocumentFilePath" value="@(payloadPath ?? string.Empty)" />
        <input type="hidden" id="DocumentFilePathBase64" name="DocumentFilePathBase64" value="" />
        <input type="hidden" id="DocumentFileOriginalFileName" name="DocumentFileOriginalFileName" value="" />
        <input type="hidden" id="DocumentFileContentType" name="DocumentFileContentType" value="" />
        <input type="hidden" id="DocumentNumber" name="DocumentNumber" value="@(Model?.DocumentNumber ?? string.Empty)" />
        <input type="hidden" id="IssuingCountryCode" name="IssuingCountryCode" value="@(Model?.IssuingCountryCode ?? string.Empty)" />
        <input type="hidden" id="IssuingInstitution" name="IssuingInstitution" value="@(Model?.IssuingInstitution ?? string.Empty)" />
        <input type="hidden" id="IssueDate" name="IssueDate" value="@DateValue(Model?.IssueDate)" />
        <input type="hidden" id="ExpiryDate" name="ExpiryDate" value="@DateValue(Model?.ExpiryDate)" />
        <input type="hidden" id="ReplicationStatus" name="ReplicationStatus" value="@(Model?.ReplicationStatus?.ToString() ?? string.Empty)" />

        <div class="ds-card">
            <div class="ds-card-h d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-arrow-up"></i>
                <span class="ds-card-title">@(isAdd ? "Add document" : "Update document")</span>
            </div>
            <div class="ds-card-b">
                <div class="row g-3">
                    <div class="col-12">
                        @await Component.InvokeAsync("SearchAutocomplete", new SearchAutocompleteOptions
                        {
                            SearchUrl = searchPartiesUrl,
                            Placeholder = "Search client...",
                            Id = bankPartySearchId,
                            ValueField = "BankPartyId",
                            TextField = "DisplayText",
                            OnSelectFn = bankPartySelectFn
                        })
                    </div>
                    <div class="col-12 col-lg-6">
                        <label class="form-label fw-semibold" for="UploadDocumentTypeId">Document Type</label>
                        <select id="UploadDocumentTypeId" name="UploadDocumentTypeId" class="form-select">
                            <option value="">Select...</option>
                            @foreach (var row in documentTypes)
                            {
                                var id = ReadProp(row, "UploadDocumentTypeId")?.ToString();
                                var text = ReadProp(row, "DocumentTypeName")?.ToString() ?? id;
                                if (id == (Model?.UploadDocumentTypeId.ToString() ?? string.Empty))
                                {
                                    <option value="@id" selected="selected">@text</option>
                                }
                                else
                                {
                                    <option value="@id">@text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-lg-6">
                        <label class="form-label fw-semibold" for="DocumentName">Document Name</label>
                        <input id="DocumentName" name="DocumentName" class="form-control" value="@(Model?.DocumentName ?? string.Empty)" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold" for="DocumentDescription">Description</label>
                        <textarea id="DocumentDescription" name="DocumentDescription" class="form-control" rows="2">@(Model?.DocumentDescription ?? string.Empty)</textarea>
                    </div>
                    <div class="col-12 col-lg-6">
                        @await Component.InvokeAsync("SearchAutocomplete", new SearchAutocompleteOptions
                        {
                            SearchUrl = searchCasesUrl,
                            Placeholder = "Search credit case...",
                            Id = creditCaseSearchId,
                            ValueField = "CreditCaseId",
                            TextField = "DisplayText",
                            OnSelectFn = creditCaseSelectFn
                        })
                    </div>
                    <div class="col-12 col-lg-6">
                        @await Component.InvokeAsync("SearchAutocomplete", new SearchAutocompleteOptions
                        {
                            SearchUrl = searchFrameworksUrl,
                            Placeholder = "Search framework...",
                            Id = frameworkSearchId,
                            ValueField = "FrameworkId",
                            TextField = "DisplayText",
                            OnSelectFn = frameworkSelectFn
                        })
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold" for="DocumentFile">File</label>
                        <input id="DocumentFile" name="DocumentFile" class="form-control" type="file"
                               accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                        @if (!string.IsNullOrWhiteSpace(payloadPath))
                        {
                            <div class="d-flex align-items-center gap-2 flex-wrap mt-2">
                                <a href="@($"{downloadUrl}?path={Uri.EscapeDataString(payloadPath)}&fileName={Uri.EscapeDataString(payloadFileName)}&formSessionId={Uri.EscapeDataString(formSessionId)}")"
                                   target="_blank"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-download"></i>
                                    Download
                                </a>
                                <span class="small text-muted text-truncate" style="max-width: 360px;" title="@payloadPath">@payloadFileName</span>
                            </div>
                        }
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="IsPrimary" name="IsPrimary" @(Model?.IsPrimary == true ? "checked" : "")>
                            <label class="form-check-label fw-semibold" for="IsPrimary">Primary</label>
                        </div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" @(Model?.IsActive != false ? "checked" : "")>
                            <label class="form-check-label fw-semibold" for="IsActive">Active</label>
                        </div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="IsApproved" name="IsApproved" @(Model?.IsApproved != false ? "checked" : "")>
                            <label class="form-check-label fw-semibold" for="IsApproved">Approved</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3">
            @if (isGridDialog)
            {
                <button type="button" class="btn btn-light" onclick="closeGridPartialDialogEditor('@gridName')">Cancel</button>
            }
            <button type="button" class="btn btn-primary" onclick="saveUploadDocumentForm102(this)">
                <i class="bi bi-check2-square"></i>
                @(isAdd ? "Add document" : "Update document")
            </button>
        </div>
    </div>
</form>

<script>
    (function () {
        const formId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(formDomId));
        const isGridDialog = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isGridDialog));
        const gridName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(gridName));
        const bankPartySearchId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bankPartySearchId));
        const creditCaseSearchId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(creditCaseSearchId));
        const frameworkSearchId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(frameworkSearchId));
        const initialBankPartyName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.BankPartyName ?? Model?.BankPartyFullName ?? string.Empty));
        const initialCaseName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.CreditCaseName ?? Model?.CaseNumber ?? string.Empty));
        const initialFrameworkName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.FrameworkName ?? Model?.FrameworkNo ?? string.Empty));
        const form = document.getElementById(formId);
        if (!form) return;

        function field(id) { return form.querySelector("#" + id); }
        function value(id) { const el = field(id); return el ? el.value : null; }
        function setValue(id, next) { const el = field(id); if (el) el.value = next ?? ""; }
        function toIntOrNull(next) {
            const parsed = Number(next);
            return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
        }
        function read(row, name) {
            return row?.[name] ?? row?.[name.charAt(0).toLowerCase() + name.slice(1)] ?? null;
        }
        function setAutocompleteText(id, text) {
            if (!text) return;
            let tries = 0;
            const timer = setInterval(function () {
                const control = document.getElementById(id)?.ej2_instances?.[0];
                if (!control && ++tries > 50) { clearInterval(timer); return; }
                if (!control) return;
                clearInterval(timer);
                control.text = text;
                control.value = text;
                if (control.element) control.element.value = text;
                control.dataBind();
            }, 50);
        }
        function notify(message) {
            if (typeof window.notify?.error === "function") {
                window.notify.error(message);
                return;
            }
            window.alert(message);
        }
        function readFileAsDataUrl(file) {
            return new Promise(function (resolve, reject) {
                const reader = new FileReader();
                reader.onload = function () { resolve(String(reader.result || "")); };
                reader.onerror = reject;
                reader.readAsDataURL(file);
            });
        }
        function toDateOrNull(next) {
            return next && String(next).trim() ? String(next).trim() : null;
        }

        window[@Html.Raw(System.Text.Json.JsonSerializer.Serialize(bankPartySelectFn))] = function (args) {
            const row = args?.itemData;
            setValue("BankPartyId", read(row, "BankPartyId"));
            setValue("BankPartyName", read(row, "DisplayText") || read(row, "FullName"));
        };
        window[@Html.Raw(System.Text.Json.JsonSerializer.Serialize(creditCaseSelectFn))] = function (args) {
            const row = args?.itemData;
            setValue("CreditCaseId", read(row, "CreditCaseId"));
            setValue("CreditCaseName", read(row, "DisplayText") || read(row, "CaseNumber"));
        };
        window[@Html.Raw(System.Text.Json.JsonSerializer.Serialize(frameworkSelectFn))] = function (args) {
            const row = args?.itemData;
            setValue("FrameworkId", read(row, "FrameworkId"));
            setValue("FrameworkName", read(row, "DisplayText") || read(row, "FrameworkNo"));
        };

        setAutocompleteText(bankPartySearchId, initialBankPartyName);
        setAutocompleteText(creditCaseSearchId, initialCaseName);
        setAutocompleteText(frameworkSearchId, initialFrameworkName);

        window.saveUploadDocumentForm102 = async function () {
            const bankPartyId = toIntOrNull(value("BankPartyId"));
            const uploadDocumentTypeId = toIntOrNull(value("UploadDocumentTypeId"));
            if (!bankPartyId) {
                notify("Select a client.");
                return;
            }
            if (!uploadDocumentTypeId) {
                notify("Select a document type.");
                return;
            }

            const file = field("DocumentFile")?.files?.[0];
            if (file) {
                setValue("DocumentFilePathBase64", await readFileAsDataUrl(file));
                setValue("DocumentFileOriginalFileName", file.name);
                setValue("DocumentFileContentType", file.type || "application/octet-stream");
            }

            const model = {
                UploadDocumentId: toIntOrNull(value("UploadDocumentId")) || 0,
                UploadDocumentEbankingId: toIntOrNull(value("UploadDocumentEbankingId")),
                BankPartyId: bankPartyId,
                BankPartyName: value("BankPartyName"),
                CreditCaseId: toIntOrNull(value("CreditCaseId")),
                CreditCaseName: value("CreditCaseName"),
                FrameworkId: toIntOrNull(value("FrameworkId")),
                FrameworkName: value("FrameworkName"),
                UploadDocumentTypeId: uploadDocumentTypeId,
                DocumentName: value("DocumentName") || null,
                DocumentDescription: value("DocumentDescription") || null,
                DocumentNumber: value("DocumentNumber") || null,
                IssuingCountryCode: value("IssuingCountryCode") || null,
                IssuingInstitution: value("IssuingInstitution") || null,
                IssueDate: toDateOrNull(value("IssueDate")),
                ExpiryDate: toDateOrNull(value("ExpiryDate")),
                DocumentFilePath: value("DocumentFilePath") || null,
                DocumentFilePathBase64: value("DocumentFilePathBase64") || null,
                DocumentFileOriginalFileName: value("DocumentFileOriginalFileName") || null,
                DocumentFileContentType: value("DocumentFileContentType") || null,
                IsPrimary: !!field("IsPrimary")?.checked,
                IsActive: !!field("IsActive")?.checked,
                IsApproved: !!field("IsApproved")?.checked,
                ReplicationStatus: toIntOrNull(value("ReplicationStatus"))
            };

            ds.entity.collectModel = function () { return model; };
            if (isGridDialog) {
                saveGridPartialDialogEditor(gridName, model);
                return;
            }
            ds.entity.save();
        };
    })();
</script>

<style>
    .ds-upload-document-form .ds-card {
        border: 1px solid #e3e8ef;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 8px 18px rgba(16, 24, 40, .06);
    }
    .ds-upload-document-form .ds-card-h { padding: 12px 14px; border-bottom: 1px solid #edf1f5; }
    .ds-upload-document-form .ds-card-title { font-weight: 700; }
    .ds-upload-document-form .ds-card-b { padding: 16px; }
</style>
