@{
    var htmlAttributes = new Dictionary<string, object> { { "controllerName", "/IdentityMng/RoleClaim" } };
}

<div class="row justify-content-center">
    <!-- Language 2 Dropdown -->
    <div class="col-lg-3 control-section">
        <ejs-dropdownlist id="roleDropdowm" allowFiltering="true" dataSource="@ViewBag.Roles" placeholder="Select Role" popupHeight="220px">
            <e-dropdownlist-fields text="RoleName" value="RoleId"></e-dropdownlist-fields>
        </ejs-dropdownlist>
    </div>

    <!-- Button to trigger onLanguageChange -->
    <div class="col-lg-2 text-center d-flex align-items-center">
        <button type="button" class="btn btn-primary custom-btn" onclick="onRoleChange()">Show Claims</button>
    </div>
</div>
<br />

<div class="col-lg-12 control-section msg-default-section">
    <div class="content-section">
        <ejs-message id="RoleClaimModify_Grid_MSG" visible="false" showCloseIcon="true"></ejs-message>
    </div>
</div>

<!-- Datagrid Initialization -->
<ejs-grid id="RoleClaimModify_Grid" beforeBatchSave="beforeBatchSave" gridLines="Both" dataSource="@Model"
          AllowReordering="true" allowSorting="true" allowFiltering="true" allowPdfExport="true" allowExcelExport="true" allowGrouping="true" allowResizing="true" allowPaging="true"
          showColumnChooser="true" toolbarClick="toolbarClick" toolbar="@ViewBag.ToolbarItems" contextMenuItems="@ViewBag.ContextMenuItems"
          contextMenuClick="contextMenuClick" HtmlAttributes="htmlAttributes">
    <e-grid-editSettings allowAdding="true" allowDeleting="true" allowEditing="true" mode="Batch" showConfirmDialog="true" showDeleteConfirmDialog="true"></e-grid-editSettings>
    <e-grid-pagesettings pageCount="10" pageSizes="true"></e-grid-pagesettings>
    <e-grid-filterSettings type="Excel"></e-grid-filterSettings>

    
    <e-grid-columns>
        <e-grid-column field="AutoNumber" isPrimaryKey="true" headerText="Id" allowEditing="false" allowResizing="true" textAlign="Left"></e-grid-column>
        <e-grid-column field="FormId" headerText="Form ID" allowEditing="false" allowResizing="true" textAlign="Left"></e-grid-column>
        <e-grid-column field="FormTitle" headerText="Form Title" allowEditing="false" allowResizing="true" textAlign="Left"></e-grid-column>
        <e-grid-column field="ConstantValue" headerText="Constant Value" allowEditing="false" allowResizing="true" textAlign="Left"></e-grid-column>
        <e-grid-column field="ClaimType" headerText="Claim Type" allowEditing="false" allowResizing="true" textAlign="Left"></e-grid-column>
        <e-grid-column field="ClaimValue" headerText="Claim Value" allowEditing="false" allowResizing="true" textAlign="Left"></e-grid-column>

        <e-grid-column field="RoleId" headerText="Role Id" allowEditing="false" allowResizing="true" textAlign="Left"></e-grid-column>

        <e-grid-column field="HasClaim" headerText="Has Claim" type="boolean" displayAsCheckBox="true" editType="booleanedit" textAlign="Center"></e-grid-column>
    </e-grid-columns>

</ejs-grid>

<script src="~/js/identityMngGridHelper.js" asp-append-version="true"></script>

<script>
    function onRoleChange() {
        // Get the selected language codes and names
        var roleDropdowm = document.getElementById("roleDropdowm").ej2_instances[0];
        var selectedRole = roleDropdowm.value;

        if (selectedRole) {
            var grid = document.getElementById("RoleClaimModify_Grid").ej2_instances[0];
            var changeErrorMessage = document.getElementById("RoleClaimModify_Grid_MSG").ej2_instances[0];

            var url = '@Url.Action("GetClaims", "RoleClaim")';
            $.ajax({
                url: url,
                type: 'GET',
                data: {
                    role: selectedRole
                },
                success: function (data) {
                    grid.dataSource = data;
                    grid.refresh();
                },
                error: function (xhr) {
                    //Error Messages
                    changeErrorMessage.content = "Error while generating constants";
                    changeErrorMessage.visible = true;
                }
            });
        }
    }
    function beforeBatchSave() { //beforeBatchSave event of Grid

        var grid = document.getElementById("RoleClaimModify_Grid").ej2_instances[0];
        var gridMSG = this.element.id + "_MSG";

        console.log(gridMSG);

        var batchChanges = grid.getBatchChanges();

        console.log(batchChanges.changedRecords);

        var ajax = new ej.base.Ajax({ url: "/IdentityMng/RoleClaim/Modify", type: "POST", data: JSON.stringify(batchChanges.changedRecords), contentType: "application/json" });
        /* Assigning input data to a variable for adding */


        /*  Ajax call for adding new line */
        ajax.send().then(function (response) {
            var result = JSON.parse(response);
            if (result.success) {
                /* Displaying success message */
                showSuccessMessage(gridMSG, result.message);
                //grid.refresh();
                // console.log("Success", result.message);
            } else {
                /* Displaying error message */
                showErrorMessage(gridMSG, result.message);
                // console.log("Error", result.message);
                // var originalData = args.previousData;

            }
        }).catch(function (xhr) {
            /* Displaying error message */
            showErrorMessage(gridMSG, xhr.message);
            // console.log("Catch", xhr.message);
        });
    }
</script>

<style>
    #Grid_Inline {
        background-color: #86b7fe;
    }
</style>
