@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="container d-flex justify-content-center">
    <div class="card shadow p-5 m-5 auth-card">

        <div class="text-center mb-2">
            <h2 class="fw-bold" style="color:#0d9dda">aseeMIS</h2>
        </div>

        <h5 class="text-center">Change Password</h5>

        <!-- Success / Error banners -->
        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger")" role="alert">
                @Model.Message
            </div>
        }
        <section>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label"></label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold text-white">Reset Password</button>

                <div class="mt-3 text-right">
                    <a id="Login" asp-area="Identity" asp-page="/Account/Login" class="text-muted small">Return to Login</a>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
 }

<style>
    .auth-card {
        width: min(500px, 90vw);
        min-width: 25vw;
        max-width: 500px;
        border-radius: 10px;
        background: #fff;
    }
</style>
