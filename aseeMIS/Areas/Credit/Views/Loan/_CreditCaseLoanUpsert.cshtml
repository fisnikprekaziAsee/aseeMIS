@if (!isFromCreditHub)
{
    <script src="~/js/creditCaseLoan.js" asp-append-version="true"></script>
}

<script>
    window.select_CreditCaseLoanBankParty = function(args) {
        const bankPartyId = Number(args?.itemData?.BankPartyId || 0);
        const input = document.getElementById("BankPartyId");
        if (input && bankPartyId > 0) input.value = bankPartyId;
        if (bankPartyId > 0 && typeof window.loadCreditCaseLoanProducts === "function") {
            window.loadCreditCaseLoanProducts(bankPartyId, null, null);
        }
    };

    (function() {
        const isFromCreditHub = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isFromCreditHub));
        const isAdd = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isAdd));
        const bankPartySearchId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bankPartySearchId));
        const bankPartySearchUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bankPartySearchUrl));
        const loanProductsUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(loanProductsUrl));
        const initialBankPartyId = @(Model?.CreditCase.BankPartyId ?? 0);
        const selectedLoanProductCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.CreditCase?.ProductCode));
        const selectedLoanPurposeCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.CreditCase?.CreditPurposeCode));
        const amortTemplateDefaultsUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(amortTemplateDefaultsUrl));
        const loanAmortPreviewUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(amortPreviewUrl));
        let incomeRatioInstallments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(amortPreviewInstallments));
        window.updateLoanIncomeRatios = function () {
            if (document.getElementById("IsIndividual")?.value !== "true") return;
            const read = id => Math.max(0, Number(getFieldValue(id) || 0));
            const salary = read("SalaryIncome");
            const income = salary + read("OtherIncome");
            const otherInstallments = read("OtherBankMonthlyInstallments");
            const amounts = (incomeRatioInstallments || []).map(row => {
                const amount = row.ScheduledInstallmentAmount ?? row.scheduledInstallmentAmount;
                return amount != null ? Number(amount) :
                    Number(row.ScheduledPrincipal ?? row.scheduledPrincipal ?? 0) +
                    Number(row.ScheduledInterest ?? row.scheduledInterest ?? 0) +
                    Number(row.ScheduledFee ?? row.scheduledFee ?? 0);
            }).filter(value => Number.isFinite(value) && value > 0);
            const installment = amounts.length ? Math.max(...amounts) : null;
            const label = document.getElementById("LoanIncomeCurrentInstallment");
            if (label) label.textContent = installment == null ? "Generate the amortization plan" : installment.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const render = (id, numerator, denominator) => {
                const output = document.getElementById(id);
                if (!output) return;
                const ratio = numerator != null && Number.isFinite(denominator) && denominator > 0
                    ? numerator / denominator * 100 : null;
                output.textContent = ratio == null ? "—" : ratio.toFixed(2) + "%";
                output.classList.toggle("text-success", ratio != null && ratio < 50);
                output.classList.toggle("text-danger", ratio != null && ratio >= 50);
                output.title = denominator > 0 ? "" : "Income must be greater than zero.";
            };
            const allInstallments = installment == null ? null : installment + otherInstallments;
            render("SalaryInstallmentRatio", installment, salary);
            render("SalaryTotalInstallmentsRatio", allInstallments, salary);
            render("IncomeInstallmentRatio", installment, income);
            render("IncomeTotalInstallmentsRatio", allInstallments, income);
        };
        const amortEnumNames = {
            frequency: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Enum.GetNames<FrequencyCode>())),
            dayCount: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Enum.GetNames<EnumDayCountCalculationType>())),
            principalCalc: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Enum.GetNames<PrincipalCalculationMethod>())),
            graceType: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Enum.GetNames<GraceType>()))
            };
        window.loadCreditCaseLoanProducts = function(bankPartyId, preferredProductCode, preferredPurposeCode) {
            const productDropdown = document.getElementById("ProductCode")?.ej2_instances?.[0];
            if (!productDropdown || !bankPartyId) return;

            productDropdown.dataSource = [];
            productDropdown.value = null;
            productDropdown.dataBind?.();

            fetch(loanProductsUrl + "?bankPartyId=" + encodeURIComponent(bankPartyId), {
                headers: { Accept: "application/json" }
            })
                .then(response => response.ok ? response.json() : [])
                .then(rows => {
                    const products = Array.isArray(rows) ? rows : [];
                    productDropdown.dataSource = products;
                    productDropdown.value = preferredProductCode || null;
                    productDropdown.dataBind?.();

                    const selectedProduct = products.find(x => x.ProductCode === preferredProductCode);
                    const productTypeCodeInput = document.getElementById("ProductTypeCode");
                    if (productTypeCodeInput) {
                        productTypeCodeInput.value = selectedProduct?.ProductTypeCode || "";
                    }

                    if (typeof window.applyLoanProductPurposes === "function") {
                        window.applyLoanProductPurposes(
                            selectedProduct?.CreditProductPurposes || [],
                            preferredPurposeCode || null);
                    }
                })
                .catch(() => {
                    productDropdown.dataSource = [];
                    productDropdown.dataBind?.();
                });
        };

        function initializeContextAutocompletes(attempt) {
            if (isFromCreditHub) {
                if (initialBankPartyId > 0) {
                    window.loadCreditCaseLoanProducts(
                        initialBankPartyId,
                        selectedLoanProductCode,
                        selectedLoanPurposeCode);
                }
                return;
            }

            const bankPartyAutocomplete = document.getElementById(bankPartySearchId)?.ej2_instances?.[0];
            if (!bankPartyAutocomplete) {
                if (attempt < 30) {
                    setTimeout(function() { initializeContextAutocompletes(attempt + 1); }, 50);
                }
                return;
            }

            if (!isAdd) {
                bankPartyAutocomplete.enabled = false;
            }

            bankPartyAutocomplete.dataBind?.();

            if (initialBankPartyId <= 0) return;

            window.loadCreditCaseLoanProducts(
                initialBankPartyId,
                selectedLoanProductCode,
                selectedLoanPurposeCode);

            fetch(bankPartySearchUrl + "?searchText=" + encodeURIComponent(initialBankPartyId), {
                headers: { Accept: "application/json" }
            })
                .then(response => response.ok ? response.json() : [])
                .then(rows => {
                    const selected = (Array.isArray(rows) ? rows : [])
                        .find(row => Number(row?.BankPartyId) === initialBankPartyId);
                    if (!selected) return;

                    bankPartyAutocomplete.dataSource = [selected];
                    bankPartyAutocomplete.value = selected.DisplayText;
                    bankPartyAutocomplete.dataBind?.();
                })
                .catch(() => { });
        }

        initializeContextAutocompletes(0);

        const initialWorkflowSteps = @Html.Raw(Json.Serialize(caseWorkflowSteps));
        const initialProductCode = @Html.Raw(Json.Serialize(Model?.CreditCase?.ProductCode ?? string.Empty));
        const initialPriceListId = @Html.Raw(Json.Serialize(Model?.CreditCase?.PriceListId));
        const initialLoanDates = {
            RequestedStartDate: @Html.Raw(Json.Serialize(requestedStartDateIso)),
            RequestedMaturityDate: @Html.Raw(Json.Serialize(requestedMaturityDateIso)),
            RequestedFirstInstallmentDate: @Html.Raw(Json.Serialize(amortFirstDueDateIso)),
            ApprovedStartDate: @Html.Raw(Json.Serialize(approvedStartDateIso)),
            ApprovedMaturityDate: @Html.Raw(Json.Serialize(approvedMaturityDateIso)),
            ApprovedFirstInstallmentDate: @Html.Raw(Json.Serialize(amortFirstDueDateIso))
            };
        const initialAmortFirstDueDateIso = @Html.Raw(Json.Serialize(amortFirstDueDateIso));
        const firstInstallmentMinDays = 15;
        const firstInstallmentMaxDays = 45;
        const requestedFieldIds = [
            "RequestedStartDate",
            "RequestedFirstInstallmentDate",
            "TermMonths",
            "RequestedMaturityDate",
            "RequestedCreditAmount",
            "RequestedChargeAmount",
            "RequestedInterestRate",
            "RequestedChargeRate",
            "RequestedGracePeriod",
            "RequestedEffectiveInterestRate"
        ];
        const approvedFieldIds = [
            "ApprovedStartDate",
            "ApprovedFirstInstallmentDate",
            "ApprovedTermMonths",
            "ApprovedMaturityDate",
            "ApprovedCreditAmount",
            "ApprovedGracePeriod",
            "ApprovedInterestRate",
            "ApprovedChargeRate",
            "ApprovedPenaltyInterest",
            "ApprovedChargeAmount",
            "ApprovedEffectiveInterestRate"
        ];
        const caseInfoFieldIds = [
            "ProductCode",
            "CreditPurposeCode",
            "CaseDescription"
        ];
        const disbursementFieldIds = [
            "DisbursementBankCode",
            "DisbursementAccountNumber"
        ];
        const requestedToApprovedFieldMap = [
            ["RequestedStartDate", "ApprovedStartDate"],
            ["RequestedFirstInstallmentDate", "ApprovedFirstInstallmentDate"],
            ["TermMonths", "ApprovedTermMonths"],
            ["RequestedMaturityDate", "ApprovedMaturityDate"],
            ["RequestedCreditAmount", "ApprovedCreditAmount"],
            ["RequestedChargeAmount", "ApprovedChargeAmount"],
            ["RequestedInterestRate", "ApprovedInterestRate"],
            ["RequestedChargeRate", "ApprovedChargeRate"],
            ["RequestedEffectiveInterestRate", "ApprovedEffectiveInterestRate"],
            ["RequestedGracePeriod", "ApprovedGracePeriod"]
        ];

        window.calculateLoanEndDate = function() {
            window.validateLoanProductField?.("TermMonths");
            calculateMaturityFromStartDate("Requested", "TermMonths");
            copyRequestedTermsToApproved(true);
        };

        window.onRequestedStartDateChange = function() {
            updateDefaultFirstInstallmentDateFromStart("Requested", { force: true });
            window.calculateLoanEndDate?.();
        };

        function calculateMaturityFromStartDate(prefix, termFieldId) {
            const startDatePicker = document.getElementById(prefix + "StartDate")?.ej2_instances?.[0];
            const termInput = document.getElementById(termFieldId)?.ej2_instances?.[0];
            const endDatePicker = document.getElementById(prefix + "MaturityDate")?.ej2_instances?.[0];

            if (!startDatePicker || !termInput || !endDatePicker) return;

            const startDate = toDateObject(startDatePicker.value);
            const months = termInput.value;

            if (!startDate || !months) return;

            const endDate = addMonthsSafe(startDate, Number(months));

            endDatePicker.value = endDate;
            endDatePicker.dataBind?.();
        }

        window.calculateApprovedEndDate = function() {
            window.validateLoanProductField?.("ApprovedTermMonths");
            calculateMaturityFromStartDate("Approved", "ApprovedTermMonths");
        };

        window.onApprovedStartDateChange = function() {
            updateDefaultFirstInstallmentDateFromStart("Approved", { force: true });
            window.calculateApprovedEndDate?.();
        };

        function applyGracePeriodChange(prefix) {
            const graceMonths = Math.max(
                0,
                Number(getFieldValue(prefix + "GracePeriod") ?? 0));

            if (getActiveLoanTermsPrefix() === prefix) {
                setFieldValue("AmortPlan_GraceType", graceMonths > 0 ? "FullGrace" : "None");
            }
        }

        window.onRequestedGracePeriodChange = function() {
            applyGracePeriodChange("Requested");
            copyRequestedTermsToApproved(true);
        };

        window.onApprovedGracePeriodChange = function() {
            applyGracePeriodChange("Approved");
        };

        window.onRequestedFirstInstallmentDateChange = function() {
            updateFirstInstallmentDateConstraints("Requested");
        };

        window.onApprovedFirstInstallmentDateChange = function() {
            updateFirstInstallmentDateConstraints("Approved");
        };

        window.onRequestedMaturityDateChange = function() {
            calculateTermMonthsFromDates("Requested", "TermMonths");
            window.validateLoanProductField?.("TermMonths");
        };

        window.onApprovedMaturityDateChange = function() {
            calculateTermMonthsFromDates("Approved", "ApprovedTermMonths");
            window.validateLoanProductField?.("ApprovedTermMonths");
        };

        function calculateTermMonthsFromDates(prefix, termFieldId) {
            const startDatePicker = document.getElementById(prefix + "StartDate")?.ej2_instances?.[0];
            const termInput = document.getElementById(termFieldId)?.ej2_instances?.[0];
            const endDatePicker = document.getElementById(prefix + "MaturityDate")?.ej2_instances?.[0];

            if (!startDatePicker || !termInput || !endDatePicker) return;

            const startDate = toDateObject(startDatePicker.value);
            const endDate = toDateObject(endDatePicker.value);
            if (!startDate || !endDate || endDate <= startDate) return;

            let months = ((endDate.getFullYear() - startDate.getFullYear()) * 12) +
                endDate.getMonth() - startDate.getMonth();
            if (endDate.getDate() > startDate.getDate()) {
                months++;
            }

            termInput.value = Math.max(1, months);
            termInput.dataBind?.();
        }

        function syncFirstInstallmentWithActiveTerms(options) {
            const prefix = getActiveLoanTermsPrefix();
            updateFirstInstallmentDateConstraints(prefix);

            if (options?.forceDefault) {
                updateDefaultFirstInstallmentDateFromStart(prefix, { force: true });
                return;
            }

            const validation = validateFirstInstallmentDate(prefix);
            if (!validation.valid) {
                updateDefaultFirstInstallmentDateFromStart(prefix, { force: true });
            }
        }

        function normalizeStatusCode(value) {
            return (value || "").toString().trim().toUpperCase();
        }

        function hasMeaningfulValue(value) {
            return !(value === undefined || value === null || value === "");
        }

        function getFieldValue(id) {
            const element = document.getElementById(id);
            if (!element) {
                return null;
            }

            const instance = element.ej2_instances?.[0];
            if (instance) {
                if (typeof instance.checked !== "undefined") {
                    return instance.checked;
                }

                if (typeof instance.value !== "undefined") {
                    return instance.value;
                }
            }

            if (element.type === "checkbox") {
                return element.checked;
            }

            return element.value;
        }

        function getWorkflowStep(statusCode) {
            const normalizedStatusCode = normalizeStatusCode(statusCode);
            const steps = Array.isArray(window.loanCaseWorkflowSteps) ? window.loanCaseWorkflowSteps : [];

            return steps.find(function(step) {
                return normalizeStatusCode(step?.CaseStatusCode) === normalizedStatusCode;
            }) || null;
        }

        function setComponentEnabled(id, enabled) {
            const element = document.getElementById(id);
            if (!element) {
                return;
            }

            const instance = element.ej2_instances?.[0];
            if (instance) {
                if (typeof instance.enabled !== "undefined") {
                    instance.enabled = enabled;
                }

                if (typeof instance.disabled !== "undefined") {
                    instance.disabled = !enabled;
                }

                if (typeof instance.readonly !== "undefined") {
                    instance.readonly = !enabled;
                }

                instance.dataBind?.();
            }

            element.disabled = !enabled;
            element.readOnly = !enabled;

            const inputElement = instance?.inputElement;
            if (inputElement) {
                inputElement.disabled = !enabled;
                inputElement.readOnly = !enabled;

                if (enabled) {
                    inputElement.removeAttribute("disabled");
                    inputElement.removeAttribute("readonly");
                }
            }

            if (enabled) {
                element.removeAttribute("disabled");
                element.removeAttribute("readonly");
            }
        }

        function setFieldValue(id, value) {
            const element = document.getElementById(id);
            if (!element) {
                return;
            }

            const instance = element.ej2_instances?.[0];
            if (instance) {
                instance.value = value instanceof Date ? new Date(value.getTime()) : value;
                instance.dataBind?.();
                return;
            }

            if (window.ds?.entity?.setField) {
                ds.entity.setField(id, value);
            } else {
                element.value = value ?? "";
            }
        }

        function toNumber(value) {
            if (value === undefined || value === null || value === "") {
                return null;
            }

            const parsed = Number(String(value).replace(/,/g, ""));
            return Number.isFinite(parsed) ? parsed : null;
        }

        function roundMoney(value) {
            return Math.round((value + Number.EPSILON) * 100) / 100;
        }

        function roundRate(value) {
            return Math.round((value + Number.EPSILON) * 10000) / 10000;
        }

        function recalculateCharge(prefix, source, currentAmount) {
            const amount = toNumber(currentAmount !== undefined
                ? currentAmount
                : getFieldValue(prefix + "CreditAmount"));
            const rate = toNumber(getFieldValue(prefix + "ChargeRate"));
            const chargeAmount = toNumber(getFieldValue(prefix + "ChargeAmount"));

            if (!amount || amount <= 0) {
                return;
            }

            if (source === "rate" && rate !== null) {
                setFieldValue(prefix + "ChargeAmount", roundMoney(amount * rate / 100));
                return;
            }

            if (source === "amount" && chargeAmount !== null) {
                setFieldValue(prefix + "ChargeRate", roundRate(chargeAmount * 100 / amount));
                return;
            }

            if (rate !== null) {
                setFieldValue(prefix + "ChargeAmount", roundMoney(amount * rate / 100));
            } else if (chargeAmount !== null) {
                setFieldValue(prefix + "ChargeRate", roundRate(chargeAmount * 100 / amount));
            }
        }

        function bindLoanTermCalculation(prefix) {
            const rateId = prefix + "ChargeRate";
            const amountChargeId = prefix + "ChargeAmount";

            const bind = function(id, handler) {
                const element = document.getElementById(id);
                const instance = element?.ej2_instances?.[0];

                if (instance) {
                    const previous = instance.change;
                    instance.change = function(args) {
                        if (typeof previous === "function") {
                            previous(args);
                        }

                        handler(args);
                    };
                    instance.dataBind?.();
                    return;
                }

                element?.addEventListener("change", handler);
            };

            bind(rateId, function() {
                recalculateCharge(prefix, "rate");
                notifyLoanTermsChanged(prefix);
            });

            bind(amountChargeId, function() {
                recalculateCharge(prefix, "amount");
                notifyLoanTermsChanged(prefix);
            });
        }

        function getActiveLoanTermsPrefix() {
            const statusCode = normalizeStatusCode(getFieldValue("StatusCode") || document.getElementById("CurrentStatusCode")?.value);
            return resolveLoanEditMode(statusCode) === "requested" ? "Requested" : "Approved";
        }

        function notifyLoanTermsChanged(prefix) {
            // Amortization plan is managed on the loan tab; no secondary tab sync needed.
        }

        function enumNameFromIndex(names, index) {
            if (index === null || index === undefined || index === "") {
                return null;
            }

            return names[Number(index)] ?? null;
        }

        function setAmortPlanWrapVisible(id, visible) {
            const wrap = document.getElementById(id);
            if (wrap) {
                wrap.style.display = visible ? "" : "none";
            }
        }

        function updateAmortPlanSettingsVisibility() {
            const principalMethod = getFieldValue("AmortPlan_PrincipalCalcMethod") || "Annuity";
            const useIndexedRate = !!getFieldValue("AmortPlan_UseIndexedRate");

            setAmortPlanWrapVisible(
                "AmortPlan_FixedInstallmentWrap",
                principalMethod === "FixedInstallment");
            setAmortPlanWrapVisible(
                "AmortPlan_FixedPrincipalWrap",
                principalMethod === "FixedPrincipal");
            setAmortPlanWrapVisible("AmortPlan_IndexCodeWrap", useIndexedRate);
            setAmortPlanWrapVisible("AmortPlan_IndexRateWrap", useIndexedRate);
        }

        function extractDayOfMonth(value) {
            if (value instanceof Date && !Number.isNaN(value.getTime())) {
                return value.getDate();
            }

            const text = String(value || "").trim();
            const eu = text.match(/^(\d{1,2})[./-](\d{1,2})[./-](\d{4})$/);
            if (eu) {
                return Number(eu[1]);
            }

            const iso = text.match(/^(\d{4})-(\d{2})-(\d{2})$/);
            if (iso) {
                return Number(iso[3]);
            }

            return null;
        }

        function addMonthsSafe(date, months) {
            const result = new Date(date.getTime());
            result.setMonth(result.getMonth() + months);
            return result;
        }

        function addDaysSafe(date, days) {
            const result = new Date(date.getTime());
            result.setDate(result.getDate() + days);
            return result;
        }

        function toDateObject(value) {
            if (value instanceof Date && !Number.isNaN(value.getTime())) {
                return new Date(value.getTime());
            }

            if (!value) {
                return null;
            }

            return parseInitialDateOnly(String(value).substring(0, 10));
        }

        function daysBetweenDates(startDate, endDate) {
            const ms = endDate.getTime() - startDate.getTime();
            return Math.round(ms / (1000 * 60 * 60 * 24));
        }

        function updateFirstInstallmentDateConstraints(prefix) {
            prefix = prefix || getActiveLoanTermsPrefix();
            const startDate = toDateObject(getFieldValue(prefix + "StartDate"));
            const picker = document.getElementById(prefix + "FirstInstallmentDate")?.ej2_instances?.[0];

            if (!picker || !startDate) {
                return;
            }

            picker.min = addDaysSafe(startDate, firstInstallmentMinDays);
            picker.max = addDaysSafe(startDate, firstInstallmentMaxDays);
            picker.dataBind?.();
        }

        function updateDefaultFirstInstallmentDateFromStart(prefix, options) {
            options = options || {};
            const resolvedPrefix = prefix || getActiveLoanTermsPrefix();

            if (!options.force && initialAmortFirstDueDateIso) {
                return;
            }

            const startDate = toDateObject(getFieldValue(resolvedPrefix + "StartDate"));
            if (!startDate) {
                return;
            }

            const firstDueDate = addMonthsSafe(startDate, 1);
            setFieldValue(resolvedPrefix + "FirstInstallmentDate", firstDueDate);
            updateFirstInstallmentDateConstraints(resolvedPrefix);
        }

        function validateFirstInstallmentDate(prefix) {
            prefix = prefix || getActiveLoanTermsPrefix();
            const startDate = toDateObject(getFieldValue(prefix + "StartDate"));
            const firstDueDate = toDateObject(getFieldValue(prefix + "FirstInstallmentDate"));

            if (!startDate) {
                return {
                    valid: false,
                    message: "Start date is required before setting the first installment date."
                };
            }

            if (!firstDueDate) {
                return {
                    valid: false,
                    message: "First installment date is required."
                };
            }

            if (firstDueDate <= startDate) {
                return {
                    valid: false,
                    message: "First installment date must be after the start date."
                };
            }

            const dayOffset = daysBetweenDates(startDate, firstDueDate);
            if (dayOffset < firstInstallmentMinDays || dayOffset > firstInstallmentMaxDays) {
                return {
                    valid: false,
                    message: `First installment date must be between ${firstInstallmentMinDays} and ${firstInstallmentMaxDays} days after the start date.`
                };
            }

            return { valid: true };
        }

        function applySavedFirstInstallmentDateIfAny() {
            if (!initialAmortFirstDueDateIso) {
                return false;
            }

            const dateValue = parseInitialDateOnly(initialAmortFirstDueDateIso);
            if (!dateValue) {
                return false;
            }

            setFieldValue("RequestedFirstInstallmentDate", dateValue);
            setFieldValue("ApprovedFirstInstallmentDate", dateValue);
            return true;
        }

        function formatPreviewNumber(value, decimals) {
            const num = Number(value);
            if (!Number.isFinite(num)) {
                return "-";
            }

            return num.toLocaleString(undefined, {
                minimumFractionDigits: decimals,
                maximumFractionDigits: decimals
            });
        }

        function formatPreviewDate(value) {
            if (!value) {
                return "-";
            }

            return String(value).substring(0, 10);
        }

        function resolveProductDisplayName(creditCase) {
            if (creditCase?.productName || creditCase?.ProductName) {
                return creditCase.productName || creditCase.ProductName;
            }

            const productDropdown = document.getElementById("ProductCode")?.ej2_instances?.[0];
            const productCode = creditCase?.productCode || creditCase?.ProductCode || productDropdown?.value;
            const selectedProduct = productDropdown?.itemData
                ?? productDropdown?.dataSource?.find?.(function(item) {
                    return item?.ProductCode === productCode;
                });

            return selectedProduct?.ProductName || productCode || "-";
        }

        async function renderLoanUpsertAmortPreview(payload) {
            if (Array.isArray(payload?.installments)) {
                incomeRatioInstallments = payload.installments;
                window.updateLoanIncomeRatios();
            }
            const creditCase = payload?.creditCase || {};
            const version = payload?.version || {};
            const creditCaseId = creditCase.creditCaseId
                || creditCase.CreditCaseId
                || document.getElementById("CreditCaseId")?.value;

            const printArea = document.getElementById("creditLoanUpsertAmortPrintArea");
            const emptyState = document.getElementById("loanUpsertAmortPreviewEmpty");
            const printButton = document.getElementById("btnLoanUpsertPrintPlan");

            if (!printArea || !creditCaseId) {
                return;
            }

            const response = await fetch(
                loanAmortPreviewUrl + "?creditCaseId=" + encodeURIComponent(creditCaseId),
                { headers: { Accept: "text/html" } });

            if (!response.ok) {
                throw new Error(await response.text() || "Unable to load amortization plan.");
            }

            const html = await response.text();
            printArea.innerHTML = html;
            const hasPreview = html.trim().length > 0;
            emptyState?.classList.toggle("d-none", hasPreview);
            printButton?.classList.toggle("d-none", !hasPreview);

            const totalInterestInput = document.getElementById("LoanTotalInterestAmount")?.ej2_instances?.[0];
            if (totalInterestInput && version.TotalScheduledInterest != null) {
                totalInterestInput.value = version.TotalScheduledInterest;
                totalInterestInput.dataBind?.();
            }

            const disbursementFeeInput = document.getElementById("LoanDisbursementFeeAmount")?.ej2_instances?.[0];
            if (disbursementFeeInput && version.TotalDisbursementFeeAmount != null) {
                disbursementFeeInput.value = version.TotalDisbursementFeeAmount;
                disbursementFeeInput.dataBind?.();
            }

            const netDisbursementInput = document.getElementById("LoanNetDisbursementAmount")?.ej2_instances?.[0];
            if (netDisbursementInput && version.NetDisbursedAmount != null) {
                netDisbursementInput.value = version.NetDisbursedAmount;
                netDisbursementInput.dataBind?.();
            }
        }

        window.renderLoanUpsertAmortPreview = renderLoanUpsertAmortPreview;

        window.printLoanUpsertAmortPlan = function() {
            const printable = document.getElementById("creditLoanUpsertAmortPrintArea");
            if (!printable || !printable.innerHTML.trim()) {
                alert("Save the loan first to generate the amortization plan.");
                return;
            }

            const printWindow = window.open("", "_blank", "width=1200,height=800");
            if (!printWindow) {
                alert("Unable to open print preview.");
                return;
            }

            printWindow.document.write(`
