                            .table th, .table td { border: 1px solid #d1d5db; padding: 6px 8px; }
                            .table th { background: #3f6f94; color: white; }
                            .text-end { text-align: right; }
                            .small { font-size: 12px; }
                            .text-muted { color: #6b7280; }
