        function loadAmortPlanTemplateDefaults() {
            const templateCode = getFieldValue("AmortPlan_TemplateCode");
            if (!templateCode) {
                updateAmortPlanSettingsVisibility();
                return;
            }

            const prefix = getActiveLoanTermsPrefix();
            const url = new URL(amortTemplateDefaultsUrl, window.location.origin);
            url.searchParams.set("templateCode", templateCode);

            const startDate = getFieldValue(prefix + "StartDate");
            const termMonths = getFieldValue(prefix === "Requested" ? "TermMonths" : "ApprovedTermMonths");
            const baseAnnualRate = getFieldValue(prefix + "InterestRate");
            const indexRatePercent = getFieldValue("AmortPlan_IndexRatePercent");
            const indexCode = getFieldValue("AmortPlan_IndexCode");

            if (startDate instanceof Date && !Number.isNaN(startDate.getTime())) {
                const yyyy = startDate.getFullYear();
                const mm = String(startDate.getMonth() + 1).padStart(2, "0");
                const dd = String(startDate.getDate()).padStart(2, "0");
                url.searchParams.set("startDate", `${yyyy}-${mm}-${dd}`);
            } else if (startDate) {
                url.searchParams.set("startDate", String(startDate).substring(0, 10));
            }

            if (termMonths) {
                url.searchParams.set("termMonths", termMonths);
            }

            if (baseAnnualRate !== null && baseAnnualRate !== "") {
                url.searchParams.set("baseAnnualRate", baseAnnualRate);
            }

            if (indexRatePercent !== null && indexRatePercent !== "") {
                url.searchParams.set("indexRatePercent", indexRatePercent);
            }

            if (indexCode) {
                url.searchParams.set("indexCode", indexCode);
            }

            fetch(url, {
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            })
                .then(response => response.json())
                .then(payload => {
                    if (!payload?.success || !payload.defaults) {
                        return;
                    }

                    const defaults = payload.defaults;

                    setFieldValue("AmortPlan_TemplateCode", defaults.templateCode);
                    setFieldValue(
                        "AmortPlan_FrequencyCode",
                        enumNameFromIndex(amortEnumNames.frequency, defaults.frequencyCode));
                    setFieldValue(getActiveLoanTermsPrefix() + "FirstInstallmentDate", defaults.nextInstallmentDate);
                    setFieldValue(
                        "AmortPlan_GraceType",
                        enumNameFromIndex(amortEnumNames.graceType, defaults.graceType));
                    setFieldValue("AmortPlan_UseIndexedRate", defaults.useIndexedRate);
                    setFieldValue("AmortPlan_IndexCode", defaults.indexCode);
                    setFieldValue("AmortPlan_IndexRatePercent", defaults.indexRatePercent);
                    setFieldValue(
                        "AmortPlan_DayCountMethod",
                        enumNameFromIndex(amortEnumNames.dayCount, defaults.dayCountMethod));
                    setFieldValue(
                        "AmortPlan_PrincipalCalcMethod",
                        enumNameFromIndex(amortEnumNames.principalCalc, defaults.principalCalcMethod));

                    updateAmortPlanSettingsVisibility();
                })
                .catch(error => {
                    console.error(error);
                });
        }

        function bindAmortPlanSettingsHandlers() {
            const bindChange = function(id, handler) {
                const element = document.getElementById(id);
                const instance = element?.ej2_instances?.[0];

                if (instance) {
                    const previous = instance.change;
                    instance.change = function(args) {
                        if (typeof previous === "function") {
                            previous(args);
                        }

                        handler(args);
                    };
                    instance.dataBind?.();
                    return;
                }

                element?.addEventListener("change", handler);
            };

            bindChange("AmortPlan_TemplateCode", function() {
                loadAmortPlanTemplateDefaults();
            });

            bindChange("AmortPlan_PrincipalCalcMethod", function() {
                updateAmortPlanSettingsVisibility();
            });

            bindChange("AmortPlan_UseIndexedRate", function() {
                updateAmortPlanSettingsVisibility();
            });

        }

        function initializeAmortPlanSettings(attempt) {
            const requiredIds = [
                "AmortPlan_TemplateCode",
                "AmortPlan_PrincipalCalcMethod",
                "AmortPlan_UseIndexedRate",
                "RequestedFirstInstallmentDate",
                "ApprovedFirstInstallmentDate",
                "RequestedStartDate",
                "ApprovedStartDate"
            ];
            const allReady = requiredIds.every(function(id) {
                return !!document.getElementById(id)?.ej2_instances?.[0];
            });

            if (!allReady && attempt < 20) {
                setTimeout(function() { initializeAmortPlanSettings(attempt + 1); }, 50);
                return;
            }

            bindAmortPlanSettingsHandlers();

            if (applySavedFirstInstallmentDateIfAny()) {
                syncFirstInstallmentWithActiveTerms();
            } else {
                updateDefaultFirstInstallmentDateFromStart(getActiveLoanTermsPrefix(), { force: true });
            }

            updateAmortPlanSettingsVisibility();

        }

        window.applyLoanAmortizationToActiveTerms = function(values) {
            const prefix = getActiveLoanTermsPrefix();

            if (values.startDate !== undefined) {
                setFieldValue(prefix + "StartDate", values.startDate);
            }

            if (values.maturityDate !== undefined) {
                setFieldValue(prefix + "MaturityDate", values.maturityDate);
            }

            if (values.creditAmount !== undefined) {
                setFieldValue(prefix + "CreditAmount", values.creditAmount);
            }

            if (values.interestRate !== undefined) {
                setFieldValue(prefix + "InterestRate", values.interestRate);
            }

            if (values.chargeRate !== undefined) {
                setFieldValue(prefix + "ChargeRate", values.chargeRate);
            }

            if (values.gracePeriod !== undefined) {
                setFieldValue(prefix + "GracePeriod", values.gracePeriod);
            }

            recalculateCharge(prefix, "rate");
        };

        function setFieldGroupEnabled(ids, enabled) {
            ids.forEach(function(id) {
                setComponentEnabled(id, enabled);
            });
        }

        function copyRequestedTermsToApproved(overwrite) {
            requestedToApprovedFieldMap.forEach(function(pair) {
                const requestedValue = getFieldValue(pair[0]);
                const approvedValue = getFieldValue(pair[1]);

                if (hasMeaningfulValue(requestedValue) &&
                    (overwrite || !hasMeaningfulValue(approvedValue))) {
                    setFieldValue(pair[1], requestedValue);
                }
            });
        }

        window.copyLoanRequestedTermsToApproved = function() {
            copyRequestedTermsToApproved(true);
        };

        function bindRequestedTermsCopy() {
            requestedToApprovedFieldMap.forEach(function(pair) {
                const element = document.getElementById(pair[0]);
                const instance = element?.ej2_instances?.[0];
                const sync = function(value) {
                    const requestedValue = value !== undefined
                        ? value
                        : getFieldValue(pair[0]);

                    setFieldValue(pair[1], requestedValue);
                };

                if (instance) {
                    const previous = instance.change;
                    instance.change = function(args) {
                        if (typeof previous === "function") {
                            previous(args);
                        }
                        sync(args?.value);
                    };
                    instance.dataBind?.();
                }

                // Syncfusion NumericTextBox raises `change` after commit/blur.
                // The native input event gives immediate Requested -> Approved
                // mirroring while the user is still typing.
                element?.addEventListener("input", function() {
                    queueMicrotask(function() {
                        const currentInstance = element.ej2_instances?.[0];
                        const moduleName = currentInstance?.getModuleName?.();
                        const value = moduleName === "numerictextbox"
                            ? toNumber(element.value)
                            : currentInstance?.value;

                        sync(value);
                    });
                });

                if (!instance) {
                    element?.addEventListener("change", function() {
                        sync();
                    });
                }
            });
        }

        function resolveLoanEditMode(statusCode) {
            const normalizedStatusCode = normalizeStatusCode(statusCode);
            if (!normalizedStatusCode) {
                return "requested";
            }

            const workflowStep = getWorkflowStep(normalizedStatusCode);
            if (workflowStep?.IsTerminal) {
                return "locked";
            }

            // In the loan workflow IsEditable selects which term set is edited:
            // true  -> Requested Terms; false -> Approved Terms.
            // Keep DRAFT as a safe fallback only when workflow metadata is unavailable.
            if (workflowStep) {
                return workflowStep.IsEditable ? "requested" : "approved";
            }

            return normalizedStatusCode === "DRAFT" ? "requested" : "approved";
        }

        function isCurrentStatusChangeAllowed() {
            const currentStatusCode = normalizeStatusCode(document.getElementById("CurrentStatusCode")?.value);
            if (!currentStatusCode) {
                return true;
            }

            const workflowStep = getWorkflowStep(currentStatusCode);
            return workflowStep ? !!workflowStep.AllowsStatusChange : true;
        }

        window.syncLoanCaseFormMode = function(statusCode) {
            const selectedStatusCode = normalizeStatusCode(
                statusCode ||
                getFieldValue("StatusCode") ||
                document.getElementById("CurrentStatusCode")?.value);
            const editMode = resolveLoanEditMode(selectedStatusCode);
            const statusChangeAllowed = isCurrentStatusChangeAllowed();
            const disbursementEditable =
                selectedStatusCode === "DISBURSED" &&
                statusChangeAllowed;

            if (editMode === "approved") {
                copyRequestedTermsToApproved(false);
            }

            setFieldGroupEnabled(requestedFieldIds, editMode === "requested");
            setFieldGroupEnabled(approvedFieldIds, editMode === "approved");
            setFieldGroupEnabled(caseInfoFieldIds, editMode === "requested");
            setFieldGroupEnabled(disbursementFieldIds, disbursementEditable);
            setComponentEnabled("StatusCode", statusChangeAllowed);

            const isWorkflowStepEditableInput = document.getElementById("IsWorkflowStepEditable");
            if (isWorkflowStepEditableInput) {
                isWorkflowStepEditableInput.value = editMode === "requested" ? "true" : "false";
            }

            setComponentEnabled("RequestedInterestRate", false);
            setComponentEnabled("RequestedChargeRate", false);
            setComponentEnabled("RequestedChargeAmount", false);
            setComponentEnabled("RequestedEffectiveInterestRate", false);

            const saveButton = document.querySelector("#@formDomId button[type='submit']");
            if (saveButton) {
                saveButton.disabled = !(editMode !== "locked" || statusChangeAllowed || disbursementEditable);
            }

            syncFirstInstallmentWithActiveTerms();
        };

        if (typeof window.setLoanCaseWorkflowSteps === "function") {
            window.setLoanCaseWorkflowSteps(initialWorkflowSteps);
        } else {
            window.loanCaseWorkflowSteps = initialWorkflowSteps;
        }

        const initialStatusCode = normalizeStatusCode(
            getFieldValue("StatusCode") ||
            document.getElementById("CurrentStatusCode")?.value);

        if (initialProductCode && !initialStatusCode && typeof window.refreshLoanCaseWorkflowStatuses === "function") {
            window.refreshLoanCaseWorkflowStatuses("");
        }

        bindLoanTermCalculation("Requested");
        bindLoanTermCalculation("Approved");
        bindRequestedTermsCopy();

        function parseInitialDateOnly(value) {
            if (!value) return null;
            const parts = String(value).split("-").map(Number);
            if (parts.length !== 3 || parts.some(Number.isNaN)) return null;
            return new Date(parts[0], parts[1] - 1, parts[2]);
        }

        function initializeLoanDatePickers(attempt) {
            const entries = Object.entries(initialLoanDates);
            const allReady = entries.every(function(entry) {
                return !!document.getElementById(entry[0])?.ej2_instances?.[0];
            });

            if (!allReady && attempt < 20) {
                setTimeout(function() { initializeLoanDatePickers(attempt + 1); }, 50);
                return;
            }

            entries.forEach(function(entry) {
                const dateValue = parseInitialDateOnly(entry[1]);
                const instance = document.getElementById(entry[0])?.ej2_instances?.[0];
                if (!dateValue || !instance) return;

                instance.value = dateValue;
                instance.dataBind?.();
            });

            const productDropdown = document.getElementById("ProductCode")?.ej2_instances?.[0];
            const priceListDropdown = document.getElementById("PriceListId")?.ej2_instances?.[0];
            if (initialProductCode && productDropdown && priceListDropdown &&
                typeof window.onProductChange === "function") {
                const selectedProduct = productDropdown.itemData
                    ?? productDropdown.dataSource?.find?.(x => x.ProductCode === initialProductCode);
                window.onProductChange({
                    itemData: selectedProduct,
                    preserveExistingSelection: true,
                    preferredPriceListId: initialPriceListId,
                    preferredPurposeCode: selectedLoanPurposeCode
                });
            }

            window.syncLoanCaseFormMode(initialStatusCode);
            initializeAmortPlanSettings(0);
            window.updateLoanIncomeRatios();
        }

        window.validateLoanFirstInstallmentDate = validateFirstInstallmentDate;
        window.getLoanActiveTermsPrefix = getActiveLoanTermsPrefix;
        window.resolveLoanEditMode = resolveLoanEditMode;

        initializeLoanDatePickers(0);
    })();

    window.loanPreSave = function(btn) {
        const container = btn.closest(".form-container");

        const getValue = function(id) {
            const el = document.getElementById(id);
            if (!el) return null;

            const ej2 = el.ej2_instances?.[0];
            if (ej2) {
                if (typeof ej2.checked === "boolean") return ej2.checked;
                return ej2.value;
            }

            if (el.matches("input, select, textarea")) return el.value;

            const input = el.querySelector("input, select, textarea");
            return input ? input.value : null;
        };

        const getText = function(id) {
            const el = document.getElementById(id);
            const ej2 = el?.ej2_instances?.[0];

            if (ej2?.text) return ej2.text;
            if (ej2?.inputElement?.value) return ej2.inputElement.value;
            return null;
        };

        const toDateOnly = function(value) {
            if (!value) return null;
            if (value instanceof Date && !Number.isNaN(value.getTime())) {
                const yyyy = value.getFullYear();
                const mm = String(value.getMonth() + 1).padStart(2, "0");
                const dd = String(value.getDate()).padStart(2, "0");
                return `${yyyy}-${mm}-${dd}`;
            }

            const text = String(value).trim();
            const eu = text.match(/^(\d{1,2})[./-](\d{1,2})[./-](\d{4})$/);
            if (eu) {
                return `${eu[3]}-${eu[2].padStart(2, "0")}-${eu[1].padStart(2, "0")}`;
            }

            return text.substring(0, 10);
        };

        const toNumber = function(value, defaultValue = 0) {
            if (value === null || value === undefined || value === "") return defaultValue;
            const parsed = Number(value);
            return Number.isFinite(parsed) ? parsed : defaultValue;
        };

        const toNullableNumber = function(value) {
            if (value === null || value === undefined || value === "") return null;
            const parsed = Number(value);
            return Number.isFinite(parsed) ? parsed : null;
        };

        const bankPartyId = getValue("BankPartyId") || document.getElementById("ccBankPartyBankPartyId")?.value;

        const buildLoanModel = function() {
            const statusCode = (
                getValue("StatusCode") ||
                document.getElementById("CurrentStatusCode")?.value ||
                "DRAFT"
            ).toString().trim().toUpperCase();
            const requestedStartDate = toDateOnly(getValue("RequestedStartDate"));
            const requestedMaturityDate = toDateOnly(getValue("RequestedMaturityDate"));
            const requestedCreditAmount = getValue("RequestedCreditAmount");
            const requestedInterestRate = getValue("RequestedInterestRate");
            const requestedChargeRate = getValue("RequestedChargeRate");
            const requestedChargeAmount = getValue("RequestedChargeAmount");
            const requestedEffectiveInterestRate = getValue("RequestedEffectiveInterestRate");
            const approvedStartDate = toDateOnly(getValue("ApprovedStartDate"));
            const approvedMaturityDate = toDateOnly(getValue("ApprovedMaturityDate"));
            const approvedCreditAmount = getValue("ApprovedCreditAmount");
            const approvedInterestRate = getValue("ApprovedInterestRate");
            const approvedChargeRate = getValue("ApprovedChargeRate");
            const approvedChargeAmount = getValue("ApprovedChargeAmount");
            const approvedEffectiveInterestRate = getValue("ApprovedEffectiveInterestRate");
            const approvedPenaltyInterest = getValue("ApprovedPenaltyInterest");
            const isWorkflowStepEditable =
                String(getValue("IsWorkflowStepEditable") ?? "true").toLowerCase() === "true";
            const disbursementBankCode = getValue("DisbursementBankCode");
            const disbursementAccountNumber = getValue("DisbursementAccountNumber");
            const amortTemplateCode = getValue("AmortPlan_TemplateCode");
            const amortDayCountMethod = getValue("AmortPlan_DayCountMethod");
            const amortPrincipalCalcMethod = getValue("AmortPlan_PrincipalCalcMethod");
            const amortFrequencyCode = getValue("AmortPlan_FrequencyCode");
            const activeTermsPrefix = window.getLoanActiveTermsPrefix?.() || "Requested";
            const amortFirstDueDate = toDateOnly(getValue(activeTermsPrefix + "FirstInstallmentDate"));
            const amortGraceType = getValue("AmortPlan_GraceType");
            const amortUseIndexedRate = !!getValue("AmortPlan_UseIndexedRate");
            const amortIndexCode = getValue("AmortPlan_IndexCode");
            const amortIndexRatePercent = toNullableNumber(getValue("AmortPlan_IndexRatePercent"));
            const amortFixedInstallmentAmount = toNullableNumber(getValue("AmortPlan_FixedInstallmentAmount"));
            const amortFixedPrincipalAmount = toNullableNumber(getValue("AmortPlan_FixedPrincipalAmount"));
            const outstandingAmount = getValue("OutstandingAmount");

            ds.entity.setField("StatusCode", statusCode);
            ds.entity.setField("CurrentStatusCode", statusCode);

            return {
                CreditCaseId: toNumber(getValue("CreditCaseId")),
                CreditPurposeCode: getValue("CreditPurposeCode"),
                GracePeriodRequested: toNumber(getValue("RequestedGracePeriod")),
                RequestedGracePeriod: toNumber(getValue("RequestedGracePeriod")),
                GracePeriodApproved: toNullableNumber(getValue("ApprovedGracePeriod")),
                ApprovedGracePeriod: toNullableNumber(getValue("ApprovedGracePeriod")),
                OutstandingAmount: outstandingAmount,
                LoanTotalInterestAmount: getValue("LoanTotalInterestAmount"),
                LoanDisbursementFeeAmount: getValue("LoanDisbursementFeeAmount"),
                LoanNetDisbursementAmount: getValue("LoanNetDisbursementAmount"),
                RequestedDisbursementFeeMinimumAmount: toNumber(getValue("RequestedDisbursementFeeMinimumAmount")),
                ApprovedDisbursementFeeMinimumAmount: toNullableNumber(getValue("ApprovedDisbursementFeeMinimumAmount")),
                IsWorkflowStepEditable: isWorkflowStepEditable,
                BankCode: disbursementBankCode,
                DisbursementAccountNumber: disbursementAccountNumber,
                CreditCase: {
                    CreditCaseId: toNumber(getValue("CreditCaseId")),
                    CreditApplicationId: toNullableNumber(getValue("CreditApplicationId")),
                    BankPartyId: toNumber(bankPartyId),
                    FrameworkId: toNullableNumber(getValue("FrameworkId")),
                    ProductCode: getValue("ProductCode"),
                    ProductTypeCode: getValue("ProductTypeCode"),
                    PriceListId: toNullableNumber(getValue("PriceListId")),
                    WorkflowId: toNullableNumber(getValue("WorkflowId")),
                    CurrencyCode: getValue("CurrencyCode") || "EUR",
                    StageCode: getValue("StageCode") || "A0",
                    LastUpdatedUserId: toNumber(getValue("LastUpdatedUserId"), -1),
                    ConcurrencyStamp: getValue("ConcurrencyStamp"),
                    CreditStatusCode: statusCode,
                    StatusCode: statusCode,
                    CreditDecisionReasonCode: getValue("CreditDecisionReasonCode"),
                    DecisionReasonNotes: getValue("LoanDecisionReasonNotes"),
                    CreditPurposeCode: getValue("CreditPurposeCode"),
                    CaseDescription: getValue("CaseDescription"),
                    OutstandingExposureAmount: outstandingAmount,
                    StartDateRequested: requestedStartDate,
                    MaturityDateRequested: requestedMaturityDate,
                    CreditAmountRequested: toNumber(requestedCreditAmount),
                    InterestRateRequested: toNumber(requestedInterestRate),
                    PricingChargeRateRequested: toNumber(requestedChargeRate),
                    PricingChargeAmountRequested: toNumber(requestedChargeAmount),
                    EffectiveInterestRateRequested: toNumber(requestedEffectiveInterestRate),
                    PenatlyInterestRequested: toNumber(getValue("RequestedPenaltyInterest") ?? approvedPenaltyInterest),
                    IsIndividual: String(getValue("IsIndividual")).toLowerCase() === "true",
                    StartDateApproved: approvedStartDate,
                    MaturityDateApproved: approvedMaturityDate,
                    CreditAmountApproved: toNullableNumber(approvedCreditAmount),
                    InterestRateApproved: toNullableNumber(approvedInterestRate),
                    PricingChargeRateApproved: toNullableNumber(approvedChargeRate),
                    PricingChargeAmountApproved: toNullableNumber(approvedChargeAmount),
                    EffectiveInterestRateApproved: toNullableNumber(approvedEffectiveInterestRate),
                    PenatlyInterestApproved: toNullableNumber(approvedPenaltyInterest),
                    DayInDelayActual: 0,
                    DayInDelayMaximum: 0,
                    CaseNumber: getValue("CaseNumber") || "DRAFT",
                    DisbursementBankCode: disbursementBankCode,
                    DisbursementAccountNumber: disbursementAccountNumber
                },
                CreditCaseAmortPlanVersion: {
                    AmortizationTemplateCode: amortTemplateCode || null,
                    DayCountCalculationTypeCode: amortDayCountMethod || "ActualActual_365_366",
                    PrincipalCalculationMethodCode: amortPrincipalCalcMethod || "Annuity",
                    FrequencyCode: amortFrequencyCode || null,
                    FirstDueDate: amortFirstDueDate,
                    GraceTypeCode: amortGraceType || "None",
                    GraceUntilDate: null,
                    UseIndexedRate: amortUseIndexedRate,
                    IndexCode: amortUseIndexedRate ? (amortIndexCode || "EURIBOR_3M") : null,
                    IndexRatePercent: amortUseIndexedRate ? amortIndexRatePercent : null,
                    FixedInstallmentAmount: amortFixedInstallmentAmount,
                    FixedPrincipalAmount: amortFixedPrincipalAmount,
                    IsCurrent: true,
                    IsLocked: false,
                    IsSuperseded: false,
                    IsActive: true
                }
            };
        };

        ds.entity.collectModel = buildLoanModel;
        ds.entity.prepareModel = function() {
            return buildLoanModel();
        };

        ds.entity.afterSave = async function(result, model) {
            const updatedRow = result?.updatedRow || {};
            const updatedCase = updatedRow.CreditCase || {};
            const resolvedCreditCaseId = updatedRow.CreditCaseId ?? updatedCase.CreditCaseId ?? model.CreditCaseId ?? "";
            const resolvedCaseNumber = updatedCase.CaseNumber ?? updatedRow.CreditCaseName ?? model.CreditCase?.CaseNumber ?? "";
            const resolvedFormSessionId = container.dataset.formSessionId || "";

            ds.entity.setField("CreditCaseId", resolvedCreditCaseId);
            ds.entity.setField("CreditApplicationId", updatedCase.CreditApplicationId ?? model.CreditCase?.CreditApplicationId ?? "");
            ds.entity.setField("CaseNumber", resolvedCaseNumber);
            ds.entity.setField("WorkflowId", updatedCase.WorkflowId ?? model.CreditCase?.WorkflowId ?? "");
            ds.entity.setField("FrameworkId", updatedCase.FrameworkId ?? model.CreditCase?.FrameworkId ?? "");
            ds.entity.setField("CurrencyCode", updatedCase.CurrencyCode ?? model.CreditCase?.CurrencyCode ?? "EUR");
            ds.entity.setField("StageCode", updatedCase.StageCode ?? model.CreditCase?.StageCode ?? "A0");
            ds.entity.setField("LastUpdatedUserId", updatedCase.LastUpdatedUserId ?? model.CreditCase?.LastUpdatedUserId ?? -1);
            ds.entity.setField("ConcurrencyStamp", updatedCase.ConcurrencyStamp ?? model.CreditCase?.ConcurrencyStamp ?? "");
            const savedStatusCode =
                updatedCase.CreditStatusCode ??
                updatedCase.StatusCode ??
                model.CreditCase?.CreditStatusCode ??
                model.CreditCase?.StatusCode ??
                "DRAFT";

            ds.entity.setField("StatusCode", savedStatusCode);
            ds.entity.setField("CurrentStatusCode", savedStatusCode);
            // Refresh from the persisted status, not the status from opening the form.
            try {
                await window.refreshLoanCaseWorkflowStatuses?.(savedStatusCode);
            } catch (error) {
                console.error("Loan was saved, but refreshing its available statuses failed.", error);
                notify?.warning?.("Saved successfully, but the next statuses could not be refreshed.");
            }

            ds.entity.setField("DisbursementBankCode", updatedRow.BankCode ?? updatedCase.DisbursementBankCode ?? model.BankCode ?? "");
            ds.entity.setField("DisbursementAccountNumber", updatedRow.DisbursementAccountNumber ?? updatedCase.DisbursementAccountNumber ?? model.DisbursementAccountNumber ?? "");

            if (typeof window.updateCreditHubCurrentCaseContext === "function") {
                window.updateCreditHubCurrentCaseContext(resolvedCreditCaseId, resolvedCaseNumber, resolvedFormSessionId);
            }

            if (bankPartyId && typeof window.refreshCreditCasesGrid === "function") {
                window.refreshCreditCasesGrid(bankPartyId);
            } else if (bankPartyId && typeof window.loadApplication === "function") {
                window.loadApplication(bankPartyId);
            }

            if (typeof window.refreshLoanSupportingTabs === "function") {
                window.refreshLoanSupportingTabs();
            }

            window.renderLoanUpsertAmortPreview?.({
                installments: updatedRow?.CreditCaseAmortPlanInstallments ?? [],
                version: updatedRow?.CreditCaseAmortPlanVersion ?? {},
                creditCase: updatedRow?.CreditCase ?? model?.CreditCase ?? {}
            });

        };

        const model = buildLoanModel();
        const creditCaseId = Number(model.CreditCaseId || 0);

        const requiredCase = model.CreditCase;
        if (!requiredCase.BankPartyId ||
            !requiredCase.ProductCode ||
            !requiredCase.StartDateRequested ||
            !requiredCase.MaturityDateRequested ||
            requiredCase.CreditAmountRequested <= 0) {
            console.error("[CreditCaseLoan.preSave] Invalid model", model);
            notify?.warning?.("Client, product, requested dates and credit amount are required.");
            return;
        }

        const approvedRequiredValues = [
            requiredCase.StartDateApproved,
            requiredCase.MaturityDateApproved,
            requiredCase.CreditAmountApproved,
            requiredCase.InterestRateApproved,
            requiredCase.EffectiveInterestRateApproved,
            requiredCase.PricingChargeRateApproved,
            requiredCase.PricingChargeAmountApproved,
            requiredCase.PenatlyInterestApproved,
            model.ApprovedGracePeriod,
            getValue("ApprovedTermMonths")
        ];
        const hasMissingApprovedTerm = approvedRequiredValues.some(function(value) {
            return value === null || value === undefined || value === "";
        });

        if (hasMissingApprovedTerm || Number(getValue("ApprovedTermMonths")) < 1) {
            notify?.warning?.("All approved terms are required.");
            return;
        }

        if (window.validateAllLoanProductLimits && !window.validateAllLoanProductLimits()) {
            notify?.warning?.("Credit amount and months must be within the selected product limits.");
            return;
        }

        const firstInstallmentValidation = window.validateLoanFirstInstallmentDate?.(
            window.getLoanActiveTermsPrefix?.());
        if (firstInstallmentValidation && !firstInstallmentValidation.valid) {
            notify?.warning?.(firstInstallmentValidation.message);
            return;
        }

        console.log("[CreditCaseLoan.preSave] model", model);

        if (!ds.entity.validateHtmlForm(container) || !ds.entity.validateForm()) {
            notify?.warning?.("Please correct validation errors");
            return;
        }

        if (window.ds?.input?.validateRequiredDatePickers &&
            !window.ds.input.validateRequiredDatePickers(container, { showToast: true })) {
            return;
        }

        if (ds.entity.isSaving) return;

        const formSessionId = container.dataset.formSessionId || null;
        const isUpdate = creditCaseId > 0;
        ds.entity.setSavingState(true, isUpdate
            ? "Updating loan and amortization plan..."
            : "Creating loan and amortization plan...");

        const ajax = new ej.base.Ajax({
            url: isUpdate
                ? "/Credit/CreditCaseLoan/Update"
                : "/Credit/CreditCaseLoan/Add",
            type: "POST",
            data: JSON.stringify(model),
            contentType: "application/json"
        });

        ajax.beforeSend = function(args) {
            if (formSessionId) {
                args.httpRequest.setRequestHeader("FormSessionId", formSessionId);
            }
        };

        ajax.send()
            .then(async function(response) {
                let result = {};
                try { result = JSON.parse(response); } catch { }

                if (result?.success !== true) {
                    notify?.error?.(result?.message || "Save failed");
                    return;
                }

                notify?.success?.("Saved successfully");
                await ds.entity.afterSave?.(result, model, container, false);
                window.renderLoanUpsertAmortPreview?.({
                    installments: result?.updatedRow?.CreditCaseAmortPlanInstallments ?? [],
                    version: result?.updatedRow?.CreditCaseAmortPlanVersion ?? {},
                    creditCase: result?.updatedRow?.CreditCase ?? model?.CreditCase ?? {}
                });
            })
            .catch(function(error) {
                console.error(error);
                notify?.error?.("Save failed");
            })
            .finally(function() {
                ds.entity.setSavingState(false);
            });
    };

    if (typeof window.onLoanCaseStatusChanged === "function") {
        window.onLoanCaseStatusChanged(document.getElementById("StatusCode")?.ej2_instances?.[0]?.value || "@(Model?.CreditCase?.CreditStatusCode ?? string.Empty)");
    }
</script>

<ejs-scripts></ejs-scripts>
