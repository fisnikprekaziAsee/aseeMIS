@model dsCredit.Core.ViewModels.CreditCaseLoanViewModel

@using aseeMIS.Areas.Common.ViewModels
@using dsLoanEngine.Core.Enums

@{
    var request = ViewData["EntityDetailRequest"] as aseeMIS.Areas.Common.DTOs.EntityDetailRequest;
    var loanFormSessionId = request?.FormSessionId ?? ViewBag.FormSessionId ?? "";
    var formId = request?.FormId ?? ViewBag.FormId;
    bool isAdd = request?.IsAdd ?? ViewBag.IsAdd ?? true;
    var isGridDialog = request?.IsGridDialog ?? false;
    var isFromCreditHub = ViewBag.IsFromCreditHub as bool? ?? false;
    var formDomId = "entityForm_" + loanFormSessionId;

    var bankPartySearchId = "LoanBankPartySearch_" + loanFormSessionId;
    var bankPartySearchUrl = Url.Action("Search", "BankParty", new { area = "BankParty" }) ?? "/BankParty/BankParty/Search";
    var loanProductsUrl = Url.Action("GetProductsForBankParty", "CreditCaseLoan", new { area = "Credit" })
        ?? "/Credit/CreditCaseLoan/GetProductsForBankParty";
    var amortTemplateDefaultsUrl = Url.Action("GetTemplateDefaults", "AmortPlan", new { area = "Credit" })
        ?? "/Credit/AmortPlan/GetTemplateDefaults";
    var amortPreviewUrl = Url.Action("LoadCreditCaseAmortPlanPreview", "AmortPlan", new { area = "Credit" })
        ?? "/Credit/AmortPlan/LoadCreditCaseAmortPlanPreview";

    var products = ViewData["FK_ProductCode"] ?? Enumerable.Empty<object>();
    var loanPurposes = ViewData["FK_CreditPurposeCode"] ?? Enumerable.Empty<object>();
    var caseStatuses = ViewData["FK_StatusCode"] ?? Enumerable.Empty<object>();
    var caseWorkflowSteps = ViewData["CaseWorkflowSteps"] ?? Enumerable.Empty<object>();
    var disbursementBanks = ViewData["FK_DisbursementBankCode"] ?? Enumerable.Empty<object>();
    var amortTemplates = ViewData["FK_AmortizationTemplateCode"] ?? Enumerable.Empty<object>();
    var otherIncomeTypes = ViewData["FK_OtherIncomeTypeId"] ?? Enumerable.Empty<object>();
    var amortPlanVersion = Model?.CreditCaseAmortPlanVersion ?? new dsCredit.Core.ViewModels.CreditCaseAmortPlanVersionViewModel
    {
        PrincipalCalculationMethodCode = "Annuity",
        DueDayPolicyCode = "FixedDayOfMonth",
        FixedDayOfMonth = 28,
        DayCountCalculationTypeCode = "ActualActual_365_366",
        GraceTypeCode = "None",
        AccrueInterestDuringFullGrace = true,
        UseIndexedRate = false,
        IndexCode = "EURIBOR_3M"
    };
    var amortFirstDueDate = ToDatePickerValue(Model?.FirstInstallmentDate ?? amortPlanVersion.FirstDueDate);
    var amortFirstDueDateIso = amortFirstDueDate?.ToString("yyyy-MM-dd");
    var amortPreviewInstallments = Model?.CreditCaseAmortPlanInstallments?
        .OrderBy(x => x.InstallmentNumber)
        .ToList() ?? new List<dsCredit.Core.ViewModels.CreditCaseAmortPlanInstallmentViewModel>();
    var hasAmortPreview = amortPreviewInstallments.Count > 0;
    var amortPreviewModel = new aseeMIS.Areas.Credit.ViewModels.CreditCaseAmortPlanPreviewViewModel
    {
        CreditCaseId = Model?.CreditCase?.CreditCaseId ?? 0,
        CaseNumber = Model?.CreditCase?.CaseNumber,
        ProductCode = Model?.CreditCase?.ProductCode,
        ProductName = Model?.CreditCase?.ProductName,
        CurrencyCode = Model?.CreditCase?.CurrencyCode,
        CreditStatusCode = Model?.CreditCase?.CreditStatusCode,
        StageCode = Model?.CreditCase?.StageCode,
        ApprovedEir = Model?.CreditCase?.EffectiveInterestRateApproved,
        Version = Model?.CreditCaseAmortPlanVersion,
        Installments = amortPreviewInstallments
    };

    DateTime? ToDatePickerValue(DateOnly? value)
        => value.HasValue && value.Value != default
            ? value.Value.ToDateTime(TimeOnly.MinValue)
            : null;

    var requestedStartDate = ToDatePickerValue(Model?.CreditCase?.StartDateRequested);
    var requestedMaturityDate = ToDatePickerValue(Model?.CreditCase?.MaturityDateRequested);
    var approvedStartDate = ToDatePickerValue(Model?.CreditCase?.StartDateApproved);
    var approvedMaturityDate = ToDatePickerValue(Model?.CreditCase?.MaturityDateApproved);
    var requestedStartDateIso = requestedStartDate?.ToString("yyyy-MM-dd");
    var requestedMaturityDateIso = requestedMaturityDate?.ToString("yyyy-MM-dd");
    var approvedStartDateIso = Model?.CreditCase?.StartDateApproved?.ToString("yyyy-MM-dd");
    var approvedMaturityDateIso = Model?.CreditCase?.MaturityDateApproved?.ToString("yyyy-MM-dd");
    int? requestedTermMonths = null;
    if (Model?.CreditCase?.StartDateRequested is { } requestedFrom &&
        requestedFrom != default &&
        Model.CreditCase.MaturityDateRequested is { } requestedTo &&
        requestedTo != default)
    {
        requestedTermMonths = ((requestedTo.Year - requestedFrom.Year) * 12) +
                              requestedTo.Month - requestedFrom.Month;
        if (requestedTo.Day > requestedFrom.Day)
            requestedTermMonths++;
        requestedTermMonths = Math.Max(1, requestedTermMonths.Value);
    }

    int? approvedTermMonths = null;
    if (Model?.CreditCase?.StartDateApproved is { } approvedFrom &&
        approvedFrom != default &&
        Model.CreditCase.MaturityDateApproved is { } approvedTo &&
        approvedTo != default)
    {
        approvedTermMonths = ((approvedTo.Year - approvedFrom.Year) * 12) +
                             approvedTo.Month - approvedFrom.Month;
        if (approvedTo.Day > approvedFrom.Day)
            approvedTermMonths++;
        approvedTermMonths = Math.Max(1, approvedTermMonths.Value);
    }
}

<style>
    .loan-amort-settings-section + .loan-amort-settings-section {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid #e9ecef;
    }

    .loan-amort-settings-section-title {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #6c757d;
        margin-bottom: 0.75rem;
    }

    .loan-amort-preview-thead th {
        background: #3f6f94;
        color: #fff;
        white-space: nowrap;
    }

    .loan-amort-preview-empty {
        border: 1px dashed #ced4da;
        border-radius: 0.5rem;
        padding: 1.25rem;
        color: #6c757d;
        background: #f8f9fa;
    }

    .loan-amort-collapsible-header {
        cursor: pointer;
        user-select: none;
    }

        .loan-amort-collapsible-header .loan-amort-collapse-icon {
            transition: transform 0.2s ease;
            color: #6c757d;
        }

        .loan-amort-collapsible-header.collapsed .loan-amort-collapse-icon {
            transform: rotate(-90deg);
        }

        .loan-amort-collapsible-header[aria-expanded="false"] .loan-amort-collapse-icon {
            transform: rotate(-90deg);
        }

    .loan-amort-card-meta {
        font-size: 0.8125rem;
        color: #6c757d;
    }

    .loan-amort-summary-table {
        width: 100%;
        font-size: 0.875rem;
        border-collapse: collapse;
    }

        .loan-amort-summary-table td {
            padding: 0.12rem 0.5rem 0.12rem 0;
            vertical-align: top;
            font-weight: 400;
        }

        .loan-amort-summary-table .loan-amort-summary-label {
            width: 15rem;
            color: #212529;
        }

        .loan-amort-summary-table .loan-amort-summary-value {
            white-space: nowrap;
            text-align: left !important;
        }

    .loan-amort-preview-table .loan-amort-col-days {
        width: 3.25rem;
        max-width: 3.25rem;
        text-align: center;
        white-space: nowrap;
        padding-left: 0.35rem;
        padding-right: 0.35rem;
    }

    .loan-amort-preview-table .loan-amort-col-num {
        width: 2.5rem;
        text-align: center;
    }
</style>

<form id="@formDomId" onsubmit="return false;" novalidate>
    <div class="form-container"
         data-form-session-id="@loanFormSessionId"
         data-form-id="@formId"
         data-primary-key="CreditCaseId">

        <div class="d-none">
            <input type="hidden" id="BankPartyId" value="@Model?.CreditCase?.BankPartyId" />
            <input type="hidden" id="IsIndividual" value="@((Model?.CreditCase?.IsIndividual ?? false).ToString().ToLowerInvariant())" />
            <input type="hidden" id="WorkflowId" value="@Model?.CreditCase?.WorkflowId" />
            <input type="hidden" id="FrameworkId" value="@Model?.CreditCase?.FrameworkId" />
            <input type="hidden" id="CurrencyCode" value="@(Model?.CreditCase?.CurrencyCode ?? "EUR")" />
            <input type="hidden" id="StageCode" value="@(Model?.CreditCase?.StageCode ?? "A0")" />
            <input type="hidden" id="LoanCaseStatusEndpoint" value="@Url.Action("GetNextCaseStatusesForDropdown", "CreditCaseLoan", new { area = "Credit" })" />
            <input type="hidden" id="CreditApplicationId" value="@(Model?.CreditCase?.CreditApplicationId)" />
            <input type="hidden" id="CurrentStatusCode" value="@(Model?.CreditCase?.CreditStatusCode ?? string.Empty)" />
            <input type="hidden" id="LastUpdatedUserId" value="@(Model?.CreditCase?.LastUpdatedUserId ?? -1)" />
            <input type="hidden" id="ConcurrencyStamp" value="@(Model?.CreditCase?.ConcurrencyStamp ?? string.Empty)" />
            <input type="hidden" id="RequestedDisbursementFeeMinimumAmount" value="@Model?.RequestedDisbursementFeeMinimumAmount" />
            <input type="hidden" id="ApprovedDisbursementFeeMinimumAmount" value="@Model?.ApprovedDisbursementFeeMinimumAmount" />
            <input type="hidden" id="IsWorkflowStepEditable" value="@((Model?.IsWorkflowStepEditable ?? true).ToString().ToLowerInvariant())" />
            <input type="hidden" id="ProductTypeCode" value="@Model?.CreditCase?.ProductTypeCode" />
        </div>

        @if (!isFromCreditHub)
        {
            <div class="row g-3 mb-3">
                <div class="col-12">
                    <section class="ds-card h-100">
                        <div class="ds-card-h d-flex align-items-center gap-2">
                            <i class="bi bi-person-search"></i>
                            <span class="ds-card-title">Zgjidh klientin</span>
                        </div>
                        <div class="ds-card-b">
                            @await Component.InvokeAsync("SearchAutocomplete", new SearchAutocompleteOptions
                            {
                                SearchUrl = bankPartySearchUrl,
                                Placeholder = "Shkruaj sÃ« paku 2 shkronja pÃ«r tÃ« kÃ«rkuar klientin...",
                                Id = bankPartySearchId,
                                MinLength = 2,
                                DebounceDelay = 300,
                                SuggestionCount = 15,
                                ValueField = "BankPartyId",
                                TextField = "DisplayText",
                                FilteringFn = "filter_CreditCaseLoanBankParty",
                                OnSelectFn = "select_CreditCaseLoanBankParty"
                            })
                        </div>
                    </section>
                </div>
            </div>
        }
        <!-- RRESHTI I PARE: Case Info, Requested Terms, Approved Terms -->
        <div class="row g-3">

            <!-- 1. Case Info (col-xl-4 ne ekran te madh) -->
            <div class="col-12 col-xl-4">
                <div class="ds-card mb-3">
                    <div class="ds-card-h d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle"></i>
                        <span class="ds-card-title">Case Info</span>
                    </div>

                    <div class="ds-card-b">
                        <div class="row g-2">
                            <div class="col-4">
                                <ejs-numerictextbox ejs-for="CreditCase.CreditCaseId"
                                                    id="CreditCaseId"
                                                    placeholder="Case Id"
                                                    enabled="false"
                                                    decimals="0"
                                                    format="N0"
                                                    showSpinButton="false"
                                                    floatLabelType="Always" />
                            </div>

                            <div class="col-8">
                                <ejs-textbox ejs-for="CreditCase.CaseNumber"
                                             id="CaseNumber"
                                             placeholder="Case Number"
                                             enabled="false"
                                             floatLabelType="Always" />
                            </div>

                            <div class="col-12 ds-required-empty">
                                <ejs-dropdownlist ejs-for="CreditCase.ProductCode"
                                                  id="ProductCode"
                                                  dataSource="@products"
                                                  placeholder="Product"
                                                  change="onProductChange"
                                                  required="true"
                                                  floatLabelType="Always">
                                    <e-dropdownlist-fields text="ProductName" value="ProductCode"></e-dropdownlist-fields>
                                </ejs-dropdownlist>
                                <div id="LoanProductLimitsHint" class="small text-muted mt-1"></div>
                            </div>

                            <div class="col-12 ds-required-empty">
                                <ejs-dropdownlist ejs-for="CreditCase.CreditPurposeCode"
                                                  id="CreditPurposeCode"
                                                  dataSource="@loanPurposes"
                                                  placeholder="Loan Purpose"
                                                  required="true"
                                                  floatLabelType="Always">
                                    <e-dropdownlist-fields text="CreditPurposeName" value="CreditPurposeCode"></e-dropdownlist-fields>
                                </ejs-dropdownlist>
                            </div>

                            <div class="col-12 ds-required-empty" id="priceListContainer">
                                <ejs-dropdownlist ejs-for="CreditCase.PriceListId"
                                                  id="PriceListId"
                                                  placeholder="Select Price List"
                                                  change="onPriceListChange"
                                                  required="true"
                                                  floatLabelType="Always">
                                    <e-dropdownlist-fields text="PriceListName" value="PriceListId"></e-dropdownlist-fields>
                                </ejs-dropdownlist>
                            </div>

                            <div class="col-12">
                                <ejs-textbox ejs-for="CreditCase.CaseDescription"
                                             id="CaseDescription"
                                             placeholder="Case Description"
                                             multiline="true"
                                             floatLabelType="Always" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Requested Terms & Approved Terms (Kombinuar ne hapesiren e mbetur ne rreshtin e pare) -->
            <div class="col-12 col-xl-8">
                <div class="row g-3 h-100">

                    <!-- Requested Terms (col-lg-6) -->
                    <div class="col-lg-6">
                        <div class="ds-card h-100">
                            <div class="ds-card-h d-flex align-items-center gap-2">
                                <i class="bi bi-pencil"></i>
                                <span class="ds-card-title">Requested Terms</span>
                            </div>

                            <div class="ds-card-b">
                                <div class="row g-2">
                                    <div class="col-6 ds-required-empty">
                                        <ejs-datepicker id="RequestedStartDate"
                                                        value="@requestedStartDate"
                                                        placeholder="Start Date"
                                                        change="onRequestedStartDateChange"
                                                        required="true"
                                                        format="dd/MM/yyyy"
                                                        enableMask="false"
                                                        data-dateonly="true"
                                                        floatLabelType="Always" />
                                    </div>
                                    <div class="col-6 ds-required-empty">
                                        <ejs-datepicker id="RequestedFirstInstallmentDate"
                                                        value="@amortFirstDueDate"
                                                        placeholder="First Installment Date"
                                                        change="onRequestedFirstInstallmentDateChange"
                                                        required="true"
                                                        format="dd/MM/yyyy"
                                                        enableMask="false"
                                                        data-dateonly="true"
                                                        floatLabelType="Always" />
                                    </div>

                                    <div class="col-3 ds-required-empty">
                                        <ejs-numerictextbox id="TermMonths"
                                                            value="@requestedTermMonths"
                                                            placeholder="Months"
                                                            change="calculateLoanEndDate"
                                                            floatLabelType="Always"
                                                            showSpinButton="false"
                                                            decimals="0"
                                                            format="N0"
                                                            min="1"
                                                            max="240"
                                                            validateDecimalOnType="true"
                                                            required="true"></ejs-numerictextbox>
                                        <div id="TermMonthsProductError" class="small text-danger mt-1 d-none"></div>
                                    </div>

                                    <div class="col-3 ds-required-empty">
                                        <ejs-numerictextbox ejs-for="RequestedGracePeriod"
                                                            id="RequestedGracePeriod"
                                                            placeholder="Grace Period (Months)"
                                                            change="onRequestedGracePeriodChange"
                                                            format="n0"
                                                            min="0"
                                                            required="true"
                                                            showSpinButton="false"
                                                            floatLabelType="Always" />
                                    </div>

                                    <div class="col-6 ds-required-empty">
                                        <ejs-datepicker id="RequestedMaturityDate"
                                                        value="@requestedMaturityDate"
                                                        placeholder="Maturity Date"
                                                        change="onRequestedMaturityDateChange"
                                                        required="true"
                                                        format="dd/MM/yyyy"
                                                        enableMask="false"
                                                        data-dateonly="true"
                                                        floatLabelType="Always" />
                                    </div>

                                    <div class="col-12 ds-required-empty">
                                        <ejs-numerictextbox ejs-for="CreditCase.CreditAmountRequested"
                                                            id="RequestedCreditAmount"
                                                            placeholder="Credit Amount"
                                                            format="n2" showSpinButton="false" min="0" required="true"
                                                            change="onAmountChange"
                                                            floatLabelType="Always" />
                                        <div id="RequestedCreditAmountProductError" class="small text-danger mt-1 d-none"></div>
                                    </div>

                                    <div class="col-6 ds-required-empty">
                                        <ejs-numerictextbox ejs-for="CreditCase.InterestRateRequested"
                                                            id="RequestedInterestRate"
                                                            placeholder="Interest Rate (%)"
                                                            format="n2" showSpinButton="false" min="0" required="true"
                                                            enabled="false"
                                                            floatLabelType="Always" />
                                    </div>

                                    <div class="col-6 ds-required-empty">
                                        <ejs-numerictextbox ejs-for="CreditCase.EffectiveInterestRateRequested"
                                                            id="RequestedEffectiveInterestRate"
                                                            placeholder="Effective Interest Rate (%)"
                                                            format="n4"
                                                            min="0"
                                                            required="true"
                                                            showSpinButton="false"
                                                            enabled="false"
                                                            floatLabelType="Always" />
                                    </div>

                                    <div class="col-6 ds-required-empty">
                                        <ejs-numerictextbox ejs-for="CreditCase.PricingChargeRateRequested"
                                                            id="RequestedChargeRate"
                                                            placeholder="Charge Rate (%)"
                                                            format="n2" showSpinButton="false" min="0" required="true"
                                                            enabled="false"
                                                            floatLabelType="Always" />
                                    </div>

                                    <div class="col-6 ds-required-empty">
                                        <ejs-numerictextbox ejs-for="CreditCase.PricingChargeAmountRequested"
                                                            id="RequestedChargeAmount"
                                                            placeholder="Charge Amount"
                                                            format="n2" showSpinButton="false" min="0" required="true"
                                                            enabled="false"
                                                            floatLabelType="Always" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Approved Terms (col-lg-6) -->
                    <div class="col-lg-6">
                        <div class="ds-card h-100">
                            <div class="ds-card-h d-flex align-items-center gap-2">
                                <i class="bi bi-check2-circle"></i>
                                <span class="ds-card-title">Approved Terms</span>
                            </div>

                            <div class="ds-card-b">
                                <div class="row g-2">
                                    <div class="col-6 ds-required-empty">
                                        <ejs-datepicker id="ApprovedStartDate"
                                                        value="@approvedStartDate"
                                                        placeholder="Start Date"
                                                        change="onApprovedStartDateChange"
                                                        required="true"
                                                        enabled="false"
                                                        format="dd/MM/yyyy"
                                                        enableMask="false"
                                                        data-dateonly="true"
                                                        floatLabelType="Always" />
                                    </div>

                                    <div class="col-6 ds-required-empty">
                                        <ejs-datepicker id="ApprovedFirstInstallmentDate"
                                                        value="@amortFirstDueDate"
                                                        placeholder="First Installment Date"
                                                        change="onApprovedFirstInstallmentDateChange"
                                                        required="true"
                                                        enabled="false"
                                                        format="dd/MM/yyyy"
                                                        enableMask="false"
                                                        data-dateonly="true"
                                                        floatLabelType="Always" />
                                    </div>

                                    <div class="col-3 ds-required-empty">
                                        <ejs-numerictextbox id="ApprovedTermMonths"
                                                            value="@approvedTermMonths"
                                                            placeholder="Months"
                                                            change="calculateApprovedEndDate"
                                                            enabled="false"
                                                            showSpinButton="false"
                                                            decimals="0"
                                                            format="N0"
                                                            min="1"
                                                            required="true"
                                                            floatLabelType="Always" />
                                        <div id="ApprovedTermMonthsProductError" class="small text-danger mt-1 d-none"></div>
                                    </div>

                                    <div class="col-3 ds-required-empty">
                                        <ejs-numerictextbox ejs-for="ApprovedGracePeriod"
                                                            id="ApprovedGracePeriod"
                                                            value="@(Model?.ApprovedGracePeriod ?? 0)"
                                                            placeholder="Grace Period (Months)"
                                                            change="onApprovedGracePeriodChange"
                                                            format="n0"
                                                            min="0"
                                                            required="true"
                                                            showSpinButton="false"
                                                            enabled="false"
                                                            floatLabelType="Always" />
                                    </div>

                                    <div class="col-6 ds-required-empty">
                                        <ejs-datepicker id="ApprovedMaturityDate"
                                                        value="@approvedMaturityDate"
                                                        placeholder="Maturity Date"
                                                        change="onApprovedMaturityDateChange"
                                                        required="true"
                                                        enabled="false"
                                                        format="dd/MM/yyyy"
                                                        enableMask="false"
                                                        data-dateonly="true"
                                                        floatLabelType="Always" />
                                    </div>

                                    <div class="col-12 ds-required-empty">
                                        <ejs-numerictextbox ejs-for="CreditCase.CreditAmountApproved"
                                                            id="ApprovedCreditAmount"
                                                            placeholder="Credit Amount"
                                                            format="n2"
                                                            min="0"
                                                            required="true"
                                                            showSpinButton="false"
                                                            change="onApprovedAmountChange"
                                                            enabled="false"
                                                            floatLabelType="Always" />
                                        <div id="ApprovedCreditAmountProductError" class="small text-danger mt-1 d-none"></div>
                                    </div>

                                    <div class="col-6 ds-required-empty">
                                        <ejs-numerictextbox ejs-for="CreditCase.InterestRateApproved"
                                                            id="ApprovedInterestRate"
                                                            placeholder="Interest Rate (%)"
                                                            format="n4"
                                                            min="0"
                                                            required="true"
                                                            showSpinButton="false"
                                                            enabled="false"
                                                            floatLabelType="Always" />
                                    </div>

                                    <div class="col-6 ds-required-empty">
                                        <ejs-numerictextbox ejs-for="CreditCase.EffectiveInterestRateApproved"
                                                            id="ApprovedEffectiveInterestRate"
                                                            placeholder="Effective Interest Rate (%)"
                                                            format="n4"
                                                            min="0"
                                                            required="true"
                                                            showSpinButton="false"
                                                            enabled="false"
                                                            floatLabelType="Always" />
                                    </div>

                                    <div class="col-6 ds-required-empty">
                                        <ejs-numerictextbox ejs-for="CreditCase.PricingChargeRateApproved"
                                                            id="ApprovedChargeRate"
                                                            placeholder="Charge Rate (%)"
                                                            format="n4"
                                                            min="0"
                                                            required="true"
                                                            showSpinButton="false"
                                                            change="onApprovedChargeRateChange"
                                                            enabled="false"
                                                            floatLabelType="Always" />
                                    </div>

                                    <div class="col-6 ds-required-empty">
                                        <ejs-numerictextbox ejs-for="CreditCase.PricingChargeAmountApproved"
                                                            id="ApprovedChargeAmount"
                                                            placeholder="Charge Amount"
                                                            format="n2"
                                                            min="0"
                                                            required="true"
                                                            showSpinButton="false"
                                                            enabled="false"
                                                            floatLabelType="Always" />
                                    </div>

                                    <input type="hidden"
                                           id="ApprovedPenaltyInterest"
                                           value="@Model?.CreditCase?.PenatlyInterestApproved" />
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="ds-card mt-3">
            <div class="ds-card-h d-flex align-items-center gap-2">
                <i class="bi bi-cash-stack"></i>
                <span class="ds-card-title">Income and Monthly Obligations</span>
            </div>
            <div class="ds-card-b">
                <div class="row g-4">
                    <div class="@((Model?.CreditCase?.IsIndividual ?? false) ? "col-md-6" : "col-12")">
                        <div class="row g-2">
                            <div class="@((Model?.CreditCase?.IsIndividual ?? false) ? "col-md-6" : "col-md-3")">
                                <ejs-numerictextbox ejs-for="CreditCase.OtherBankMonthlyInstallments"
                                            id="OtherBankMonthlyInstallments"
                                            change="updateLoanIncomeRatios"
                                            placeholder="Other Bank Monthly Installments"
                                            format="n2"
                                            min="0"
                                            showSpinButton="false"
                                            floatLabelType="Always" />
                            </div>
                            @if (Model?.CreditCase?.IsIndividual ?? false)
                            {
                            <div class="col-md-6">
                                <ejs-numerictextbox ejs-for="CreditCase.SalaryIncome"
                                                id="SalaryIncome"
                                            change="updateLoanIncomeRatios"
                                                placeholder="Salary Income"
                                                format="n2"
                                                min="0"
                                                showSpinButton="false"
                                                floatLabelType="Always" />
                            </div>
                            <div class="col-md-6">
                                <ejs-dropdownlist ejs-for="CreditCase.OtherIncomeTypeId"
