@model dsAspNet.Core.ViewModels.AspNetRoleViewModel
@{
    var request = ViewData["EntityDetailRequest"] as aseeMIS.Areas.Common.DTOs.EntityDetailRequest
        ?? throw new InvalidOperationException("EntityDetailRequest is required.");
    bool isReadonly = request.IsAdd ? false : (Model.IsApproved == null);

    string statusText = request.IsApprovedText;
    string statusCss = Model.IsApproved == null ? "badge bg-warning text-dark"
                    : Model.IsApproved == true ? "badge bg-success"
                    : "badge bg-danger";

    var filteringFn = "filter_userSearch_" + request.FormSessionId;
    var selectFn = "select_userSearch_" + request.FormSessionId;

    // ✅ unique form id per instance (important if multiple widgets exist)
    var formDomId = "entityForm_" + request.FormSessionId;
}

<form id="@formDomId" onsubmit="return false;">
    <div class="form-container" data-form-session-id="@request.FormSessionId" data-form-id="@request.FormId">

        <div class="row g-3">
            <div class="col-md-2">
                <ejs-numerictextbox ejs-for="Id" id="Id" placeholder="Role Id" floatLabelType="Always"
                                    readonly="true" format="n0" decimals="0" step="1" showSpinButton="false"></ejs-numerictextbox>
            </div>

            <div class="col-md-10">
                <ejs-textbox ejs-for="Name" id="Name" placeholder="Role Name" floatLabelType="Always"
                             readonly="@isReadonly" required="required" minlength="3" maxlength="50"></ejs-textbox>
            </div>

            <ejs-textbox ejs-for="ConcurrencyStamp"
                         id="ConcurrencyStamp"
                         type="Hidden">
            </ejs-textbox>

            @if (request.IsAdd)
            {
                <div class="col-12">
                    <div class="ds-card">
                        <div class="ds-card-h d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-people"></i>
                                <span class="ds-card-title">Users</span>
                                <span class="ds-card-sub">Add / remove users for this role</span>
                            </div>

                            <span class="badge text-bg-light">
                                Selected: <span id="selectedCount">0</span>
                            </span>
                        </div>

                        <div class="ds-card-b">
                            <div class="row g-3 align-items-start">
                                <div class="col-lg-3 col-md-4">
                                    <label class="ds-label">Add user</label>

                                    @await Component.InvokeAsync("SearchAutocomplete",
                                             new aseeMIS.Areas.Common.ViewModels.SearchAutocompleteOptions
                                {
                                    SearchUrl = Url.Action("Search", "User", new { area = "AspNet" }),
                                    Id = "userSearch",
                                    Placeholder = "type min 3 char...",
                                    MinLength = 3,
                                    DebounceDelay = 3000,
                                    SuggestionCount = 10,
                                    ValueField = "UserId",
                                    TextField = "FullName",
                                    FilteringFn = filteringFn,
                                    OnSelectFn = selectFn
                                })

                                    <div class="ds-hint mt-2">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Type 3+ letters and pick from the list
                                    </div>
                                </div>

                                <div class="col-lg-1 d-none d-lg-block">
                                    <div class="ds-vline"></div>
                                </div>

                                <div class="col-lg-8 col-md-8">
                                    <label class="ds-label">Selected users</label>
                                    <div id="userChips" class="ds-chip-wrap"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-none">
                    <ejs-textbox ejs-for="MentionedUserIds" id="MentionedUserIds" floatLabelType="Never"></ejs-textbox>
                </div>
            }
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="d-flex align-items-center">
                <span id="statusBadge" class="@statusCss">@statusText</span>
            </div>

            <button type="button"
                    id="btnSave"
                    class="@(isReadonly ? "btn btn-secondary" : "btn btn-primary")"
                    onclick="preSave()" @(isReadonly ? "disabled" : "")>
                <i class="bi bi-save me-2"></i>Save
            </button>
        </div>
    </div>
</form>

<script>
    (function () {
        const readonly = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isReadonly));
        const selectFnName = "@selectFn";
        const selectedUsers = new Map();

        function renderChips() {
            const host = ds.byId("userChips");
            if (!host) return;

            host.innerHTML = "";
            for (const [id, u] of selectedUsers.entries()) {
                const chip = document.createElement("span");
                chip.className = "ds-chip";

                const label = document.createElement("span");
                label.textContent = u.FullName;
                chip.appendChild(label);

                if (!readonly) {
                    const x = document.createElement("span");
                    x.className = "x";
                    x.title = "Remove";
                    x.textContent = "×";
                    x.onclick = () => { selectedUsers.delete(id); renderChips(); };
                    chip.appendChild(x);
                }

                host.appendChild(chip);
            }

            const c = ds.byId("selectedCount");
            if (c) c.textContent = String(selectedUsers.size);
        }

        function syncMentionedUserIds() {
            const tb = ds.ej("MentionedUserIds");
            if (!tb) return;
            tb.value = Array.from(selectedUsers.keys()).join(",");
            tb.dataBind();
        }

        // ✅ unique preSave per instance
        window["preSave"] = function () {
            // 1) your extra sync
            syncMentionedUserIds();
            // 2) save via your existing ds.entity.save()
            ds.entity.save();
        };

        // AutoComplete select callback
        window[selectFnName] = function (args) {
            const data = args?.itemData;
            if (!data) return;

            const id = Number(data.UserId);
            const name = (data.FullName || "").toString();
            if (!id || !name) return;

            if (!selectedUsers.has(id)) {
                selectedUsers.set(id, { UserId: id, FullName: name });
                renderChips();
            }

            const ac = ds.ej("userSearch");
            setTimeout(() => {
                if (!ac) return;
                if (typeof ac.clear === "function") ac.clear();
                else {
                    ac.value = null;
                    ac.text = "";
                    if (ac.element) ac.element.value = "";
                    ac.dataBind();
                }
            }, 0);
        };

        document.addEventListener("DOMContentLoaded", function () {
            formLocalizationDataBound(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(request.Area)));
        });
    })();
</script>
