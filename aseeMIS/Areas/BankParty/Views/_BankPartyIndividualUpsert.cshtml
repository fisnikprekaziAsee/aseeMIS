@model dsBankParty.Core.ViewModels.BankPartyIndividualViewModel
@inject dsBankParty.Core.Services.Interfaces.IBankPartyUploadDocumentService bankPartyUploadDocumentService
@inject dsBankParty.Core.Services.Interfaces.IBankPartySignicatWebhookLogService signicatWebhookLogService
@inject dsMIS.Core.Services.Interfaces.IAppFormMenuService menuService
@inject dsMIS.Core.Services.Interfaces.IUserContextService userContextService
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using dsMIS.Core.Enums
@using aseeMIS.Areas.BankParty.Helpers
@using aseeMIS.Areas.Common.DTOs
@using System.Linq

@{
    var request = ViewData["EntityDetailRequest"] as aseeMIS.Areas.Common.DTOs.EntityDetailRequest
        ?? throw new InvalidOperationException("EntityDetailRequest is required.");

    var formSessionId = request.FormSessionId;
    var formId = request.FormId;
    var isAdd = request.IsAdd || (Model?.BankPartyId ?? 0) == 0;
    var isGridDialog = request.IsGridDialog;
    var gridName = request.GridName ?? "";

    var genders = ViewData["FK_GenderId"] as IEnumerable<object>;
    var countries = ViewData["FK_NationalityCountryCode"] as IEnumerable<object>;
    var municipalities = ViewData["FK_ContactMunicipalityId"] as IEnumerable<object>
        ?? ViewData["FK_BirthMunicipalityId"] as IEnumerable<object>;
    var contactCountries = ViewData["FK_ContactCountryCode"] as IEnumerable<object> ?? countries;
    var contactMunicipalities = ViewData["FK_ContactMunicipalityId"] as IEnumerable<object> ?? municipalities;
    var secondCitizenships = ViewData["FK_SecondCitizenshipCode"] as IEnumerable<object> ?? countries;
    var partyTypes = ViewData["FK_PartyTypeId"] as IEnumerable<object>;
    var partySegments = ViewData["FK_PartySegmentId"] as IEnumerable<object>;
    var languages = ViewData["FK_LanguageCode"] as IEnumerable<object>;
    var branches = ViewData["FK_ActualBranchId"] as IEnumerable<object>;
    var advisors = ViewData["FK_ActualAdvisorEmployeeId"] as IEnumerable<object>;
    var accountOfficers = ViewData["FK_ActualAccountOfficerEmployeeId"] as IEnumerable<object> ?? advisors;
    var documentTypeCode = ViewData["FK_DocumentTypeCode"] as IEnumerable<object>;

    var formDomId = "entityForm_" + request.FormSessionId;

    string PhoneNumberLocalValue(string? value, bool isResident)
    {
        var phone = new string((value ?? string.Empty).Where(char.IsDigit).ToArray());

        if (isResident)
        {
            if (phone.StartsWith("383", System.StringComparison.Ordinal))
                phone = phone[3..];

            while (phone.StartsWith("0", System.StringComparison.Ordinal))
                phone = phone[1..];

            return phone.Length > 8 ? phone[..8] : phone;
        }

        return phone.TrimStart('0');
    }

    var personIconTemplate = DsInputTemplates.PersonIcon();
    var fullNameCopyTemplate = DsInputTemplates.CopyCombinedToClipboard(new[] { "FirstName", "LastName" }, title: "Copy full name");
    var phonePrefixTemplate = DsInputTemplates.EditablePhonePrefix("PhonePrefixBadge", "PhonePrefixInput");
    var phoneCopyTemplate = DsInputTemplates.CopyPhoneToClipboard("PhoneNumberLocal", "PhonePrefixInput", title: "Copy phone");
    var emailIconTemplate = DsInputTemplates.EmailIcon();
    var viberPrefixTemplate = DsInputTemplates.EditablePhonePrefix("ViberPrefixBadge", "ViberPrefixInput", iconCss: "bi bi-chat-dots", title: "Viber prefix");
    var whatsAppPrefixTemplate = DsInputTemplates.EditablePhonePrefix("WhatsAppPrefixBadge", "WhatsAppPrefixInput", iconCss: "bi bi-whatsapp", title: "WhatsApp prefix");
    var viberCopyTemplate = DsInputTemplates.CopyPhoneFrom("ContactViber", "PhoneNumberLocal", "ViberPrefixInput", "PhonePrefixInput", title: "Copy phone");
    var whatsAppCopyTemplate = DsInputTemplates.CopyPhoneFrom("ContactWhatsApp", "PhoneNumberLocal", "WhatsAppPrefixInput", "PhonePrefixInput", title: "Copy phone");
    var emailAtTemplate = DsInputTemplates.EmailDomain("@");
}


<form id="@formDomId" onsubmit="return false;">
    <div class="form-container" data-form-session-id="@formSessionId" data-form-id="@formId" data-primary-key="BankPartyId">
        <ejs-numerictextbox ejs-for="BankPartyId" id="BankPartyId" type="hidden"></ejs-numerictextbox>
        <ejs-textbox ejs-for="BankParty.PartyCode" id="PartyCode" type="hidden"></ejs-textbox>
        <ejs-textbox ejs-for="BankParty.FullName" id="FullName" type="hidden"></ejs-textbox>
        <ejs-textbox ejs-for="BankParty.PhoneNumber" id="PhoneNumber" type="hidden"></ejs-textbox>
        <input type="hidden" id="IsWalkIn" value="@((Model?.BankParty?.IsWalkIn ?? false).ToString().ToLowerInvariant())" />
        @* RRESHTI I PARË: Identity dhe Të dhënat e lindjes *@
        <div class="row g-3 mb-2">
            <!-- Identity Card (9 kolonë) -->
            <div class="col-12 col-xl-9">
                <div class="ds-card h-100">
                    <div class="ds-card-h d-flex align-items-center gap-2" style="border-bottom-color: var(--ds-blue);">
                        <i class="bi bi-person-badge" style="color: var(--ds-blue);"></i>
                        <span class="ds-card-title">Identity</span>
                        @if (!isAdd)
                        {
                            <div class="d-flex align-items-center gap-4 ms-auto">
                                <!-- Party Code -->
                                <div class="d-flex align-items-center gap-1">
                                    <i class="bi bi-hash text-muted"></i>
                                    <span class="text-muted small">Code:</span>
                                    <span class="fw-semibold">@(Model?.BankParty?.PartyCode)</span>
                                </div>

                                <!-- E-Banking ID -->
                                <div class="d-flex align-items-center gap-1">
                                    <i class="bi bi-phone text-muted"></i>
                                    <span class="text-muted small">E-Banking ID:</span>
                                    <span class="fw-semibold">@(Model?.BankParty?.PartyEbankingId?.ToString() ?? "-")</span>
                                </div>

                                <!-- External Reference -->
                                <div class="d-flex align-items-center gap-1">
                                    <i class="bi bi-link-45deg text-muted"></i>
                                    <span class="text-muted small">External Ref:</span>
                                    <span class="fw-semibold">@(Model?.BankParty?.PartyExternalReference ?? "-")</span>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="ds-card-b">
                        @* Row 1 *@
                        <div class="row g-3 mb-3 align-items-end">
                            <div class="col-md-6 col-xl-2">
                                <div class="form-check form-switch pt-2">
                                    <input class="form-check-input" type="checkbox" asp-for="BankParty.IsResident" id="IsResident">
                                    <label class="form-check-label fw-semibold" for="IsResident">Resident</label>
                                </div>
                            </div>
                            <div class="col-md-6 col-xl-4 ds-required-empty">
                                <ejs-dropdownlist ejs-for="BankParty.StatusCode" id="StatusCode" placeholder="Party Status" floatLabelType="Always" required="true">
                                    <e-dropdownlist-fields text="StatusName" value="StatusCode"></e-dropdownlist-fields>
                                </ejs-dropdownlist>
                            </div>
                            <div class="col-md-6 col-xl-3 ds-required-empty">
                                <ejs-dropdownlist ejs-for="BankParty.PartyTypeId" id="PartyTypeId" dataSource="@(partyTypes)" placeholder="Party Type" floatLabelType="Always" required="true">
                                    <e-dropdownlist-fields text="PartyTypeName" value="PartyTypeId"></e-dropdownlist-fields>
                                </ejs-dropdownlist>
                            </div>
                            <div class="col-md-6 col-xl-3 ds-required-empty">
                                <ejs-dropdownlist ejs-for="BankParty.PartySegmentId" id="PartySegmentId" dataSource="@(partySegments)" placeholder="Party Segment" floatLabelType="Always" required="true">
                                    <e-dropdownlist-fields text="SegmentName" value="PartySegmentId"></e-dropdownlist-fields>
                                </ejs-dropdownlist>
                            </div>
                        </div>

                        @* Row 2 *@
                        <div class="row g-3 mb-3">
                            <div class="col-md-4 ds-required-empty">
                                <ejs-textbox ejs-for="FirstName" id="FirstName" placeholder="First Name" floatLabelType="Always" maxlength="200" required="true" prependTemplate="@personIconTemplate"></ejs-textbox>
                            </div>
                            <div class="col-md-4 ds-required-empty">
                                <ejs-textbox ejs-for="LastName" id="LastName" placeholder="Last Name" floatLabelType="Always" maxlength="200" required="true" prependTemplate="@personIconTemplate" appendTemplate="@fullNameCopyTemplate"></ejs-textbox>
                            </div>
                            <div class="col-md-4 ">
                                <ejs-textbox ejs-for="ParentName" id="ParentName" placeholder="Parent Name" floatLabelType="Always" maxlength="200" prependTemplate="@personIconTemplate"></ejs-textbox>
                            </div>
                        </div>

                        @* Row 3 *@
                        <div class="row g-3">
                            <div class="col-md-4  ds-required-empty">
                                <ejs-dropdownlist ejs-for="BankParty.NationalityCountryCode" id="NationalityCountryCode" dataSource="@(countries)" placeholder="Nationality Country Code" floatLabelType="Always" required="true" prependTemplate="@Html.Raw("<span class='e-input-group-icon'><i class='bi bi-globe'></i></span><span class='e-input-separator'></span>")">
                                    <e-dropdownlist-fields text="CountryName" value="CountryCode"></e-dropdownlist-fields>
                                </ejs-dropdownlist>
                            </div>
                            <div class="col-md-4  ds-required-empty">
                                <ejs-textbox ejs-for="BankParty.IdentificationNumber" id="IdentificationNumber" placeholder="Identification Number" floatLabelType="Always" maxlength="50" prependTemplate="@Html.Raw("<span class='e-input-group-icon'><i class='bi bi-credit-card'></i></span><span class='e-input-separator'></span>")"></ejs-textbox>
                            </div>
                            <div class="col-md-4">
                                <ejs-dropdownlist ejs-for="BankParty.SecondCitizenshipCode" id="SecondCitizenshipCode_Compliance" dataSource="@(secondCitizenships)" placeholder="Second Citizenship" floatLabelType="Always">
                                    <e-dropdownlist-fields text="CountryName" value="CountryCode"></e-dropdownlist-fields>
                                </ejs-dropdownlist>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Të dhënat e lindjes Card (3 kolonë) -->
            <div class="col-12 col-lg-4 col-xl-3">
                <div class="ds-card h-100">
                    <div class="ds-card-h d-flex align-items-center gap-2" style="border-bottom-color: var(--ds-violet);">
                        <i class="bi bi-calendar-event" style="color: var(--ds-violet);"></i>
                        <span class="ds-card-title">Të dhënat e lindjes</span>
                    </div>
                    <div class="ds-card-b">
                        <div class="row g-3">
                            <div class="col-sm-6 col-lg-12 col-xl-6 ds-required-empty">
                                <ejs-dropdownlist ejs-for="GenderId" id="GenderId" dataSource="@(genders)" placeholder="Gender" floatLabelType="Always" required="true" prependTemplate="@Html.Raw("<span class='e-input-group-icon'><i class='bi bi-gender-ambiguous'></i></span><span class='e-input-separator'></span>")">
                                    <e-dropdownlist-fields text="GenderName" value="GenderId"></e-dropdownlist-fields>
                                </ejs-dropdownlist>
                            </div>
                            <div class="col-sm-6 col-lg-12 col-xl-6 ds-required-empty">
                                <ejs-datepicker ejs-for="DateOfBirth" id="DateOfBirth" format="dd-MM-yyyy" valueFormat="yyyy-MM-dd" data-dateonly="true" enableMask="true" placeholder="Date Of Birth" floatLabelType="Always" required="true"></ejs-datepicker>
                            </div>
                            <div class="col-md-6 ds-required-empty">
                                <ejs-dropdownlist ejs-for="BirthCountryCode" id="BirthCountryCode" dataSource="@(countries)" placeholder="Birth Country" floatLabelType="Always" required="true">
                                    <e-dropdownlist-fields text="CountryName" value="CountryCode"></e-dropdownlist-fields>
                                </ejs-dropdownlist>
                            </div>
                            <div class="col-md-6 ds-required-empty" id="BirthMunicipalityIdWrapper">
                                <ejs-dropdownlist ejs-for="BirthMunicipalityId" id="BirthMunicipalityId" dataSource="@(municipalities)" placeholder="Birth Municipality" floatLabelType="Always" allowFiltering="true">
                                    <e-dropdownlist-fields text="MunicipalityName" value="MunicipalityId"></e-dropdownlist-fields>
                                </ejs-dropdownlist>
                            </div>
                            <div class="col-12 ds-required-empty" id="BirthMunicipalityNameWrapper">
                                <ejs-textbox ejs-for="BirthMunicipalityName" id="BirthMunicipalityName" placeholder="Birth Municipality Place" floatLabelType="Always" maxlength="250" required="true"></ejs-textbox>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Contact Details Card (Bëhet col-md-6 për t'i dhënë hapësirë rehat për Viber/WhatsApp) -->
            <div class="col-12 col-lg-8 col-xl-6">
                <div class="ds-card h-100">
                    <div class="ds-card-h d-flex align-items-center gap-2" style="border-bottom-color: var(--ds-green);">
                        <i class="bi bi-telephone" style="color: var(--ds-green);"></i>
                        <span class="ds-card-title">Contact Details</span>
                    </div>
                    <div class="ds-card-b">
                        <div class="row g-3">
                            <div class="col-12 ds-required-empty">
                                <ejs-dropdownlist ejs-for="BankParty.ContactCountryCode" id="ContactCountryCode" dataSource="@(contactCountries)" placeholder="Country" floatLabelType="Always" required="true">
                                    <e-dropdownlist-fields text="CountryName" value="CountryCode"></e-dropdownlist-fields>
                                </ejs-dropdownlist>
                            </div>
                            <div class="col-md-6 ds-required-empty">
                                <ejs-textbox id="PhoneNumberLocal" placeholder="Phone Number" floatLabelType="Always" value="@PhoneNumberLocalValue(Model?.BankParty?.PhoneNumber, Model?.BankParty?.IsResident ?? false)" maxlength="20" required="true" prependTemplate="@phonePrefixTemplate" appendTemplate="@phoneCopyTemplate"></ejs-textbox>
                            </div>
                            <div class="col-md-6  ds-required-empty">
                                <ejs-textbox ejs-for="BankParty.ContactEmail" id="ContactEmail" placeholder="Email" floatLabelType="Always" maxlength="100" cssClass="ds-email-input" prependTemplate="@emailIconTemplate" appendTemplate="@emailAtTemplate"></ejs-textbox>
                            </div>
                            <div class="col-md-6  ds-required-empty" id="ContactMunicipalityIdWrapper">
                                <ejs-dropdownlist ejs-for="BankParty.ContactMunicipalityId" id="ContactMunicipalityId" dataSource="@(contactMunicipalities)" placeholder="Municipality" floatLabelType="Always" allowFiltering="true" required="true">
                                    <e-dropdownlist-fields text="MunicipalityName" value="MunicipalityId"></e-dropdownlist-fields>
                                </ejs-dropdownlist>
                            </div>
                            <div class="col-md-6  ds-hidden" id="ContactMunicipalityNameWrapper">
                                <ejs-textbox ejs-for="BankParty.ContactMunicipalityName" id="ContactMunicipalityName" placeholder="Municipality" floatLabelType="Always" maxlength="250"></ejs-textbox>
                            </div>
                            <div class="col-md-6  ds-required-empty">
                                <ejs-textbox ejs-for="BankParty.ContactAddress" id="ContactAddress" placeholder="Address" floatLabelType="Always" maxlength="255" required="true" prependTemplate="@Html.Raw("<span class='e-input-group-icon'><i class='bi bi-house'></i></span><span class='e-input-separator'></span>")"></ejs-textbox>
                            </div>
                            <div class="col-md-6 ">
                                <ejs-textbox ejs-for="BankParty.ContactViber" id="ContactViber" placeholder="Viber" floatLabelType="Always" maxlength="20" prependTemplate="@viberPrefixTemplate" appendTemplate="@viberCopyTemplate"></ejs-textbox>
                            </div>
                            <div class="col-md-6 ">
                                <ejs-textbox ejs-for="BankParty.ContactWhatsApp" id="ContactWhatsApp" placeholder="WhatsApp" floatLabelType="Always" maxlength="20" prependTemplate="@whatsAppPrefixTemplate" appendTemplate="@whatsAppCopyTemplate"></ejs-textbox>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Document Card (col-md-3) -->
            <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                <div class="ds-card h-100">
                    <div class="ds-card-h d-flex align-items-center gap-2" style="border-bottom-color: var(--ds-brown);">
                        <i class="bi bi-file-earmark-text" style="color: var(--ds-brown);"></i>
                        <span class="ds-card-title">Document</span>
                    </div>
                    <div class="ds-card-b">
                        <div class="row g-3">
                            <div class="col-12">
                                <ejs-dropdownlist ejs-for="DocumentTypeCode" id="DocumentTypeCode" dataSource="@(documentTypeCode)" placeholder="Document Type" floatLabelType="Always">
                                    <e-dropdownlist-fields text="ConstantValue" value="ConstantKey"></e-dropdownlist-fields>
                                </ejs-dropdownlist>
                            </div>
                            <div class="col-12">
                                <ejs-textbox ejs-for="DocumentNumber" id="DocumentNumber" placeholder="Document Number" floatLabelType="Always" maxlength="50"></ejs-textbox>
                            </div>
                            <div class="col-12">
                                <ejs-textbox ejs-for="DocumentIssuer" id="DocumentIssuer" placeholder="Document Issuer" floatLabelType="Always" maxlength="100"></ejs-textbox>
                            </div>
                            <div class="col-6">
                                <ejs-datepicker ejs-for="DocumentIssueDate" id="DocumentIssueDate" format="dd-MM-yyyy" valueFormat="yyyy-MM-dd" enableMask="true" placeholder="Document Issue Date" floatLabelType="Always"></ejs-datepicker>
                            </div>
                            <div class="col-6">
                                <ejs-datepicker ejs-for="DocumentMaturityDate" id="DocumentMaturityDate" format="dd-MM-yyyy" valueFormat="yyyy-MM-dd" enableMask="true" placeholder="Document Maturity Date" floatLabelType="Always"></ejs-datepicker>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Client Management & Compliance (Së bashku te kolona col-md-3 e fundit) -->
            <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                <div class="ds-right-column h-100 d-flex flex-column gap-3">
                    <!-- Client Management Card -->
                    <div class="ds-card">
                        <div class="ds-card-h d-flex align-items-center gap-2" style="border-bottom-color: var(--ds-blue-dark);">
                            <i class="bi bi-person-gear" style="color: var(--ds-blue-dark);"></i>
                            <span class="ds-card-title">Client Management</span>
                        </div>
                        <div class="ds-card-b">
                            <div class="row g-3">
                                <div class="col-sm-6 col-md-12">
                                    <ejs-dropdownlist ejs-for="BankParty.ActualAdvisorEmployeeId" id="ActualAdvisorEmployeeId" dataSource="@(advisors)" placeholder="Advisor" floatLabelType="Always">
                                        <e-dropdownlist-fields text="FullName" value="EmployeeId"></e-dropdownlist-fields>
                                    </ejs-dropdownlist>
                                </div>
                                <div class="col-sm-6 col-md-12">
                                    <ejs-dropdownlist ejs-for="BankParty.ActualAccountOfficerEmployeeId" id="ActualAccountOfficerEmployeeId" dataSource="@(accountOfficers)" placeholder="Account Officer" floatLabelType="Always">
                                        <e-dropdownlist-fields text="FullName" value="EmployeeId"></e-dropdownlist-fields>
                                    </ejs-dropdownlist>
                                </div>
                                <div class="col-sm-6 col-md-12">
                                    <ejs-dropdownlist ejs-for="BankParty.ActualBranchId" id="ActualBranchId" dataSource="@(branches)" placeholder="Branch" floatLabelType="Always">
                                        <e-dropdownlist-fields text="BranchName" value="BranchId"></e-dropdownlist-fields>
                                    </ejs-dropdownlist>
                                </div>
                                <div class="col-sm-6 col-md-12 ds-required-empty">
                                    <ejs-dropdownlist ejs-for="BankParty.LanguageCode" id="LanguageCode" dataSource="@(languages)" placeholder="Language" floatLabelType="Always" required="true">
                                        <e-dropdownlist-fields text="LanguageName" value="LanguageCode"></e-dropdownlist-fields>
                                    </ejs-dropdownlist>
                                </div>
                            </div>
                        </div>
                    </div>

					
                </div>
            </div>
            <!-- Compliance Card -->
            <div class="col-12  col-lg-4 col-xl-12">
                <div class="ds-card h-100">
                    <div class="ds-card-h d-flex align-items-center gap-2" style="border-bottom-color: var(--ds-yellow-dark);">
                        <i class="bi bi-shield-check" style="color: var(--ds-yellow-dark);"></i>
                        <span class="ds-card-title">Compliance</span>
                    </div>
                    <div class="ds-card-b">

                        <div class="row g-3 align-items-center">
                            <div class="col-6 col-xl-1">
                                <div class="form-check form-switch pt-2 m-0">
                                    <input class="form-check-input" type="checkbox" asp-for="IsPEP" id="IsPEP" />
                                    <label class="form-check-label fw-semibold ms-2" for="IsPEP">PEP</label>
                                </div>
                            </div>
                            <div class="col-6 col-xl-1">
                                <div class="form-check form-switch pt-2 m-0">
                                    <input class="form-check-input" type="checkbox" asp-for="BankParty.IsFATCA" id="IsFATCA" />
                                    <label class="form-check-label fw-semibold ms-2" for="IsFATCA">FATCA</label>
                                </div>
                            </div>
                            <div class="col-6  col-xl-2 ds-required-empty">
                                <ejs-datepicker ejs-for="BankParty.RevisionDateLast" id="RevisionDateLast" format="dd-MM-yyyy" valueFormat="yyyy-MM-dd" enableMask="true" placeholder="Last Revision Date" floatLabelType="Always" required="true"></ejs-datepicker>
                            </div>
                            <div class="col-6  col-xl-2 ds-required-empty">
                                <ejs-datepicker ejs-for="BankParty.RevisionDateNext" id="RevisionDateNext" format="dd-MM-yyyy" valueFormat="yyyy-MM-dd" enableMask="true" placeholder="Next Revision Date" floatLabelType="Always" required="true"></ejs-datepicker>
                            </div>
                            <div class="col-12 col-xl-6">
                                <ejs-textarea ejs-for="BankParty.PartyDescription" id="PartyDescription" width="100%" rows="1" placeholder="Description" floatLabelType="Always" maxlength="255"></ejs-textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="d-flex justify-content-end">
                <button type="button" class="btn btn-primary" onclick="preSave()">
                    <i class="bi bi-save"></i>
                    @(isAdd ? "Create Individual" : "Save Changes")
                </button>
            </div>
        </div>
    </div>
</form>
        <div class="row g-3 mb-3">
            @if (!isAdd && (Model?.BankPartyId ?? 0) > 0)
            {
                var photoDocuments = await bankPartyUploadDocumentService.SelectPhotoDocumentsAsync(Model!.BankPartyId);
                var latestPhotos = photoDocuments
                    .GroupBy(d => d.UploadDocumentTypeId)
                    .ToDictionary(g => g.Key, g => g.OrderByDescending(d => d.UploadDocumentId).First());
                latestPhotos.TryGetValue(1, out var idFront);
                latestPhotos.TryGetValue(2, out var idBack);
                latestPhotos.TryGetValue(3, out var passport);
                latestPhotos.TryGetValue(4, out var signature);
                latestPhotos.TryGetValue(5, out var profile);
                latestPhotos.TryGetValue(6, out var proof);
                var usePassport = passport is not null && idFront is null && idBack is null;
                var photoDocType = (idFront is not null || idBack is not null)
                    ? "id"
                    : (passport is not null ? "passport" : "");
                var frontDoc = usePassport ? passport : idFront;

                var bpImageVm = new dsBankParty.Core.ViewModels.BankPartyImageViewModel
                {
                    BankPartyId = Model.BankPartyId,
                    IsIndividual = true,
                    ProfileImagePath = profile?.DocumentFilePath,
                    SignatureImagePath = signature?.DocumentFilePath,
                    DocumentFrontImagePath = frontDoc?.DocumentFilePath,
                    DocumentBackImagePath = idBack?.DocumentFilePath,
                    ProofOfAddressImagePath = proof?.DocumentFilePath
                };

                var photoDocsJson = System.Text.Json.JsonSerializer.Serialize(
                    photoDocuments
                        .GroupBy(d => d.UploadDocumentTypeId)
                        .Select(g => g.OrderByDescending(d => d.UploadDocumentId).First())
                        .ToDictionary(
                            d => d.UploadDocumentTypeId.ToString(),
                            d => new { id = d.UploadDocumentId, path = d.DocumentFilePath ?? "" }));

                var (docSessionOk, _, docSessionCtx, _, _, _) =
                    await aseeMIS.Utils.AppAuthorizeHelper.ValidateChildReadPermissionAsync(
                        Context, menuService, userContextService, 102, formSessionId);
                var imageFormSessionId = docSessionOk ? docSessionCtx?.FormSessionId ?? string.Empty : string.Empty;
                ViewData["BankPartyImageFormSessionId"] = imageFormSessionId;
                ViewData["BankPartyPhotoDocuments"] = photoDocsJson;
                ViewData["BankPartyPhotoDocType"] = photoDocType;

                var (additionalSessionOk, _, additionalSessionCtx, _, _, _) =
                    await aseeMIS.Utils.AppAuthorizeHelper.ValidateChildReadPermissionAsync(
                        Context, menuService, userContextService, 102, formSessionId);
                var additionalFormSessionId = additionalSessionOk ? additionalSessionCtx?.FormSessionId ?? string.Empty : string.Empty;

                var (signicatSessionOk, _, signicatSessionCtx, _, _, _) =
                    await aseeMIS.Utils.AppAuthorizeHelper.ValidateChildReadPermissionAsync(
                        Context, menuService, userContextService, 101, formSessionId);
                dsBankParty.Core.ViewModels.BankPartySignicatWebhookLogViewModel? signicatLog = null;
                if (signicatSessionOk)
                {
                    var signicatLogs = await signicatWebhookLogService.SelectForm101Async(
                        "BankPartyId",
                        Model!.BankPartyId.ToString());
                    signicatLog = signicatLogs
                        .Where(x => SignicatWebhookPayloadParser.IsVideoConsolidated(x.EventType))
                        .OrderByDescending(x => x.ReceivedAt ?? DateTime.MinValue)
                        .ThenByDescending(x => x.Id)
                        .FirstOrDefault();
                }

                if (signicatLog is not null && signicatSessionCtx is not null)
                {
                    var signicatRequest = new EntityDetailRequest
                    {
                        ViewPath = "~/Areas/BankParty/Views/_BankPartySignicatWebhookLogForm101Check.cshtml",
                        Model = signicatLog,
                        FormSessionId = signicatSessionCtx.FormSessionId,
                        FormId = 101,
                        EntityPrimaryKeyValue = signicatLog.Id.ToString(),
                        Area = "BankParty",
                        Source = EnumEntityDetailHost.Entity360,
                        IsAdd = false
                    };
                    var signicatViewData = new ViewDataDictionary(ViewData)
                    {
                        ["EntityDetailRequest"] = signicatRequest,
                        ["SignicatCrossCheckParty"] = Model
                    };

                    <div class="col-12">
                        <div class="ds-card">
                            <div class="ds-card-h d-flex align-items-center gap-2">
                                <i class="bi bi-camera-video"></i>
                                <span class="ds-card-title">Signicat Webhook Log</span>
                                <button type="button"
                                        class="btn btn-sm btn-link ms-auto text-decoration-none p-0"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#bankPartySignicatWebhookBody"
                                        aria-expanded="true"
                                        aria-controls="bankPartySignicatWebhookBody">
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                            </div>
                            <div id="bankPartySignicatWebhookBody" class="collapse show">
                                <div class="ds-card-b">
                                    @await Html.PartialAsync(
                                        "~/Areas/BankParty/Views/_BankPartySignicatWebhookLogForm101Check.cshtml",
                                        signicatLog,
                                        signicatViewData)
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="col-12">
                    <div class="ds-card">
                        <div class="ds-card-h d-flex align-items-center gap-2">
                            <i class="bi bi-card-image"></i>
                            <span class="ds-card-title">Documents &amp; Photos</span>
                            <button type="button"
                                    class="btn btn-sm btn-link ms-auto text-decoration-none p-0"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#bankPartyDocumentsPhotosBody"
                                    aria-expanded="true"
                                    aria-controls="bankPartyDocumentsPhotosBody">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>
                        <div id="bankPartyDocumentsPhotosBody" class="collapse show">
                            <div class="ds-card-b">
                                @await Html.PartialAsync("~/Areas/BankParty/Views/_BankPartyImage.cshtml", bpImageVm)
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    @await Component.InvokeAsync("AdditionalFormSyncfusionWidget", new
                    {
                        formId = 114,
                        targetId = Model!.BankPartyId.ToString(),
                        parentFormSessionId = formSessionId,
                        childFormSessionId = additionalFormSessionId,
                        foreignKeyPropertyName = "BankPartyId"
                    })
                </div>
            }
        </div>


<script>

    function toDateOnly(value) {
        if (!value) return null;
        if (typeof value === "string") {
            const iso = value.match(/^(\d{4})-(\d{2})-(\d{2})(?:$|T)/);
            if (iso) return `${iso[1]}-${iso[2]}-${iso[3]}`;
            const display = value.match(/^(\d{2})-(\d{2})-(\d{4})$/);
            if (display) return `${display[3]}-${display[2]}-${display[1]}`;
        }
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return null;

        return d.getFullYear() + "-" +
            String(d.getMonth() + 1).padStart(2, '0') + "-" +
            String(d.getDate()).padStart(2, '0');
    }

    function getTodayDateOnly() {
        const today = new Date();
        return new Date(today.getFullYear(), today.getMonth(), today.getDate());
    }

    function getNextRevisionDateOnly() {
        const today = new Date();
        return new Date(today.getFullYear() + 5, today.getMonth(), today.getDate());
    }

    function sanitizePhoneDigits(value) {
        return String(value ?? "").replace(/\D+/g, "");
    }

    var isAddMode = @(isAdd.ToString().ToLowerInvariant());
    var bankPartyId = @(Model?.BankPartyId ?? 0);

    function initBankPartyIndividualUpsert() {
        const dsInput = window.ds?.input;
        const formRoot = document.getElementById("@formDomId");
        if (!formRoot || formRoot.dataset.bankPartyIndividualInitialized === "true") return;
        formRoot.dataset.bankPartyIndividualInitialized = "true";

        const getEj2Instance = function(id) {
            return document.getElementById(id)?.ej2_instances?.[0] ?? null;
        };

        const getInputElement = function(id) {
            const root = document.getElementById(id);
            if (!root) return null;

            if (root.matches("input, select, textarea")) return root;

            return root.querySelector("input, select, textarea");
        };

        const getControlValue = function(id) {
            const control = getEj2Instance(id);
            const input = getInputElement(id);
            return control?.value ?? input?.value ?? null;
        };

        const setTextboxValue = function(id, value) {
            const control = getEj2Instance(id);
            const input = getInputElement(id);

            if (control) {
                control.value = value;
                control.dataBind?.();
            }

            if (input) {
                input.value = value ?? "";
            }
        };

        const parseDateValue = function(value) {
            if (!value) return null;

            if (value instanceof Date && !Number.isNaN(value.getTime())) {
                return new Date(value.getFullYear(), value.getMonth(), value.getDate());
            }

            const text = String(value).trim();
            if (!text) return null;

            const isoMatch = text.match(/^(\d{4})-(\d{2})-(\d{2})$/);
            if (isoMatch) {
                const [, year, month, day] = isoMatch;
                return new Date(Number(year), Number(month) - 1, Number(day));
            }

            const displayMatch = text.match(/^(\d{2})-(\d{2})-(\d{4})$/);
            if (displayMatch) {
                const [, day, month, year] = displayMatch;
                return new Date(Number(year), Number(month) - 1, Number(day));
            }

            const parsed = new Date(text);
            if (Number.isNaN(parsed.getTime())) return null;

            return new Date(parsed.getFullYear(), parsed.getMonth(), parsed.getDate());
        };

        const setDatePickerValue = function(id, value) {
            const control = getEj2Instance(id);
            if (control) {
                control.value = value;
                control.dataBind?.();
                return;
            }

            const input = getInputElement(id);
            if (input) {
                input.value = value ? toDateOnly(value) : "";
            }
        };

        const setRevisionDatesDefault = function() {
            setDatePickerValue("RevisionDateLast", getTodayDateOnly());
            setDatePickerValue("RevisionDateNext", getNextRevisionDateOnly());
        };

        const disableRevisionDates = function() {
            const lastRevisionControl = getEj2Instance("RevisionDateLast");
            const nextRevisionControl = getEj2Instance("RevisionDateNext");

            if (lastRevisionControl) {
                lastRevisionControl.enabled = false;
                lastRevisionControl.dataBind?.();
            }

            if (nextRevisionControl) {
                nextRevisionControl.enabled = false;
                nextRevisionControl.dataBind?.();
            }
        };

        const syncPhonePrefixBadge = function() {
            const isResident = document.getElementById("IsResident")?.checked ?? false;
            ["PhonePrefixBadge", "ViberPrefixBadge", "WhatsAppPrefixBadge"].forEach(function(badgeId) {
                document.getElementById(badgeId)?.classList.toggle("is-resident", isResident);
            });
        };

        const setDropdownValue = function(id, value, onlyIfEmpty) {
            const currentValue = getControlValue(id);
            if (onlyIfEmpty && currentValue) return;

            const control = getEj2Instance(id);

            if (control) {
                control.value = value;
                control.dataBind?.();
                return;
            }

            const input = getInputElement(id);
            if (input) {
                input.value = value ?? "";
            }
        };

        const getDropdownData = function(id) {
            const control = getEj2Instance(id);
            const sources = [control?.dataSource, control?.listData];

            for (const data of sources) {
                if (Array.isArray(data)) return data;
                if (Array.isArray(data?.result)) return data.result;
            }

            return [];
        };

        const getCountryValue = function(row) {
            return row?.CountryCode ?? row?.countryCode ?? row?.Value ?? row?.value ?? null;
        };

        const findContactCountryRow = function() {
            const selectedCountry = getControlValue("ContactCountryCode");
            const rows = getDropdownData("ContactCountryCode");
            const helperMatch = dsInput?.findCountryRowBySelectedValue?.(selectedCountry, rows);
            if (helperMatch) return helperMatch;

            const countryCode = String(selectedCountry ?? "").toLowerCase();
            if (!countryCode) return null;

            return rows.find(function(row) {
                return String(getCountryValue(row) ?? "").toLowerCase() === countryCode;
            }) ?? null;
        };

        const getContactCountryPrefix = function() {
            const selectedCountry = getControlValue("ContactCountryCode");
            const rows = getDropdownData("ContactCountryCode");
            const prefix = dsInput?.getCountryPhonePrefixBySelectedValue?.(selectedCountry, rows)
                || dsInput?.getCountryPhonePrefix?.(findContactCountryRow());
            return prefix || dsInput?.getCountryPhonePrefix?.(findResidentCountryRow()) || "+";
        };

        const phonePrefixManager = dsInput?.createPhonePrefixManager?.({
            fields: {
                PhoneNumberLocal: {
                    badgeId: "PhonePrefixBadge",
                    inputId: "PhonePrefixInput"
                },
                ContactViber: {
                    badgeId: "ViberPrefixBadge",
                    inputId: "ViberPrefixInput"
                },
                ContactWhatsApp: {
                    badgeId: "WhatsAppPrefixBadge",
                    inputId: "WhatsAppPrefixInput"
                }
            },
            getCountryPrefix: getContactCountryPrefix,
            getCountryRows: function() {
                return getDropdownData("ContactCountryCode");
            },
            getKnownPrefixes: function() {
                return getDropdownData("ContactCountryCode").map(row => dsInput?.getCountryPhonePrefix?.(row)).filter(Boolean);
            },
            getValue: getControlValue,
            setValue: setTextboxValue
        });

        const getPhonePrefix = function(fieldId) {
            return phonePrefixManager?.getPrefixValue?.(fieldId) || getContactCountryPrefix();
        };

        const isResidentPhonePrefix = function() {
            return dsInput?.normalizePhonePrefix?.(getPhonePrefix("PhoneNumberLocal")) === dsInput?.getCountryPhonePrefix?.(findResidentCountryRow());
        };

        const getPhoneMaxLength = function(fieldId, fallback) {
            return phonePrefixManager?.getMaxLength?.(fieldId) ?? fallback;
        };

        const setDropdownEnabled = function(id, enabled) {
            const control = getEj2Instance(id);
            if (control) {
                control.enabled = enabled;
                control.dataBind?.();
                return;
            }

            const input = getInputElement(id);
            if (input) {
                input.disabled = !enabled;
            }
        };

        const sanitizePhoneNumber = function(value) {
            return sanitizePhoneDigits(value);
        };

        const findResidentCountryRow = function() {
            const nationalityCountries = getDropdownData("NationalityCountryCode");
            const rows = nationalityCountries.length ? nationalityCountries : getDropdownData("ContactCountryCode");

            return rows.find(row => dsInput?.isResidentCountryRow?.(row)) ?? rows[0] ?? null;
        };

        const findResidentCountryValue = function() {
            return getCountryValue(findResidentCountryRow());
        };

        const calculateDocumentMaturityDate = function(issueDateValue) {
            const issueDate = parseDateValue(issueDateValue);
            if (!issueDate) return null;

            const maturityDate = new Date(issueDate.getFullYear(), issueDate.getMonth(), issueDate.getDate());
            maturityDate.setFullYear(maturityDate.getFullYear() + 10);
            maturityDate.setDate(maturityDate.getDate() - 1);

            return maturityDate;
        };

        const syncDocumentMaturityDate = function(options) {
            const config = options ?? {};
            const onlyIfEmpty = config.onlyIfEmpty === true;
            const currentMaturityValue = getControlValue("DocumentMaturityDate");

            if (onlyIfEmpty && currentMaturityValue) return;

            const maturityDate = calculateDocumentMaturityDate(getControlValue("DocumentIssueDate"));
            setDatePickerValue("DocumentMaturityDate", maturityDate);
        };

        const syncContactMunicipalityName = function() {
            const municipalityControl = getEj2Instance("ContactMunicipalityId");
            const municipalityText = municipalityControl?.text ?? "";
            setTextboxValue("ContactMunicipalityName", municipalityText);
        };

        const bindDocumentDateRules = function() {
            const issueDateRoot = document.getElementById("DocumentIssueDate");
            const issueDateControl = getEj2Instance("DocumentIssueDate");
            const issueDateInput = getInputElement("DocumentIssueDate");

            if (!issueDateRoot || issueDateRoot.dataset.documentDateBound === "true") return;

            issueDateRoot.dataset.documentDateBound = "true";

            const handleIssueDateChange = function() {
                syncDocumentMaturityDate();
            };

            if (issueDateControl?.addEventListener) {
                issueDateControl.addEventListener("change", handleIssueDateChange);
            } else if (issueDateInput) {
                issueDateInput.addEventListener("change", handleIssueDateChange);
            }
        };

        function toggleBirthMunicipalityFields() {
            const country = getEj2Instance("BirthCountryCode")?.value;
            const residentCountry = findResidentCountryValue();
            const isResidentCountry = residentCountry && String(country ?? "").toUpperCase() === String(residentCountry ?? "").toUpperCase();

            const idWrapper = document.getElementById("BirthMunicipalityIdWrapper");
            const nameWrapper = document.getElementById("BirthMunicipalityNameWrapper");
            const nameInput = document.getElementById("BirthMunicipalityName");

            nameWrapper?.classList.remove("ds-hidden");
            nameInput?.setAttribute("required", "required");

            if (isResidentCountry) {
                idWrapper?.classList.remove("ds-hidden");
                idWrapper?.classList.add("ds-required-empty");
            } else {
                idWrapper?.classList.add("ds-hidden");
                idWrapper?.classList.remove("ds-required-empty");
                setDropdownValue("BirthMunicipalityId", null, false);
            }
        }

        function toggleContactMunicipalityFields() {
            const idWrapper = document.getElementById("ContactMunicipalityIdWrapper");
            const nameWrapper = document.getElementById("ContactMunicipalityNameWrapper");
            const nameInput = document.getElementById("ContactMunicipalityName");
            idWrapper?.classList.remove("ds-hidden");
            nameWrapper?.classList.add("ds-hidden");
            nameInput?.removeAttribute("required");
            nameInput?.removeAttribute("data-val-required");
            syncContactMunicipalityName();
        }

        const normalizeIdentificationNumber = function() {
            const isResident = document.getElementById("IsResident")?.checked ?? false;
            const maxLength = isResident ? 10 : 50;

            const input = getInputElement("IdentificationNumber");
            const control = getEj2Instance("IdentificationNumber");

            const currentValue = String(input?.value ?? control?.value ?? "");
            const cleaned = isResident
                ? currentValue.replace(/\D+/g, "").slice(0, maxLength)
                : currentValue.slice(0, maxLength);

            if (input) {
                input.maxLength = maxLength;
                input.setAttribute("maxlength", String(maxLength));

                if (isResident) {
                    input.inputMode = "numeric";
                    input.setAttribute("pattern", "[0-9]*");
                } else {
                    input.inputMode = "text";
                    input.removeAttribute("pattern");
                }
            }

            if (currentValue !== cleaned) {
                setTextboxValue("IdentificationNumber", cleaned);
            }

            const normalizedValue = currentValue !== cleaned ? cleaned : currentValue;
            const isInvalidResidentId = isResident && normalizedValue.length > 0 && !/^\d{10}$/.test(normalizedValue);
            input?.classList.toggle("is-invalid", isInvalidResidentId);
        };

        const bindIdentificationNumberRules = function() {
            const input = getInputElement("IdentificationNumber");
            if (!input || input.dataset.identificationNumberBound === "true") return;

            input.dataset.identificationNumberBound = "true";
            input.addEventListener("input", normalizeIdentificationNumber);
        };

        const normalizePhoneNumberInput = function() {
            const phoneInput = getInputElement("PhoneNumberLocal");
            if (!phoneInput) return;

            const isResident = document.getElementById("IsResident")?.checked ?? false;
            const useResidentPhoneRules = isResident && isResidentPhonePrefix();
            // SINGLE SOURCE OF TRUTH = DefCountry.PhoneNumberMaxLenght (per-country, from DB).
            // Store the value EXACTLY as the user is expected to type it (without the trunk
            // leading "0", since the +prefix badge is already rendered next to the input).
            // Fallback to 8 only when the country row does not define a length.
            const residentPhoneLength = getPhoneMaxLength("PhoneNumberLocal", 8);

            phoneInput.inputMode = "tel";

            if (useResidentPhoneRules) {
                phoneInput.maxLength = residentPhoneLength;
                phoneInput.setAttribute("maxlength", String(residentPhoneLength));

                const visiblePhoneValue = String(phoneInput.value ?? "");
                const normalizedValue = dsInput?.normalizeLocalPhone?.(visiblePhoneValue, getPhonePrefix("PhoneNumberLocal"), residentPhoneLength) ?? sanitizePhoneNumber(visiblePhoneValue).slice(0, residentPhoneLength);

                if (visiblePhoneValue !== normalizedValue) {
                    setTextboxValue("PhoneNumberLocal", normalizedValue);
                }

                setTextboxValue("PhoneNumber", dsInput?.composePhoneNumber?.(normalizedValue, getPhonePrefix("PhoneNumberLocal")) ?? normalizedValue);
                return;
            }

            const maxLength = getPhoneMaxLength("PhoneNumberLocal", 20);
            phoneInput.maxLength = maxLength;
            phoneInput.setAttribute("maxlength", String(maxLength));

            const visiblePhoneValue = String(phoneInput.value ?? "");
            const normalizedValue = sanitizePhoneNumber(visiblePhoneValue).slice(0, maxLength);

            if (visiblePhoneValue !== normalizedValue) {
                setTextboxValue("PhoneNumberLocal", normalizedValue);
            }

            setTextboxValue("PhoneNumber", dsInput?.composePhoneNumber?.(normalizedValue, getPhonePrefix("PhoneNumberLocal")) ?? (normalizedValue ? `+${normalizedValue}` : ""));
        };

        const syncPhoneNumberWithResident = function(preferHiddenValue) {
            const phoneInput = getInputElement("PhoneNumberLocal");
            if (!phoneInput) return;

            const isResident = document.getElementById("IsResident")?.checked ?? false;
            const useResidentPhoneRules = isResident && isResidentPhonePrefix();
            // Same length source as normalizePhoneNumberInput — keeps the two flows in sync.
            const residentPhoneLength = getPhoneMaxLength("PhoneNumberLocal", 8);
            const hiddenPhoneValue = String(getControlValue("PhoneNumber") ?? "");
            const visiblePhoneValue = String(phoneInput.value ?? "");

            const sourceValue = preferHiddenValue && hiddenPhoneValue
                ? hiddenPhoneValue
                : (visiblePhoneValue || hiddenPhoneValue);

            phoneInput.inputMode = "tel";

            if (useResidentPhoneRules) {
                const normalizedValue = dsInput?.normalizeLocalPhone?.(sourceValue, getPhonePrefix("PhoneNumberLocal"), residentPhoneLength) ?? sanitizePhoneNumber(sourceValue).slice(0, residentPhoneLength);

                phoneInput.maxLength = residentPhoneLength;
                phoneInput.setAttribute("maxlength", String(residentPhoneLength));

                if (visiblePhoneValue !== normalizedValue) {
                    setTextboxValue("PhoneNumberLocal", normalizedValue);
                }

                setTextboxValue("PhoneNumber", dsInput?.composePhoneNumber?.(normalizedValue, getPhonePrefix("PhoneNumberLocal")) ?? normalizedValue);
                syncPhonePrefixBadge();
                return;
            }

            const maxLength = getPhoneMaxLength("PhoneNumberLocal", 20);
            const normalizedValue = (dsInput?.stripPhonePrefix?.(sourceValue, getPhonePrefix("PhoneNumberLocal")) ?? sanitizePhoneNumber(sourceValue)).slice(0, maxLength);

            phoneInput.maxLength = maxLength;
            phoneInput.setAttribute("maxlength", String(maxLength));

            if (visiblePhoneValue !== normalizedValue) {
                setTextboxValue("PhoneNumberLocal", normalizedValue);
            }

            setTextboxValue("PhoneNumber", dsInput?.composePhoneNumber?.(normalizedValue, getPhonePrefix("PhoneNumberLocal")) ?? (normalizedValue ? `+${normalizedValue}` : ""));
            syncPhonePrefixBadge();
        };

        const bindPhoneNumberRules = function() {
            const phoneInput = getInputElement("PhoneNumberLocal");
            if (!phoneInput || phoneInput.dataset.phoneNumberBound === "true") return;

            phoneInput.dataset.phoneNumberBound = "true";
            phoneInput.addEventListener("input", function() {
                normalizePhoneNumberInput();
            });
        };

        // Returns the DefCountry row matching the currently selected NationalityCountryCode.
        // Used by both the live input limiter and the submit-time validator so they always
        // agree on the country source.
        const getSelectedNationalityRow = function() {
            const ctl = document.getElementById("NationalityCountryCode")?.ej2_instances?.[0];
            const rows = Array.isArray(ctl?.dataSource)
                ? ctl.dataSource
                : (Array.isArray(ctl?.dataSource?.result) ? ctl.dataSource.result : (ctl?.listData ?? []));
            const selected = String(getControlValue("NationalityCountryCode") ?? "");
            if (!selected) return null;
            return rows.find(row => {
                const code = String(row?.CountryCode ?? row?.countryCode ?? row?.Value ?? row?.value ?? "");
                return code === selected;
            }) ?? null;
        };

        // Pushes DefCountry.PersonalNumberMaxLength → IdentificationNumber input's maxLength
        // so the user is physically blocked from typing more digits than the selected
        // nationality allows. Also truncates any pre-existing over-length value, mirrors
        // the attribute (HTML clamp), and falls back to the StringLength(50) declared on
        // BankParty.IdentificationNumber when the country has no value defined.
        const ID_NUMBER_FALLBACK_MAX = 50;
        // Cache the currently enforced limit so the defensive input-listener (which fires
        // on every keystroke) doesn't have to walk the dropdown's dataSource each time.
        let identificationNumberCurrentLimit = ID_NUMBER_FALLBACK_MAX;

        // Applies the country-derived maxLength to whatever <input> is currently rendered
        // inside the Syncfusion TextBox wrapper. We deliberately do NOT mutate
        // ej.htmlAttributes + dataBind() here — dataBind() forces Syncfusion to re-render
        // the underlying <input>, which orphans any input-event listener and is exactly
        // what caused "first 13 chars get truncated, then no further enforcement".
        const applyIdentificationNumberDomMaxLength = function(maxLength) {
            const idInput = getInputElement("IdentificationNumber");
            if (!idInput) return;
            idInput.maxLength = maxLength;
            idInput.setAttribute("maxlength", String(maxLength));
        };

        const syncIdentificationNumberLimits = function() {
            const row = getSelectedNationalityRow();
            const countryMax = dsInput?.getCountryPersonalNumberMaxLength?.(row);
            const maxLength = Number.isInteger(countryMax) && countryMax > 0 ? countryMax : ID_NUMBER_FALLBACK_MAX;
            identificationNumberCurrentLimit = maxLength;

            applyIdentificationNumberDomMaxLength(maxLength);

            // Trim any pre-existing over-length value (e.g. switching from Sweden(12)
            // → Kosovo(10) after the user already typed 12 chars). Set via native
            // input.value (NOT ej.value) so Syncfusion does not re-render the input.
            const idInput = getInputElement("IdentificationNumber");
            if (!idInput) return;
            const currentValue = String(idInput.value ?? "");
            if (currentValue.length > maxLength) {
                idInput.value = currentValue.slice(0, maxLength);
                // Dispatch a synthetic input event so Syncfusion's internal value
                // model stays in sync with the trimmed DOM value.
                idInput.dispatchEvent(new Event("input", { bubbles: true }));
            }
        };

        // Defensive guard via EVENT DELEGATION on the stable wrapper element. The
        // underlying <input> can be replaced by Syncfusion (re-renders, theme/value
        // updates, etc.); binding on the wrapper survives every such re-render
        // because input events bubble up. The previous direct-bind on the input
        // silently broke after the first Syncfusion re-render.
        const bindIdentificationNumberInputGuard = function() {
            const wrapper = document.getElementById("IdentificationNumber");
            if (!wrapper || wrapper.dataset.idLengthBound === "true") return;
            wrapper.dataset.idLengthBound = "true";
            wrapper.addEventListener("input", function(e) {
                const target = e.target;
                if (!target || target.tagName !== "INPUT") return;
                const value = String(target.value ?? "");
                if (value.length > identificationNumberCurrentLimit) {
                    // Re-apply DOM maxLength in case Syncfusion re-rendered the input
                    // and dropped our attribute — cheap, idempotent.
                    target.maxLength = identificationNumberCurrentLimit;
                    target.setAttribute("maxlength", String(identificationNumberCurrentLimit));
                    target.value = value.slice(0, identificationNumberCurrentLimit);
                }
            });
        };

        function handleResidentToggle(options) {
            const config = options ?? {};
            const preferHiddenPhoneValue = config.preferHiddenPhoneValue === true;
            const isResident = document.getElementById("IsResident")?.checked ?? false;
            const residentCountryValue = findResidentCountryValue();

            if (isResident) {
                setDropdownValue("NationalityCountryCode", residentCountryValue, false);
                setDropdownValue("ContactCountryCode", residentCountryValue, false);
            } else {
                const currentNationality = String(getControlValue("NationalityCountryCode") ?? "").toUpperCase();
                const normalizedResidentCountryValue = String(residentCountryValue ?? "").toUpperCase();

                if (currentNationality === normalizedResidentCountryValue) {
                    setDropdownValue("NationalityCountryCode", null, false);
                }
            }

            setDropdownEnabled("NationalityCountryCode", !isResident);
            setDropdownEnabled("ContactCountryCode", true);
            phonePrefixManager?.sync?.({ force: true, resetManual: true });
            syncPhoneNumberWithResident(preferHiddenPhoneValue);
            syncPhonePrefixBadge();
            normalizeIdentificationNumber();
            toggleContactMunicipalityFields();
        }

        const bindResidentToggle = function() {
            const residentToggle = document.getElementById("IsResident");
            if (!residentToggle || residentToggle.dataset.residentBehaviorBound === "true") return;

            residentToggle.dataset.residentBehaviorBound = "true";
            residentToggle.addEventListener("change", function() {
                handleResidentToggle();
            });
        };

        // ✅ WFE: load allowed status transitions dynamically via AJAX
        const loadWfeStatusDropdown = function(attempt, statusCode) {
            const dropdown = getEj2Instance("StatusCode");
            if (!dropdown) {
                if ((attempt ?? 0) < 20) {
                    window.setTimeout(function() {
                        loadWfeStatusDropdown((attempt ?? 0) + 1, statusCode);
                    }, 100);
                }
                return;
            }

            const currentStatusCode = statusCode
                ?? (isAddMode
                    ? null
                    : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.BankParty?.StatusCode)));

            const query = new URLSearchParams({
                isIndividual: "true"
            });

            if (!isAddMode && currentStatusCode) {
                query.set("currentStatusCode", currentStatusCode);
            }

            const url = `/Wfe/WorkflowCrmExtensions/GetStatuses?${query.toString()}`;

            fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
                .then(res => res.ok ? res.json() : Promise.reject(res.status))
                .then(function(data) {
                    const rows = Array.isArray(data)
                        ? data
                        : (Array.isArray(data?.result) ? data.result : (data ? [data] : []));

                    const statuses = rows
                        .map(function(row) {
                            return {
                                statusCode: row?.statusCode ?? row?.StatusCode,
                                statusName: row?.statusName ?? row?.StatusName,
                                stepCode: row?.stepCode ?? row?.StepCode,
                                action: row?.action ?? row?.Action,
                                isCurrent: row?.isCurrent ?? row?.IsCurrent,
                                SetEntityActive: row?.setEntityActive ?? row?.SetEntityActive
                            };
                        })
                        .filter(row => row.statusCode && row.statusName);

                    if (statuses.length === 0) return;

                    dropdown.dataSource = statuses;
                    dropdown.fields = { text: "statusName", value: "statusCode" };
                    dropdown.dataBind();

                    // In Add mode → pre-select first initial status
                    if (isAddMode && !dropdown.value) {
                        dropdown.value = statuses[0].statusCode;
                        dropdown.dataBind();
                    }
                })
                .catch(function(err) {
                    console.warn("[WFE] Failed to load status transitions:", err);
                });
        };

        window.refreshBankPartyWorkflowStatuses = function(currentStatusCode) {
            loadWfeStatusDropdown(0, currentStatusCode);
        };

        const bindFormBehaviors = function() {
            window.ds?.input?.init?.(document.getElementById("@formDomId") || document);
            phonePrefixManager?.initialize?.();
            bindIdentificationNumberRules();
            bindPhoneNumberRules();
            bindDocumentDateRules();
            bindResidentToggle();
            handleResidentToggle({ preferHiddenPhoneValue: true });
            syncDocumentMaturityDate({ onlyIfEmpty: true });

            if (isAddMode) {
                setRevisionDatesDefault();
            }

            disableRevisionDates();
            syncPhonePrefixBadge();

            const birthCountry = getEj2Instance("BirthCountryCode");
            const contactCountry = getEj2Instance("ContactCountryCode");
            const contactMunicipality = getEj2Instance("ContactMunicipalityId");

            birthCountry?.addEventListener("change", toggleBirthMunicipalityFields);
            const handleContactCountryChange = function() {
                phonePrefixManager?.sync?.({ force: true, resetManual: true });
                syncPhoneNumberWithResident();
                toggleContactMunicipalityFields();
            };

            if (dsInput?.bindControlChange) {
                dsInput.bindControlChange("ContactCountryCode", handleContactCountryChange, "bankPartyPhoneCountryBound");
            } else {
                contactCountry?.addEventListener("change", handleContactCountryChange);
            }
            contactMunicipality?.addEventListener("change", syncContactMunicipalityName);

            // IdentificationNumber maxLength is per-country (DefCountry.PersonalNumberMaxLength).
            // We MUST listen on the Syncfusion EJ2 instance (not the wrapper DOM element):
            // the underlying DropDownList raises its own "change" event on the component,
            // not on the rendered <select>, so dsInput.bindControlChange (which binds to
            // the DOM wrapper) silently misses the event for dropdowns. This mirrors how
            // birthCountry / contactMunicipality are wired above.
            const nationalityCountry = getEj2Instance("NationalityCountryCode");
            if (nationalityCountry && !nationalityCountry.__dsIdLengthBound) {
                nationalityCountry.__dsIdLengthBound = true;
                nationalityCountry.addEventListener("change", syncIdentificationNumberLimits);
            }
            bindIdentificationNumberInputGuard();
            syncIdentificationNumberLimits();

            toggleBirthMunicipalityFields();
            toggleContactMunicipalityFields();
            syncContactMunicipalityName();

            loadWfeStatusDropdown(0);
        };

        const waitForEjsControls = function(attempt) {
            if (getEj2Instance("StatusCode") || (attempt ?? 0) >= 20) {
                bindFormBehaviors();
                return;
            }

            window.setTimeout(function() {
                waitForEjsControls((attempt ?? 0) + 1);
            }, 100);
        };

        waitForEjsControls(0);

        // ✅ CRITICAL FIX (hidden validation bug)
        if ($ && $("form").validate) {
            $("form").validate().settings.ignore = ":hidden";
        }
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initBankPartyIndividualUpsert);
    } else {
        initBankPartyIndividualUpsert();
    }

    window.preSave = function() {
        window.dsEntityDebug = true;
        const dsInput = window.ds?.input;

        const getValue = function(id) {
            const el = document.getElementById(id);
            if (!el) return null;

            const ej2 = el.ej2_instances?.[0];
            if (ej2) return ej2.value;

            if (el.matches("input, select, textarea")) return el.value;

            const input = el.querySelector("input, select, textarea");
            return input ? input.value : null;
        };

        const getText = function(id) {
            const el = document.getElementById(id);
            const ej2 = el?.ej2_instances?.[0];
            return ej2?.text ?? null;
        };

        const getChecked = function(id) {
            const element = document.getElementById(id);
            if (!element) return false;
            if ("checked" in element) return element.checked;

            return String(element.value ?? "").toLowerCase() === "true";
        };

        const getDropdownData = function(id) {
            const control = document.getElementById(id)?.ej2_instances?.[0];
            if (Array.isArray(control?.dataSource)) return control.dataSource;
            if (Array.isArray(control?.dataSource?.result)) return control.dataSource.result;
            return control?.listData ?? [];
        };

        const findSelectedCountryRow = function(id) {
            const selected = String(getValue(id) ?? "");
            if (!selected) return null;

            return getDropdownData(id).find(function(row) {
                const code = String(
                    row?.CountryCode
                    ?? row?.countryCode
                    ?? row?.Value
                    ?? row?.value
                    ?? ""
                );
                return code === selected;
            }) ?? null;
        };

        const getSelectedNationalityRow = function() {
            return findSelectedCountryRow("NationalityCountryCode");
        };

        const getContactCountryPrefix = function() {
            const selectedCountry = getValue("ContactCountryCode");
            const rows = getDropdownData("ContactCountryCode");
            return dsInput?.getCountryPhonePrefixBySelectedValue?.(selectedCountry, rows)
                || dsInput?.getCountryPhonePrefix?.(findSelectedCountryRow("ContactCountryCode"))
                || "+";
        };

        const isResident = getChecked("IsResident");
        const phoneLocal = String(getValue("PhoneNumberLocal") ?? "").trim();
        const phonePrefix = dsInput?.normalizePhonePrefix?.(getValue("PhonePrefixInput")) || getContactCountryPrefix();
        const contactCountryControl = document.getElementById("ContactCountryCode")?.ej2_instances?.[0];
        const residentCountrySource = contactCountryControl?.dataSource;
        const residentCountryRows = Array.isArray(residentCountrySource)
            ? residentCountrySource
            : (Array.isArray(residentCountrySource?.result) ? residentCountrySource.result : (contactCountryControl?.listData ?? []));
        const residentCountryRow = residentCountryRows.find(row => dsInput?.isResidentCountryRow?.(row));
        const residentCountryValue = residentCountryRow?.CountryCode ?? residentCountryRow?.countryCode ?? residentCountryRow?.Value ?? residentCountryRow?.value ?? null;
        const residentPrefix = dsInput?.getCountryPhonePrefix?.(residentCountryRow);
        const hasResidentPrefix = phonePrefix === residentPrefix;
        const phoneLocalInput = document.getElementById("PhoneNumberLocal")?.querySelector("input") ?? document.getElementById("PhoneNumberLocal");
        const phoneMaxLength = Number(phoneLocalInput?.maxLength) > 0 ? Number(phoneLocalInput.maxLength) : 50;

        let phoneDigits = isResident && hasResidentPrefix
            ? (dsInput?.normalizeLocalPhone?.(phoneLocal, phonePrefix, phoneMaxLength) ?? sanitizePhoneDigits(phoneLocal).slice(0, phoneMaxLength))
            : sanitizePhoneDigits(phoneLocal).slice(0, phoneMaxLength);

        if (isResident && hasResidentPrefix && phoneDigits.length !== phoneMaxLength) {
            showMessage(`Phone Number must be exactly ${phoneMaxLength} digits for resident country. Do not write 0 before the number.`, "Error");
            return;
        }

        const fullPhone = dsInput?.composePhoneNumber?.(phoneDigits, phonePrefix) ?? (phoneDigits ? `${phonePrefix}${phoneDigits}` : "");

        const idNumber = String(getValue("IdentificationNumber") ?? "").trim();

        // Personal-number length is per-country (DefCountry.PersonalNumberMaxLength).
        // Same row resolver as syncIdentificationNumberLimits — single source of truth.
        const personalNumberMaxLength = dsInput?.getCountryPersonalNumberMaxLength?.(getSelectedNationalityRow());

        if (isResident && personalNumberMaxLength) {
            if (!new RegExp(`^\\d{${personalNumberMaxLength}}$`).test(idNumber)) {
                showMessage(`Identification Number must be exactly ${personalNumberMaxLength} digits for residents.`, "Error");
                return;
            }
        } else if (isResident && !/^\d{10}$/.test(idNumber)) {
            // Fallback when the country forgot to populate PersonalNumberMaxLength — never
            // let resident-ID validation be silently bypassed.
            showMessage("Identification Number must be exactly 10 digits for residents.", "Error");
            return;
        }

        ds.entity.prepareModel = function(model) {
            model.BankParty = model.BankParty || {};
            const copyToBankParty = function(fieldName, targetName) {
                const destinationName = targetName || fieldName;
                if (model.BankParty[destinationName] === undefined || model.BankParty[destinationName] === null || model.BankParty[destinationName] === "") {
                    model.BankParty[destinationName] = model[fieldName] ?? getValue(fieldName);
                }
            };

            [
                "PartyCode",
                "StatusCode",
                "PartyTypeId",
                "PartySegmentId",
                "IdentificationNumber",
                "NationalityCountryCode",
                "ContactCountryCode",
                "ContactMunicipalityId",
                "ContactAddress",
                "ContactEmail",
                "ContactViber",
                "ContactWhatsApp",
                "ActualBranchId",
                "LanguageCode",
                "ActualAdvisorEmployeeId",
                "ActualAccountOfficerEmployeeId",
                "PartyDescription"
            ].forEach(fieldName => copyToBankParty(fieldName));

            // Explicitly send the selected birth date as a calendar date, without UTC conversion.
            model.DateOfBirth = toDateOnly(getValue("DateOfBirth"));
            model.BirthCountryCode = getValue("BirthCountryCode");
            model.BirthMunicipalityName = getValue("BirthMunicipalityName");
            if (residentCountryValue && String(model.BirthCountryCode ?? "").toUpperCase() === String(residentCountryValue).toUpperCase()) {
                model.BirthMunicipalityId = getValue("BirthMunicipalityId");
            } else {
                model.BirthMunicipalityId = null;
            }

            model.IsPEP = getChecked("IsPEP");

            model.BankParty.BankPartyId = model.BankPartyId ?? getValue("BankPartyId");
            model.BankParty.SecondCitizenshipCode =
                model.SecondCitizenshipCode_Compliance ??
                model.BankParty.SecondCitizenshipCode ??
                getValue("SecondCitizenshipCode_Compliance");

            model.BankParty.PartyCode = model.BankParty.PartyCode || "TEMP-" + Date.now();
            model.BankParty.StatusCode = model.BankParty.StatusCode || "DRAFT";
            const statusDropdown = document.getElementById("StatusCode")?.ej2_instances?.[0] ?? null;
            const selectedStatus =
                statusDropdown?.itemData ??
                statusDropdown?.dataSource?.find?.(row =>
                    String(row?.statusCode ?? row?.StatusCode) === String(statusDropdown?.value));
            const SetEntityActive = selectedStatus?.SetEntityActive;
            model.BankParty.IsActive = SetEntityActive === null || SetEntityActive === undefined
                ? true
                : Boolean(SetEntityActive);
            model.BankParty.FullName = (
                (model.FirstName ?? "") + " " +
                (model.LastName ?? "")
            ).trim();

            model.BankParty.IdentificationNumber =
                model.BankParty.IdentificationNumber ??
                model.IdentificationNumber ??
                getValue("IdentificationNumber");

            model.BankParty.PhoneNumber = fullPhone;
            model.BankParty.ContactViber = dsInput?.composePhoneNumber?.(getValue("ContactViber"), getValue("ViberPrefixInput")) ?? model.BankParty.ContactViber;
            model.BankParty.ContactWhatsApp = dsInput?.composePhoneNumber?.(getValue("ContactWhatsApp"), getValue("WhatsAppPrefixInput")) ?? model.BankParty.ContactWhatsApp;
            model.BankParty.IsIndividual = true;
            model.BankParty.IsResident = getChecked("IsResident");
            model.BankParty.IsWalkIn = getChecked("IsWalkIn");
            model.BankParty.ContactMunicipalityName =
                getText("ContactMunicipalityId") ||
                model.BankParty.ContactMunicipalityName ||
                getValue("ContactMunicipalityName");
            model.BankParty.RevisionDateLast = toDateOnly(
                isAddMode
                    ? getTodayDateOnly()
                    : (model.BankParty.RevisionDateLast || getValue("RevisionDateLast") || getTodayDateOnly())
            );
            model.BankParty.RevisionDateNext = toDateOnly(
                isAddMode
                    ? getNextRevisionDateOnly()
                    : (model.BankParty.RevisionDateNext || getValue("RevisionDateNext") || getNextRevisionDateOnly())
            );
            model.BankParty.IsFATCA = getChecked("IsFATCA");

            console.log("[BankPartyIndividual.prepareModel]", {
                root: model,
                bankParty: model.BankParty,
                partyTypeId: model.BankParty.PartyTypeId,
                partySegmentId: model.BankParty.PartySegmentId,
                contactAddress: model.BankParty.ContactAddress,
                contactMunicipalityId: model.BankParty.ContactMunicipalityId
            });

            return model;
        };

        if (@Html.Raw(System.Text.Json.JsonSerializer.Serialize(isGridDialog))) {
            const dialogContainer =
                document.querySelector(".e-dialog .form-container[data-form-session-id]") ||
                document.querySelector(".form-container[data-form-session-id]");

            saveGridPartialDialogEditor(
                    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(gridName)),
                ds.entity.prepareModel(ds.entity.collectModel(dialogContainer))
            );
            return;
        }

        ds.entity.afterUpdate = function(result, savedModel) {
            const savedStatusCode =
                savedModel?.BankParty?.StatusCode
                ?? getValue("StatusCode");

            window.refreshBankPartyWorkflowStatuses?.(savedStatusCode);
        };

        ds.entity.save();
    };
</script>
