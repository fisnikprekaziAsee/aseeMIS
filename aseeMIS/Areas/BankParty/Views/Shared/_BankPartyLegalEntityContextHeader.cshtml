@model dsBankParty.Core.DTOs.BankPartyLegalEntityContextHeaderDto

<style>
    .lph-grid-wrap {
        padding-top: .85rem;
        padding-left: .75rem;
        padding-right: .5rem;
    }

    .lph-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr 1fr 1.2fr;
        gap: .5rem;
    }

    .lph-col {
        display: flex;
        flex-direction: column;
        gap: .55rem;
        min-width: 0;
    }

    .lph-title {
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #94a3b8;
        margin-bottom: .4rem;
        letter-spacing: .03em;
    }

    .lph-name {
        font-size: 1.06rem;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.3;
    }

    .lph-meta {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
        align-items: center;
    }

    .lph-code {
        font-size: .88rem;
        color: #94a3b8;
    }

    .lph-chip {
        font-size: .75rem;
        font-weight: 600;
        padding: .22rem .65rem;
        border-radius: 999px;
        border: 1px solid transparent;
        line-height: 1.1;
        display: inline-flex;
        align-items: center;
    }

    /* Residency status - keep green */
    .chip-success {
        background: #ecfdf5;
        border-color: #bbf7d0;
        color: #047857;
    }

    /* Main blue */
    .chip-info {
        background: #e6f7fd;
        border-color: #bdeafb;
        color: #00a1e0;
    }

    .chip-warning {
        background: #fff7e6;
        border-color: #ffe2ad;
        color: #b7791f;
    }

    .chip-danger {
        background: #fff1f2;
        border-color: #fecdd3;
        color: #be123c;
    }

    .lph-row {
        display: flex;
        align-items: flex-start;
        gap: .55rem;
        font-size: .9rem;
        color: #374151;
        line-height: 1.45;
    }

        .lph-row strong {
            color: #0f172a;
        }

        /* Different icon colors depending on meaning */
        .lph-row .bi-envelope {
            color: #00a1e0;
        }

        .lph-row .bi-telephone {
            color: #0ea5a4;
        }

        .lph-row .bi-geo-alt,
        .lph-row .bi-geo-alt-fill {
            color: #f59e0b;
        }

        .lph-row .bi-calendar {
            color: #6366f1;
        }

        .lph-row .bi-calendar-check {
            color: #10b981;
        }

        .lph-row i {
            font-size: .92rem;
            margin-top: .12rem;
            flex-shrink: 0;
            width: 16px;
            text-align: center;
        }

    .lph-avatar {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        object-fit: cover;
        border: 1.5px solid #cfeffc;
        flex-shrink: 0;
    }

    .lph-avatar-fallback {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e6f7fd;
        color: #00a1e0;
        font-weight: 700;
        font-size: 1.05rem;
        border: 1.5px solid #cfeffc;
        flex-shrink: 0;
    }

    .lph-profile {
        display: flex;
        gap: .75rem;
        align-items: center;
    }

    @@media (max-width: 992px) {
        .lph-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 768px) {
        .lph-grid-wrap {
            padding-left: .4rem;
            padding-right: .4rem;
        }

        .lph-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
    }
</style>

<div class="lph-grid-wrap">
    <div class="lph-grid">

        <!-- BUSINESS -->
        <div class="lph-col">
            <div class="lph-title">Business</div>

            <div class="lph-name">@Model?.FullName</div>

            <div class="lph-meta">
                <span class="lph-code">@Model?.PartyCode</span>

                <span class="lph-chip chip-success">@Model?.ResidencyStatus</span>

                <span class="lph-chip chip-info">
                    <i class="bi bi-geo-alt-fill me-1" style="font-size:.65rem;"></i>
                    @Model?.ContactMunicipalityName
                </span>
            </div>

            <div class="lph-row">
                <span><strong>ID Number:</strong> @Model?.IdentificationNumber</span>
            </div>

            <div class="lph-row">
                <span><strong>Tax Number:</strong> @Model?.TaxNumber</span>
            </div>
        </div>

        <!-- CONTACT -->
        <div class="lph-col">
            <div class="lph-title">Contact</div>

            <div class="lph-row"><i class="bi bi-envelope"></i><span>@Model?.ContactEmail</span></div>
            <div class="lph-row"><i class="bi bi-telephone"></i><span>@Model?.PhoneNumber</span></div>
            <div class="lph-row"><i class="bi bi-geo-alt"></i><span>@Model?.ContactAddress</span></div>
        </div>

        <!-- DATES -->
        <div class="lph-col">
            <div class="lph-title">Dates</div>

            <div class="lph-row">
                <i class="bi bi-calendar"></i>
                <span>Founded: @Model?.FoundationDate?.ToString("yyyy-MM-dd")</span>
            </div>

            <div class="lph-row">
                <i class="bi bi-calendar-check"></i>
                <span>Next: @Model?.RevisionDateNext?.ToString("yyyy-MM-dd")</span>
            </div>
        </div>

        <!-- LEGAL REPRESENTATIVE -->
        <!-- LEGAL REPRESENTATIVE -->
        <div class="lph-col">
            <div class="lph-title">Legal Representative</div>

            <div class="lph-profile" style="align-items:flex-start;">

                @if (!string.IsNullOrWhiteSpace(Model?.ProfileImagePath))
                {
                    <img src="@Url.Action("Preview", "CRUD", new { area = "Common", path = Model.ProfileImagePath })"
                         class="lph-avatar" />
                }
                else
                {
                    <div class="lph-avatar-fallback">?</div>
                }

                <div style="display:flex; flex-direction:column; gap:.45rem; min-width:0;">

                    <div class="lph-meta" style="gap:.35rem;">
                        <span class="lph-chip chip-info">@Model?.LegalRepresentativePosition</span>

                        @if (Model?.RepresentativeIsPEP == true)
                        {
                            <span class="lph-chip chip-warning">PEP</span>
                        }

                        @if (Model?.RepresentativeIsFATCA == true)
                        {
                            <span class="lph-chip chip-danger">FATCA</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model?.RepresentativeEmail))
                    {
                        <div class="lph-row" style="margin-top:.15rem;">
                            <i class="bi bi-envelope"></i>
                            <span>@Model?.RepresentativeEmail</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model?.RepresentativePhone))
                    {
                        <div class="lph-row">
                            <i class="bi bi-telephone"></i>
                            <span>@Model?.RepresentativePhone</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

